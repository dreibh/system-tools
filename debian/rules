#!/usr/bin/make -f

# export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_INSTALL_SYSCONFDIR=/etc

# Exclude tests requiring external DNS/Internet connectivity (Debian Policy §4.9):
override_dh_auto_test:
	DEB_BUILD_OPTIONS="$(DEB_BUILD_OPTIONS) terse" dh_auto_test -- ARGS+="-LE network"

# Use upstream ChangeLog for installation
override_dh_installchangelogs:
	dh_installchangelogs -k ChangeLog
