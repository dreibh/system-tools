#: src/System-Info/System-Info.cc:635
msgid "Unknown"
msgstr "Nepoznato"

#. TRANSLATORS: Operating system details:
#. {0} = OS distribution, version, and codename
#. {1} = kernel release
#: src/System-Info/System-Info.cc:653
msgid "Operating System:"
msgstr "Operativni sistem:"

#: src/System-Info/System-Info.cc:654
#, no-c-format
msgid "{0} with kernel {1}"
msgstr "{0} sa kernelom {1}"

#. TRANSLATORS: Number of active processes running on the system.
#: src/System-Info/System-Info.cc:663
#, c-format
msgid "%s processes"
msgstr "%s procesa"

#: src/System-Info/System-Info.cc:668
#, c-format
msgid "%s user"
msgid_plural "%s users"
msgstr[0] "%s korisnik"
msgstr[1] "%s korisnika"
msgstr[2] "%s korisnika"

#. TRANSLATORS: Processor details:
#. {0} = core count
#. {1} = CPU machine architecture (e.g. x86_64, aarch64)
#. {2} = formatted processes count string
#. {3} = formatted users count string
#: src/System-Info/System-Info.cc:677
msgid "Processor:"
msgstr "Procesor:"

#: src/System-Info/System-Info.cc:678
#, no-c-format
msgid "{0} cores ({1}); {2}; {3}"
msgstr "{0} jezgri ({1}); {2}; {3}"

#: src/System-Info/System-Info.cc:691
#, c-format
msgid "%1.1f %% / %1.1f %% / %1.1f %%"
msgstr "%1.1f %% / %1.1f %% / %1.1f %%"

#. TRANSLATORS: Table row label for system load averages.
#: src/System-Info/System-Info.cc:696
msgid "Load (1/5/15 min):"
msgstr "Opterećenje (1/5/15 min):"

#. TRANSLATORS: Default battery state when the status cannot be determined.
#: src/System-Info/System-Info.cc:714
msgid "unknown"
msgstr "nepoznato"

#. TRANSLATORS: Battery status: plugged in but not currently charging.
#: src/System-Info/System-Info.cc:720
msgid "not charging"
msgstr "ne puni se"

#. TRANSLATORS: Battery status: currently charging.
#: src/System-Info/System-Info.cc:725
msgid "charging"
msgstr "puni se"

#. TRANSLATORS: Battery status: battery is fully charged.
#: src/System-Info/System-Info.cc:730
msgid "full"
msgstr "potpuno napunjena"

#. TRANSLATORS: Battery status: running on battery power (discharging).
#: src/System-Info/System-Info.cc:735
msgid "discharging"
msgstr "prazni se"

#. TRANSLATORS: Battery status entry:
#. {0} = battery number (#1)
#. {1} = charging status (e.g. charging, discharging)
#. {2} = capacity percentage
#: src/System-Info/System-Info.cc:748
#, no-c-format
msgid "#{0} {1}, {2} %"
msgstr "#{0} {1}, {2} %"

#. TRANSLATORS: Table row label for battery section.
#: src/System-Info/System-Info.cc:752
msgid "Battery:"
msgstr "Baterija:"

#. TRANSLATORS: Memory usage:
#. 1st %s = used MiB
#. 2nd %s = total MiB
#. 3rd %s = free/available MiB
#. 4th %s = free percentage
#: src/System-Info/System-Info.cc:761
#, c-format
msgid "%s MiB of %s MiB (%s MiB available: %s %%)"
msgstr "%s MiB od %s MiB (%s MiB dostupno: %s %%)"

#. TRANSLATORS: Table row label for physical RAM utilization.
#: src/System-Info/System-Info.cc:768
msgid "Used Memory:"
msgstr "Iskorištena memorija:"

#. TRANSLATORS: Table row label for swap space utilization.
#. TRANSLATORS: Table row label for swap, and message when no swap space
#. is configured.
#: src/System-Info/System-Info.cc:777 src/System-Info/System-Info.cc:782
msgid "Used Swap:"
msgstr "Iskorišteni swap:"

#: src/System-Info/System-Info.cc:783
msgid "no swap available!"
msgstr "Swap nije dostupan!"

#: src/System-Info/System-Info.cc:815
#, c-format
msgid "%1.0f %% on %s"
msgstr "%1.0f %% na %s"

#. TRANSLATORS: Table row label for storage diskspace utilization.
#: src/System-Info/System-Info.cc:825
msgid "Used Diskspace:"
msgstr "Iskorišteni prostor na disku:"

#. TRANSLATORS: Table row label for network interfaces section.
#: src/System-Info/System-Info.cc:833
msgid "Network:"
msgstr "Mreža:"

#. TRANSLATORS: Displayed when a network interface has no IPv4
#. address configured.
#: src/System-Info/System-Info.cc:881
msgid "(No IPv4)"
msgstr "(Nema IPv4)"

#. TRANSLATORS: Command-line syntax message prefix:
#. "Usage: <program> [options]".
#: src/System-Info/System-Info.cc:947
msgid "Usage:"
msgstr "Upotreba:"

