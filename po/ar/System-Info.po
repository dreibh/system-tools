msgstr "متوسط الحمل (1/5/15 دقيقة):"

#. TRANSLATORS: Default battery state when the status cannot be determined.
#: src/System-Info/System-Info.cc:714
msgid "unknown"
msgstr "غير معروف"

#. TRANSLATORS: Battery status: plugged in but not currently charging.
#: src/System-Info/System-Info.cc:720
msgid "not charging"
msgstr "لا يشحن"

#. TRANSLATORS: Battery status: currently charging.
#: src/System-Info/System-Info.cc:725
msgid "charging"
msgstr "يشحن"

#. TRANSLATORS: Battery status: battery is fully charged.
#: src/System-Info/System-Info.cc:730
msgid "full"
msgstr "ممتلئ"

#. TRANSLATORS: Battery status: running on battery power (discharging).
#: src/System-Info/System-Info.cc:735
msgid "discharging"
msgstr "يفرغ الشحن"

#. TRANSLATORS: Battery status entry:
#. {0} = battery number (#1)
#. {1} = charging status (e.g. charging, discharging)
#. {2} = capacity percentage
#: src/System-Info/System-Info.cc:748
#, no-c-format
msgid "#{0} {1}, {2} %"
msgstr "#{0} {1}، {2} %"

#. TRANSLATORS: Table row label for battery section.
#: src/System-Info/System-Info.cc:752
msgid "Battery:"
msgstr "البطارية:"

#. TRANSLATORS: Memory usage:
#. 1st %s = used MiB
#. 2nd %s = total MiB
#. 3rd %s = free/available MiB
#. 4th %s = free percentage
#: src/System-Info/System-Info.cc:761
#, c-format
