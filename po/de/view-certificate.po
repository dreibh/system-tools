#, no-c-format
msgid "ERROR: Unable to find certificate file {0}!"
msgstr "FEHLER: Zertifikatsdatei {0} wurde nicht gefunden!"

#, no-c-format
msgid "ERROR: Unable to read certificate file {0}!"
msgstr "FEHLER: Zertifikatsdatei {0} konnte nicht gelesen werden!"

#, no-c-format
msgid "ERROR: Unable to parse X.509 certificate in {0}!"
msgstr "FEHLER: X.509-Zertifikat in {0} konnte nicht geparst werden!"

#, no-c-format
msgid "Certificate in {0}:"
msgstr "Zertifikat in {0}:"

msgid "Subject:"
msgstr "Inhaber:"

