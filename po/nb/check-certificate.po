msgid "LTR"
msgstr "LTR"

msgid "Usage:"
msgstr "Bruk:"

msgid "For further information, see the man page for %s, read the documentation at %s, examine the source code at %s, or consult your favourite LLM."
msgstr "For mer informasjon, se manualsiden (man-siden) for %s, les dokumentasjonen på %s, undersøk kildekoden på %s, eller spør din foretrukne LLM."

msgid "ERROR: Bash 4.4 or higher is required!"
msgstr "FEIL: Bash 4.4 eller høyere er nødvendig!"

msgid "ERROR: Enhanced/GNU getopt is required!"
msgstr "FEIL: Enhanced/GNU getopt er nødvendig!"

msgid "ERROR: OpenSSL is not installed!"
msgstr "FEIL: OpenSSL er ikke installert!"

msgid "ERROR: view-certificate is not installed!"
msgstr "FEIL: view-certificate er ikke installert!"

msgid "ERROR: extract-pem is not installed!"
msgstr "FEIL: extract-pem er ikke installert!"

#, sh-format
msgid "ERROR: Unable to find CA certificate file ${CA_FILE}!"
msgstr "FEIL: Finner ikke CA-sertifikatfilen ${CA_FILE}!"

#, sh-format
msgid "ERROR: Unable to find CRL file ${CRL}!"
msgstr "FEIL: Finner ikke CRL-filen ${CRL}!"

msgid "ERROR: Standard input (-) can only be read once!"
msgstr "FEIL: Standard inndata (-) kan kun leses én gang!"

#, sh-format
msgid "ERROR: Unable to find certificate file ${CERTIFICATE_FILE}!"
msgstr "FEIL: Finner ikke sertifikatfilen ${CERTIFICATE_FILE}!"

#, sh-format
msgid "Verifying ${CERTIFICATE_FILE} with CA ${CA_FILE} ..."
msgstr "Verifiserer ${CERTIFICATE_FILE} mot CA ${CA_FILE} ..."

msgid "WARNING: Only checking self-signature!"
msgstr "ADVARSEL: Kontrollerer kun selvsignatur!"

msgid "✓OKAY"
msgstr "✓OKAY"

msgid "❌FAILED!"
msgstr "❌MISLYKTES!"

msgid "(OpenSSL is not installed)"
msgstr "(OpenSSL er ikke installert)"

msgid "(GnuTLS CertTool is not installed)"
msgstr "(GnuTLS CertTool er ikke installert)"

msgid "(NSS CertUtil is not installed)"
msgstr "(NSS CertUtil er ikke installert)"

msgid "CERTIFICATE VERIFICATIONS FAILED!"
msgstr "SERTIFIKATVERIFISERING MISLYKTES!"
