#. TRANSLATORS: Error message when an invalid hexadecimal character is
#. encountered in escape sequence:
#. {0} = invalid character
#: src/Print-UTF8/print-utf8.cc:196
#, no-c-format
msgid "ERROR: Invalid hexadecimal digit {0}!"
msgstr "FEIL: Ugyldig heksadesimalt siffer {0}!"

#. TRANSLATORS: Error message when an invalid octal character is
#. encountered in escape sequence:
#. {0} = invalid character
#: src/Print-UTF8/print-utf8.cc:210
#, no-c-format
msgid "ERROR: Invalid octal digit {0}!"
msgstr "FEIL: Ugyldig oktalt siffer {0}!"

#. TRANSLATORS: Command-line syntax message prefix:
#. "Usage: <program> [options]".
#: src/Print-UTF8/print-utf8.cc:649
msgid "Usage:"
msgstr "Bruk:"

#. TRANSLATORS: Error message when --multiline-indent/-I is given
#. fewer than the required arguments (indentation, left, right).
#: src/Print-UTF8/print-utf8.cc:770
msgid "ERROR: Invalid arguments for multiline-indent!"
msgstr "FEIL: Ugyldige argumenter for multiline-indent!"

#. TRANSLATORS: Error message when --multiline-center/-C is given
#. fewer than the required arguments (left, right).
#: src/Print-UTF8/print-utf8.cc:784
msgid "ERROR: Invalid arguments for multiline-center!"
msgstr "FEIL: Ugyldige argumenter for multiline-center!"

#. TRANSLATORS: Error message when --separator/-s is given
#. fewer than the required arguments (border_left, separator,
#. border_right).
#: src/Print-UTF8/print-utf8.cc:800
msgid "ERROR: Invalid separator setting!"
msgstr "FEIL: Ugyldig separator-innstilling!"

#. TRANSLATORS: Error message when console width exceeds
#. maximum permitted width of 4096 columns:
#. {0} = specified console width
#: src/Print-UTF8/print-utf8.cc:813
#, no-c-format
msgid "ERROR: Invalid console width {0}!"
msgstr "FEIL: Ugyldig konsollbredde {0}!"

#. TRANSLATORS: Warning message when extraneous unrecognized command
#. line parameters are encountered:
#. {0} = unhandled parameter argument
#: src/Print-UTF8/print-utf8.cc:857
#, no-c-format
msgid "WARNING: Unhandled parameter {0}!"
msgstr "ADVARSEL: Ubehandlet parameter {0}!"
