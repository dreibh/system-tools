#: src/Unix-Timestamp/unixts2time.cc:147
msgid "Usage:"
msgstr "Bruk:"

#. TRANSLATORS: Error message when input timestamp string is invalid.
#: src/Unix-Timestamp/unixts2time.cc:327
msgid "ERROR: Invalid Unix timestamp!"
msgstr "FEIL: Ugyldig Unix-tidsstempel!"

#. TRANSLATORS: Error message when date/time formatting with strftime() fails:
#. %s = time format template
#: src/Unix-Timestamp/unixts2time.cc:361 src/Unix-Timestamp/unixts2time.cc:371
#: src/Unix-Timestamp/unixts2time.cc:406 src/Unix-Timestamp/unixts2time.cc:417
#, c-format
msgid "ERROR: strftime() with format template \"%s\" failed!"
msgstr "FEIL: strftime() med formatmalen «%s» mislyktes!"

#. TRANSLATORS: Human-readable timestamp conversion output:
#. 1st %s   = formatted date/time prefix (before seconds)
#. 2nd %s   = seconds string
#. 3rd %s   = fractional seconds string
#. 4th %s   = formatted date/time suffix (after seconds)
#. 1st %lld = decimal timestamp value
#. 1st %llx = hexadecimal timestamp value
#. 5th %s   = time unit (e.g. s, ms, µs, ns)
#: src/Unix-Timestamp/unixts2time.cc:442
#, c-format
msgid "%s%s%s%s is %lld (0x%llx) %s since the Unix Epoch"
msgstr "%s%s%s%s er %lld (0x%llx) %s siden Unix-epoken"

#, fuzzy
#~ msgid "timespec_get() failed"
#~ msgstr "clock_gettime() mislyktes"

#~ msgid "ERROR: gmtime() failed!"
#~ msgstr "FEIL: gmtime() mislyktes!"

