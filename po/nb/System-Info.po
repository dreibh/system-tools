#. TRANSLATORS: Error message when configuration file specified via
#. -C/--config cannot be found:
#. {0} = file path
#: src/System-Info/System-Info.cc:247
#, no-c-format
msgid "ERROR: Unable to find configuration file {0}!\n"
msgstr "FEIL: Konfigurasjonsfil {0} finnes ikke!\n"

#. TRANSLATORS: Table row label for SSH host key fingerprints section.
#: src/System-Info/System-Info.cc:514
msgid "SSH Keys:"
msgstr "SSH-nøkler:"

#. TRANSLATORS: SSH host key entry:
#. {0} = key index (#1)
#. {1} = fingerprint and key type details
#: src/System-Info/System-Info.cc:518
#, no-c-format
msgid "#{0} {1}"
msgstr "№{0} {1}"

#. TRANSLATORS: Error message when test input file specified via
#. -Y/--test-system-info cannot be found:
#. {0} = file path
#: src/System-Info/System-Info.cc:534
#, no-c-format
msgid "ERROR: Unable to find input file {0}!\n"
msgstr "FEIL: Inndatafil {0} finnes ikke!\n"

#. TRANSLATORS: Table row label for system hostname.
#: src/System-Info/System-Info.cc:588
msgid "Host:"
msgstr "Vert:"

#: src/System-Info/System-Info.cc:599
#, c-format
msgid "%s day"
msgid_plural "%s days"
msgstr[0] "%s dag"
msgstr[1] "%s dager"

#: src/System-Info/System-Info.cc:605
#, c-format
msgid "%d hour"
msgid_plural "%d hours"
msgstr[0] "%d time"
msgstr[1] "%d timer"

#: src/System-Info/System-Info.cc:611
#, c-format
msgid "%d minute"
msgid_plural "%d minutes"
msgstr[0] "%d minutt"
msgstr[1] "%d minutter"

#: src/System-Info/System-Info.cc:617
#, c-format
msgid "%d second"
msgid_plural "%d seconds"
msgstr[0] "%d sekund"
msgstr[1] "%d sekunder"

#. TRANSLATORS: Plural uptime components:
#. {0} = days
#. {1} = hours
#. {2} = minutes
#. {3} = seconds
#: src/System-Info/System-Info.cc:626
msgid "Uptime:"
msgstr "Oppetid:"

#: src/System-Info/System-Info.cc:627
#, no-c-format
msgid "{0}, {1}, {2}, and {3}"
msgstr "{0}, {1}, {2} og {3}"

#. TRANSLATORS: Fallback identifier when operating system name is unknown.
#: src/System-Info/System-Info.cc:634
msgid "Unknown"
msgstr "Ukjent"

#. TRANSLATORS: Operating system details:
#. {0} = OS distribution, version, and codename
#. {1} = kernel release
#: src/System-Info/System-Info.cc:652
msgid "Operating System:"
msgstr "Operativsystem:"

#: src/System-Info/System-Info.cc:653
#, no-c-format
msgid "{0} with kernel {1}"
msgstr "{0} med kjerne {1}"

#. TRANSLATORS: Number of active processes running on the system.
#: src/System-Info/System-Info.cc:662
#, c-format
msgid "%s processes"
msgstr "%s prosesser"

#: src/System-Info/System-Info.cc:667
#, c-format
msgid "%s user"
msgid_plural "%s users"
msgstr[0] "%s bruker"
msgstr[1] "%s brukere"

#. TRANSLATORS: Processor details:
#. {0} = core count
#. {1} = CPU machine architecture (e.g. x86_64, aarch64)
#. {2} = formatted processes count string
#. {3} = formatted users count string
#: src/System-Info/System-Info.cc:676
msgid "Processor:"
msgstr "Prosessor:"

#: src/System-Info/System-Info.cc:677
#, no-c-format
msgid "{0} cores ({1}); {2}; {3}"
msgstr "{0} kjerner ({1}); {2}; {3}"

#: src/System-Info/System-Info.cc:690
#, c-format
msgid "%1.1f %% / %1.1f %% / %1.1f %%"
msgstr "%1.1f %% / %1.1f %% / %1.1f %%"

#. TRANSLATORS: Table row label for system load averages.
#: src/System-Info/System-Info.cc:695
msgid "Load (1/5/15 min):"
msgstr "Last (1/5/15 min.):"

#. TRANSLATORS: Default battery state when the status cannot be determined.
#: src/System-Info/System-Info.cc:713
msgid "unknown"
msgstr "ukjent"

#. TRANSLATORS: Battery status: plugged in but not currently charging.
#: src/System-Info/System-Info.cc:719
msgid "not charging"
msgstr "lades ikke"

#. TRANSLATORS: Battery status: currently charging.
#: src/System-Info/System-Info.cc:724
msgid "charging"
msgstr "lades"

#. TRANSLATORS: Battery status: battery is fully charged.
#: src/System-Info/System-Info.cc:729
msgid "full"
msgstr "fulladet"

#. TRANSLATORS: Battery status: running on battery power (discharging).
#: src/System-Info/System-Info.cc:734
msgid "discharging"
msgstr "lades ut"

#. TRANSLATORS: Battery status entry:
#. {0} = battery number (#1)
#. {1} = charging status (e.g. charging, discharging)
#. {2} = capacity percentage
#: src/System-Info/System-Info.cc:747
#, no-c-format
msgid "#{0} {1}, {2} %"
msgstr "№{0} {1}, {2} %"

#. TRANSLATORS: Table row label for battery section.
#: src/System-Info/System-Info.cc:751
msgid "Battery:"
msgstr "Batteri:"

#. TRANSLATORS: Memory usage:
#. 1st %s = used MiB
#. 2nd %s = total MiB
#. 3rd %s = free/available MiB
#. 4th %s = free percentage
#: src/System-Info/System-Info.cc:760
#, c-format
msgid "%s MiB of %s MiB (%s MiB available: %s %%)"
msgstr "%s MiB av %s MiB (%s MiB tilgjengelig: %s %%)"

#. TRANSLATORS: Table row label for physical RAM utilization.
#: src/System-Info/System-Info.cc:767
msgid "Used Memory:"
msgstr "Brukt minne:"

#. TRANSLATORS: Table row label for swap space utilization.
#. TRANSLATORS: Table row label for swap, and message when no swap space
#. is configured.
#: src/System-Info/System-Info.cc:776 src/System-Info/System-Info.cc:781
msgid "Used Swap:"
msgstr "Brukt bytteplass:"

#: src/System-Info/System-Info.cc:782
msgid "no swap available!"
msgstr "bytteplass ikke tilgjengelig!"

#: src/System-Info/System-Info.cc:814
#, c-format
msgid "%1.0f %% on %s"
msgstr "%1.0f %% på %s"

#. TRANSLATORS: Table row label for storage diskspace utilization.
#: src/System-Info/System-Info.cc:824
msgid "Used Diskspace:"
msgstr "Brukt diskplass:"

#. TRANSLATORS: Table row label for network interfaces section.
#: src/System-Info/System-Info.cc:832
msgid "Network:"
msgstr "Nettverk:"

#. TRANSLATORS: Displayed when a network interface has no IPv4
#. address configured.
#: src/System-Info/System-Info.cc:880
msgid "(No IPv4)"
msgstr "(Ingen IPv4)"

#. TRANSLATORS: Command-line syntax message prefix:
#. "Usage: <program> [options]".
#: src/System-Info/System-Info.cc:946
msgid "Usage:"
msgstr "Bruk:"

#. TRANSLATORS: "LTR" stands for Left-to-Right layout direction.
#. Translators of Right-to-Left languages (such as Arabic, Hebrew, Persian)
#. must translate this string to "RTL".
#: src/System-Info/System-Info.cc:1010
msgid "LTR"
msgstr "LTR"

#: src/System-Info/System-Info.cc:1096
#, no-c-format
msgid "System information on {0}"
msgstr "Systeminformasjon på {0}"

#: src/System-Info/system-info.d/01-example:72
#: src/System-Info/system-info.d/10-company-logo-example:88
#, sh-format
msgid "You can change this banner in ${configdir}!"
msgstr "Du kan endre dette banneret i ${configdir}!"

#: src/System-Info/system-info.d/09-hostname-example:70
msgid "Welcome on the System"
msgstr "Velkommen på systemet"

#: src/System-Info/system-info.d/10-company-logo-example:68
msgid "Welcome to"
msgstr "Velkommen til"
