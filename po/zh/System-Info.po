#. TRANSLATORS: Error message when configuration file specified via
#. -C/--config cannot be found:
#. {0} = file path
#: src/System-Info/System-Info.cc:248
#, no-c-format
msgid "ERROR: Unable to find configuration file {0}!\n"
msgstr "错误：找不到配置文件 {0}！\n"

#. TRANSLATORS: Table row label for SSH host key fingerprints section.
#: src/System-Info/System-Info.cc:515
msgid "SSH Keys:"
msgstr "SSH 密钥："

#. TRANSLATORS: SSH host key entry:
#. {0} = key index (#1)
#. {1} = fingerprint and key type details
#: src/System-Info/System-Info.cc:519
#, no-c-format
msgid "#{0} {1}"
msgstr "#{0} {1}"

#. TRANSLATORS: Error message when test input file specified via
#. -Y/--test-system-info cannot be found:
#. {0} = file path
#: src/System-Info/System-Info.cc:535
#, no-c-format
msgid "ERROR: Unable to find input file {0}!\n"
msgstr "错误：找不到输入文件 {0}！\n"

#. TRANSLATORS: Table row label for system hostname.
#: src/System-Info/System-Info.cc:589
msgid "Host:"
msgstr "主机："

#: src/System-Info/System-Info.cc:600
#, c-format
msgid "%s day"
msgid_plural "%s days"
msgstr[0] "%s 天"

#: src/System-Info/System-Info.cc:606
#, c-format
msgid "%d hour"
msgid_plural "%d hours"
msgstr[0] "%d 小时"

#: src/System-Info/System-Info.cc:612
#, c-format
msgid "%d minute"
msgid_plural "%d minutes"
msgstr[0] "%d 分钟"

#: src/System-Info/System-Info.cc:618
#, c-format
msgid "%d second"
msgid_plural "%d seconds"
msgstr[0] "%d 秒"

#. TRANSLATORS: Plural uptime components:
#. {0} = days
#. {1} = hours
#. {2} = minutes
#. {3} = seconds
#: src/System-Info/System-Info.cc:627
msgid "Uptime:"
msgstr "运行时间："

#: src/System-Info/System-Info.cc:628
#, no-c-format
msgid "{0}, {1}, {2}, and {3}"
msgstr "{0}、{1}、{2} 和 {3}"

#. TRANSLATORS: Fallback identifier when operating system name is unknown.
#: src/System-Info/System-Info.cc:635
msgid "Unknown"
msgstr "未知"

#. TRANSLATORS: Operating system details:
#. {0} = OS distribution, version, and codename
#. {1} = kernel release
#: src/System-Info/System-Info.cc:653
msgid "Operating System:"
msgstr "操作系统："

#: src/System-Info/System-Info.cc:654
#, no-c-format
msgid "{0} with kernel {1}"
msgstr "{0}（内核 {1}）"

#. TRANSLATORS: Number of active processes running on the system.
#: src/System-Info/System-Info.cc:663
#, c-format
msgid "%s processes"
msgstr "%s 个进程"

#: src/System-Info/System-Info.cc:668
#, c-format
msgid "%s user"
msgid_plural "%s users"
msgstr[0] "%s 个用户"

#. TRANSLATORS: Processor details:
#. {0} = core count
#. {1} = CPU machine architecture (e.g. x86_64, aarch64)
#. {2} = formatted processes count string
#. {3} = formatted users count string
#: src/System-Info/System-Info.cc:677
msgid "Processor:"
msgstr "处理器："

#: src/System-Info/System-Info.cc:678
#, no-c-format
msgid "{0} cores ({1}); {2}; {3}"
msgstr "{0} 核 ({1})；{2}；{3}"

#: src/System-Info/System-Info.cc:691
#, c-format
msgid "%1.1f %% / %1.1f %% / %1.1f %%"
msgstr "%1.1f %% / %1.1f %% / %1.1f %%"

#. TRANSLATORS: Table row label for system load averages.
#: src/System-Info/System-Info.cc:696
msgid "Load (1/5/15 min):"
msgstr "负载（1/5/15 分钟）："

#. TRANSLATORS: Default battery state when the status cannot be determined.
#: src/System-Info/System-Info.cc:714
msgid "unknown"
msgstr "未知"

#. TRANSLATORS: Battery status: plugged in but not currently charging.
#: src/System-Info/System-Info.cc:720
msgid "not charging"
msgstr "未充电"

#. TRANSLATORS: Battery status: currently charging.
#: src/System-Info/System-Info.cc:725
msgid "charging"
msgstr "正在充电"

#. TRANSLATORS: Battery status: battery is fully charged.
#: src/System-Info/System-Info.cc:730
msgid "full"
msgstr "已充满"

#. TRANSLATORS: Battery status: running on battery power (discharging).
#: src/System-Info/System-Info.cc:735
msgid "discharging"
msgstr "正在放电"

#. TRANSLATORS: Battery status entry:
#. {0} = battery number (#1)
#. {1} = charging status (e.g. charging, discharging)
#. {2} = capacity percentage
#: src/System-Info/System-Info.cc:748
#, no-c-format
msgid "#{0} {1}, {2} %"
msgstr "#{0} {1}，{2} %"

#. TRANSLATORS: Table row label for battery section.
#: src/System-Info/System-Info.cc:752
msgid "Battery:"
msgstr "电池："

#. TRANSLATORS: Memory usage:
#. 1st %s = used MiB
#. 2nd %s = total MiB
#. 3rd %s = free/available MiB
#. 4th %s = free percentage
#: src/System-Info/System-Info.cc:761
#, c-format
msgid "%s MiB of %s MiB (%s MiB available: %s %%)"
msgstr "%s MiB / %s MiB（可用 %s MiB：%s %%）"

#. TRANSLATORS: Table row label for physical RAM utilization.
#: src/System-Info/System-Info.cc:768
msgid "Used Memory:"
msgstr "已用内存："

#. TRANSLATORS: Table row label for swap space utilization.
#. TRANSLATORS: Table row label for swap, and message when no swap space
#. is configured.
#: src/System-Info/System-Info.cc:777 src/System-Info/System-Info.cc:782
msgid "Used Swap:"
msgstr "已用交换空间："

#: src/System-Info/System-Info.cc:783
msgid "no swap available!"
msgstr "无可用交换空间！"

#: src/System-Info/System-Info.cc:815
#, c-format
msgid "%1.0f %% on %s"
msgstr "%1.0f %% 于 %s"

#. TRANSLATORS: Table row label for storage diskspace utilization.
#: src/System-Info/System-Info.cc:825
msgid "Used Diskspace:"
msgstr "已用磁盘空间："

#. TRANSLATORS: Table row label for network interfaces section.
#: src/System-Info/System-Info.cc:833
msgid "Network:"
msgstr "网络："

#. TRANSLATORS: Displayed when a network interface has no IPv4
#. address configured.
#: src/System-Info/System-Info.cc:881
msgid "(No IPv4)"
msgstr "(无 IPv4)"

#. TRANSLATORS: Command-line syntax message prefix:
#. "Usage: <program> [options]".
#: src/System-Info/System-Info.cc:947
msgid "Usage:"
msgstr "用法："

#. TRANSLATORS: "LTR" stands for Left-to-Right layout direction.
#. Translators of Right-to-Left languages (such as Arabic, Hebrew, Persian)
#. must translate this string to "RTL".
#: src/System-Info/System-Info.cc:1014
msgid "LTR"
msgstr "LTR"

#: src/System-Info/System-Info.cc:1100
#, no-c-format
msgid "System information on {0}"
msgstr "系统信息（截至 {0}）"

#: src/System-Info/system-info.d/01-example:72
#, sh-format
msgid "You can change this banner in ${configdir}!"
msgstr "您可以在 ${configdir} 中更改此横幅！"

#: src/System-Info/system-info.d/09-hostname-example:70
msgid "Welcome on the System"
msgstr "欢迎使用本系统"

#: src/System-Info/system-info.d/10-company-logo-example:68
msgid "Welcome to"
msgstr "欢迎访问"
