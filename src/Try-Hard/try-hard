# Bash options:
set -euo pipefail

# gettext options:
export TEXTDOMAIN="try-hard"
if [ -z "${TEXTDOMAINDIR:-}" ] && [[ "@CMAKE_INSTALL_FULL_DATADIR@" != @* ]] ; then
   export TEXTDOMAINDIR="@CMAKE_INSTALL_FULL_DATADIR@/locale"
fi
if command -v gettext.sh >/dev/null 2>&1 ; then
   # shellcheck disable=SC1091
   . gettext.sh
else
   gettext () { printf "%s" "$1"; }
   eval_gettext () { eval "printf '%s' \"$1\""; }
fi


# ###### Version ############################################################
version () {
   echo "try-hard @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"
   exit 0
}


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   local opt=$'\x1b[1m'
   local arg=$'\x1b[4m'
   local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   local progname="${program##*/}"
   local manpage="${cmd}${progname%.*}${reset}"
   local lrm=""
   local rlm=""
   # TRANSLATORS: Text direction: LTR (Left-to-Right) or RTL (Right-to-Left)
   if [ "$(gettext "LTR")" = "RTL" ] ; then
      lrm=$'\xe2\x80\x8e'
      rlm=$'\xe2\x80\x8f'
   fi
   local homepage="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_HOMEPAGE_URL@\a@PROJECT_HOMEPAGE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   local repository="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_SOURCE_URL@\a@PROJECT_SOURCE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   local usageHeader
   # TRANSLATORS: Command-line syntax message prefix:
   # "Usage: <program> [options]".
   usageHeader="$(gettext "Usage:")"
   cat >&2 <<EOF
${header}${usageHeader}${reset}
${cmd}${program}${reset} ${arg}max_trials${reset} ${arg}max_delay${reset}
	${syn}[${reset}${opt}-m${reset} ${arg}min_delay${reset} ${syn}|${reset} ${opt}--min-delay${reset} ${arg}min_delay${reset}${syn}]${reset}
	${syn}[${reset}${opt}-A${reset} ${arg}delay_increment${reset} ${syn}|${reset} ${opt}--additive-increase${reset} ${arg}delay_increment${reset}${syn}]${reset}
	${syn}[${reset}${opt}-M${reset} ${arg}delay_factor${reset} ${syn}|${reset} ${opt}--multiplicative-increase${reset} ${arg}delay_factor${reset}${syn}]${reset}
	${syn}[${reset}${opt}-T${reset} ${arg}max_delay${reset} ${syn}|${reset} ${opt}--truncate-delay${reset} ${arg}truncated_max_delay${reset}${syn}]${reset}
	${syn}[${reset}${opt}-D${reset} ${syn}|${reset} ${opt}--deterministic${reset}${syn}]${reset}
	${syn}[${reset}${opt}-q${reset} ${syn}|${reset} ${opt}--quiet${reset}${syn}]${reset}
	${syn}[${reset}${opt}-w${reset} ${syn}|${reset} ${opt}--verbose${reset}${syn}]${reset}
	${syn}--${reset} ${arg}command${reset} ${syn}[${reset}${arg}argument${reset} ...${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-h${reset} ${syn}|${reset} ${opt}--help${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-v${reset} ${syn}|${reset} ${opt}--version${reset}${syn}]${reset}

EOF
   # shellcheck disable=SC2059
   # TRANSLATORS: Informational message at the end of usage:
   # 1st %s = manpage name, 2nd %s = documentation URL, 3rd %s = repository URL
   printf >&2 "$(gettext "For further information, see the man page for %s, read the documentation at %s, examine the source code at %s, or consult your favourite LLM.")\n" \
      "${manpage}" "${homepage}" "${repository}"
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
if (( BASH_VERSINFO[0] < 4 )) || (( (BASH_VERSINFO[0] == 4) && (BASH_VERSINFO[1] < 4) )) ; then
   # TRANSLATORS: Error message when installed Bash version is older than 4.4.
   gettext >&2 "ERROR: Bash 4.4 or higher is required!"
   echo >&2
   exit 1
fi
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:/usr/local/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if [[ -z "${GETOPT}" ]] || "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]] ; then
   # TRANSLATORS: Error message when enhanced/GNU getopt is not found or is
   # incompatible.
   gettext >&2 "ERROR: Enhanced/GNU getopt is required!"
   echo >&2
   exit 1
fi
if ! options="$("${GETOPT}" -o m:A:M:T:Dqwhv --long min-delay:,additive-increase:,multiplicative-increase:,truncate-delay:,deterministic,quiet,verbose,help,version -a -- "$@")" ; then
   usage "$0" 1
fi
eval set -- "${options}"

VERBOSE=0
MIN_DELAY="0.0"
ADDITIVE_INCREASE="0.0"
MULTIPLICATIVE_INCREASE="1.0"
TRUNCATE_DELAY="31536000.0"   # 1 year
DETERMINISTIC=0
while [ $# -gt 0 ] ; do
   case "$1" in
      -m | --min-delay)
         # shellcheck disable=SC2034
         delayValue="$2"
         shift
         if [[ ! "${delayValue}" =~ ^([0-9]+|[0-9]*\.[0-9]+|[0-9]+\.[0-9]*)$ ]] ; then
            # TRANSLATORS: Error message when the minimum delay parameter
            # is invalid:
            # ${delayValue} = specified minimum delay string
            eval_gettext >&2 "ERROR: Invalid delay value \${delayValue}!"
            echo >&2
            exit 1
         fi
         MIN_DELAY="${delayValue}"
         ;;
      -A | --additive-increase)
         # shellcheck disable=SC2034
         delayValue="$2"
         shift
         if [[ ! "${delayValue}" =~ ^([0-9]+|[0-9]*\.[0-9]+|[0-9]+\.[0-9]*)$ ]] ; then
            # TRANSLATORS: Error message when the additive increase increment
            # is invalid:
            # ${delayValue} = specified additive increment string
            eval_gettext >&2 "ERROR: Invalid delay value \${delayValue}!"
            echo >&2
            exit 1
         fi
         ADDITIVE_INCREASE="${delayValue}"
         ;;
      -M | --multiplicative-increase)
         # shellcheck disable=SC2034
         delayValue="$2"
         shift
         if [[ ! "${delayValue}" =~ ^([0-9]+|[0-9]*\.[0-9]+|[0-9]+\.[0-9]*)$ ]] ; then
            # TRANSLATORS: Error message when the multiplicative increase factor
            # is invalid:
            # ${delayValue} = specified multiplicative factor string
            eval_gettext >&2 "ERROR: Invalid delay value \${delayValue}!"
            echo >&2
            exit 1
         fi
         MULTIPLICATIVE_INCREASE="${delayValue}"
         ;;
      -T | --truncate-delay)
         # shellcheck disable=SC2034
         delayValue="$2"
         shift
         if [[ ! "${delayValue}" =~ ^([0-9]+|[0-9]*\.[0-9]+|[0-9]+\.[0-9]*)$ ]] ; then
            # TRANSLATORS: Error message when the maximum delay
            # ceiling/truncation value is invalid:
            # ${delayValue} = specified delay truncation ceiling string
            eval_gettext >&2 "ERROR: Invalid delay value \${delayValue}!"
            echo >&2
            exit 1
         fi
         TRUNCATE_DELAY="${delayValue}"
         ;;
      -D | --deterministic)
         DETERMINISTIC=1
         ;;
      -q | --quiet)
         VERBOSE=0
         ;;
      -w | --verbose)
         VERBOSE=1
         ;;
      -h | --help)
         usage "$0" 0
         ;;
      -v | --version)
         version
         ;;
      --)
         shift
         break
         ;;
      *)
         # This should not happen: wrong getopt parameters, or missing case?
         echo >&2 "INTERNAL ERROR: Unhandled option $1!"
         exit 1
         ;;
   esac
   shift
done
if [ $# -lt 3 ] ; then
   usage "$0" 1
fi

# shellcheck disable=SC2034
MAX_TRIALS="$1"
if [[ ! "${MAX_TRIALS}" =~ ^[0-9]+$ ]] || [ "${MAX_TRIALS}" -lt 1 ] ; then
   # TRANSLATORS: Error message when the maximum trial count parameter
   # is invalid:
   # ${MAX_TRIALS} = specified trial count value
   eval_gettext >&2 "ERROR: Invalid maximum trials \${MAX_TRIALS}!"
   echo >&2
   exit 1
fi
# shellcheck disable=SC2034
delayValue="$2"
if [[ ! "${delayValue}" =~ ^([0-9]+|[0-9]*\.[0-9]+|[0-9]+\.[0-9]*)$ ]] ; then
   # TRANSLATORS: Error message when the initial maximum delay value
   # is invalid:
   # ${delayValue} = specified maximum delay string
   eval_gettext >&2 "ERROR: Invalid delay value \${delayValue}!"
   echo >&2
   exit 1
fi
if [ "${DETERMINISTIC}" -eq 0 ] && ! command -v random-sleep >/dev/null ; then
   # TRANSLATORS: Error message when the random-sleep utility is not found
   # in PATH.
   gettext >&2 "ERROR: Cannot find random-sleep in the search path!"
   echo >&2
   exit 1
fi
MAX_DELAY="${delayValue}"
shift 2


# ====== Ensure that min delay <= max delay =================================
read -r minDelay maxDelay <<<"$(LC_ALL=C awk \
   -v minDelayArgument="${MIN_DELAY}" \
   -v maxDelayArgument="${MAX_DELAY}" '
function min(a, b) { a += 0.0; b += 0.0; return (a < b ? a : b); }
function max(a, b) { a += 0.0; b += 0.0; return (a > b ? a : b); }
BEGIN {
   minDelay = min(minDelayArgument, maxDelayArgument);
   maxDelay = max(minDelayArgument, maxDelayArgument);
   printf("%g %g\n", minDelay, maxDelay);
}
'
)"


# ====== Run loop ===========================================================
trial=0
while true ; do
   # ====== Start next trial ================================================
   trial=$((trial + 1))
   if [ "${VERBOSE}" -eq 1 ] ; then
      # TRANSLATORS: Progress notification before running a command trial:
      # ${trial} = current trial attempt index
      # ${MAX_TRIALS} = maximum configured number of trials
      printf '\x1b[34m%s: %s \x1b[37m%s\x1b[0m\n' "$(date +%FT%H:%M:%S)" "$(eval_gettext "Trial \${trial}/\${MAX_TRIALS}:")" "$*"
   fi

   # ====== Run the command =================================================
   exitStatus=0
   if "$@" ; then
      exit 0
   else
      exitStatus=$?
   fi

   # ====== Check whether trial limit has been reached ======================
   if [ "${trial}" -ge "${MAX_TRIALS}" ] ; then
      if [ "${VERBOSE}" -eq 1 ] ; then
         # TRANSLATORS: Notification when retry limit has been exceeded
         # without success:
         # ${MAX_TRIALS} = total number of attempts executed
         printf '\x1b[34m%s: %s\x1b[0m\n' "$(date +%FT%H:%M:%S)" "$(eval_gettext "Tried \${MAX_TRIALS} times -> giving up now!")"
      fi
      exit "${exitStatus}"
   fi

   # ====== Increase delay for next trial ===================================
   if [ "${trial}" -gt 1 ] ; then
      read -r minDelay maxDelay <<<"$(LC_ALL=C awk \
         -v minDelayArgument="${minDelay}" \
         -v maxDelayArgument="${maxDelay}" \
         -v additiveIncrease="${ADDITIVE_INCREASE}" \
         -v multiplicativeIncrease="${MULTIPLICATIVE_INCREASE}" \
         -v minDelayBoundary="${MIN_DELAY}" \
         -v maxDelayBoundary="${TRUNCATE_DELAY}" '
function min(a, b) { a += 0.0; b += 0.0; return (a < b ? a : b); }
function max(a, b) { a += 0.0; b += 0.0; return (a > b ? a : b); }
BEGIN {
   minDelay  = min(minDelayArgument, maxDelayArgument);
   maxDelay  = max(minDelayArgument, maxDelayArgument);
   addInc    = additiveIncrease + 0.0;
   multInc   = multiplicativeIncrease + 0.0;
   minBound  = minDelayBoundary + 0.0;
   maxBound  = maxDelayBoundary + 0.0;

   newMinDelay = max(min(minDelay * multInc + addInc, maxBound), minBound);
   newMaxDelay = max(min(maxDelay * multInc + addInc, maxBound), minBound);
   printf("%g %g\n", min(newMinDelay, newMaxDelay), max(newMinDelay, newMaxDelay));
}
'
)"
   fi

   # ====== Wait a random time span =========================================
   if [ "${DETERMINISTIC}" -eq 0 ] ; then
      if [ "${VERBOSE}" -eq 1 ] ; then
         # TRANSLATORS: Progress notification when a trial fails and random
         # backoff begins:
         # ${trial} = current trial attempt index
         # ${MAX_TRIALS} = maximum configured number of trials
         # ${exitStatus} = command exit return code
         # ${minDelay} = lower bound of random sleep interval in seconds
         # ${maxDelay} = upper bound of random sleep interval in seconds
         printf '\x1b[34m%s: %s\x1b[0m\n' "$(date +%FT%H:%M:%S)" "$(eval_gettext "Trial \${trial}/\${MAX_TRIALS} failed (exit code \${exitStatus}) -> waiting random time from [\${minDelay}, \${maxDelay}] s ...")"
         random-sleep -w "${minDelay}" "${maxDelay}"
      else
         random-sleep "${minDelay}" "${maxDelay}"
      fi
   else
      if [ "${VERBOSE}" -eq 1 ] ; then
         # TRANSLATORS: Progress notification when a trial fails and
         # deterministic backoff begins:
         # ${trial} = current trial attempt index
         # ${MAX_TRIALS} = maximum configured number of trials
         # ${maxDelay} = sleep duration in seconds
         printf '\x1b[34m%s: %s\x1b[0m\n' "$(date +%FT%H:%M:%S)" "$(eval_gettext "Trial \${trial}/\${MAX_TRIALS} failed -> waiting for \${maxDelay} s ...")"
      fi
      LC_ALL=C sleep "${maxDelay}"
   fi
done
