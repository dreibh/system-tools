# ###### Bash completion for try-hard #######################################
_try_hard()
{
   # shellcheck disable=SC2034
   local cur prev words cword comp_args
   if type -t _comp_initialize >/dev/null ; then
      _comp_initialize -- "$@" || return
   elif type -t _init_completion >/dev/null ; then
      _init_completion || return
   else
      COMPREPLY=()
      cur="${COMP_WORDS[COMP_CWORD]}"
      prev="${COMP_WORDS[COMP_CWORD-1]}"
      words=("${COMP_WORDS[@]}")
      cword="${COMP_CWORD}"
   fi

   # ====== Delegate completion for subcommand after '--' ===================
   local i
   for (( i = 1; i < COMP_CWORD; i++ )) ; do
      if [ "${COMP_WORDS[i]}" = "--" ] ; then
         if type -t _command_offset >/dev/null ; then
            _command_offset $((i + 1))
         elif (( COMP_CWORD == i + 1 )) ; then
            mapfile -t COMPREPLY < <(compgen -c -- "${cur}")
         else
            mapfile -t COMPREPLY < <(compgen -f -- "${cur}")
         fi
         return 0
      fi
   done

   # ====== Scan prior arguments before '--' ================================
   local positionalCount=0
   for (( i = 1; i < cword; i++ )) ; do
      case "${words[i]}" in
         -h | --help | -v | --version)
            return 0
            ;;
         -m | --min-delay | -A | --additive-increase | \
         -M | --multiplicative-increase | -T | --truncate-delay)
            # Skip option argument:
            i=$((i + 1))
            ;;
         --min-delay=* | --additive-increase=* | \
         --multiplicative-increase=* | --truncate-delay=*)
            ;;
         -*)
            ;;
         *)
            positionalCount=$((positionalCount + 1))
            ;;
      esac
   done

   # ====== Option-specific arguments =======================================
   case "${prev}" in
      -m | --min-delay)
         compopt -o nosort 2>/dev/null || true
         mapfile -t COMPREPLY < <(compgen -W "0 0.1 0.333 0.5 1 2 5 10 30 60 120 300 900 3600" -- "${cur}")
         return 0
         ;;
      -A | --additive-increase)
         compopt -o nosort 2>/dev/null || true
         mapfile -t COMPREPLY < <(compgen -W "0 1 2 5 10 60" -- "${cur}")
         return 0
         ;;
      -M | --multiplicative-increase)
         compopt -o nosort 2>/dev/null || true
         mapfile -t COMPREPLY < <(compgen -W "1.0 1.1 1.25 1.5 2.0" -- "${cur}")
         return 0
         ;;
      -T | --truncate-delay)
         compopt -o nosort 2>/dev/null || true
         mapfile -t COMPREPLY < <(compgen -W "30 60 120 300 900 1800 3600 86400" -- "${cur}")
         return 0
         ;;
   esac

   # ====== Options vs. positional arguments ================================
   local opts="
-m
--min-delay
-A
--additive-increase
-M
--multiplicative-increase
-T
--truncate-delay
-D
--deterministic
-q
--quiet
-w
--verbose
-h
--help
-v
--version
--
"
   if [[ "${cur}" == -* ]] ; then
      mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   elif (( positionalCount == 0 )) ; then
      compopt -o nosort 2>/dev/null || true
      mapfile -t COMPREPLY < <(compgen -W "{1..20}" -- "${cur}")
   elif (( positionalCount == 1 )) ; then
      compopt -o nosort 2>/dev/null || true
      mapfile -t COMPREPLY < <(compgen -W "1 2 5 10 30 60 120 300 900 1800 3600 86400" -- "${cur}")
   else
      mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   fi
   return 0
}

complete -F _try_hard try-hard
