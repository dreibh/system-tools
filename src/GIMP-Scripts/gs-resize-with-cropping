# Bash options:
set -euo pipefail


# ###### Version ############################################################
version () {
   echo "gs-resize-with-cropping @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"
   exit 0
}


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   local opt=$'\x1b[1m'
   local arg=$'\x1b[4m'
   local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   local progname="${program##*/}"
   local manpage="${cmd}${progname%.*}${reset}"
   local homepage=$'[\x1b[1m\x1b]8;;@PROJECT_HOMEPAGE_URL@\a@PROJECT_HOMEPAGE_URL@\a\x1b]8;;\a\x1b[0m]'
   local repository=$'[\x1b[1m\x1b]8;;@PROJECT_SOURCE_URL@\a@PROJECT_SOURCE_URL@\a\x1b]8;;\a\x1b[0m]'
   cat >&2 <<EOF
${header}Usage:${reset}
${cmd}${program}${reset} ${arg}input_filename${reset} ${arg}output_filename${reset}
	${syn}[${reset}${opt}-A${reset} ${arg}aspect_ratio${reset} ${syn}|${reset} ${opt}--aspect${reset} ${arg}aspect_ratio${reset}${syn}]${reset}
	${syn}[${reset}${opt}-A${reset} ${arg}H:V|HxV${reset} ${syn}|${reset} ${opt}--aspect${reset} ${arg}H:V|HxV${reset}${syn}]${reset}
	${syn}[${reset}${opt}-A${reset} ${arg}A0|...|A9|An${reset} ${syn}|${reset} ${opt}--aspect${reset} ${arg}A0|...|A9|An${reset}${syn}]${reset}
	${syn}[${reset}${opt}-A${reset} ${arg}keep${reset} ${syn}|${reset} ${opt}--aspect${reset} ${arg}keep${reset}${syn}]${reset}
	${syn}[${reset}${opt}-W${reset} ${arg}new_width${reset} ${syn}|${reset} ${opt}--width${reset} ${arg}new_width${reset}${syn}]${reset}
	${syn}[${reset}${opt}-H${reset} ${arg}new_height${reset} ${syn}|${reset} ${opt}--height${reset} ${arg}new_height${reset}${syn}]${reset}
	${syn}[${reset}${opt}-q${reset} ${syn}|${reset} ${opt}--quiet${reset}${syn}]${reset}
	${syn}[${reset}${opt}-w${reset} ${syn}|${reset} ${opt}--verbose${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-h${reset} ${syn}|${reset} ${opt}--help${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-v${reset} ${syn}|${reset} ${opt}--version${reset}${syn}]${reset}

EOF
   printf >&2 "For further information, see the man page for %s, read the documentation at %s, examine the source code at %s, or consult your favourite LLM.\n" \
      "${manpage}" "${homepage}" "${repository}"
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
if (( BASH_VERSINFO[0] < 4 )) || (( (BASH_VERSINFO[0] == 4) && (BASH_VERSINFO[1] < 2) )) ; then
   echo >&2 "ERROR: Bash 4.2 or higher is required!"
   exit 1
fi
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:/usr/local/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if [[ -z "${GETOPT}" ]] || "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]] ; then
   echo >&2 "ERROR: Enhanced/GNU getopt is required!"
   exit 1
fi
if ! options="$("${GETOPT}" -o A:W:H:wqhv --long aspect:,width:,height:,verbose,quiet,help,version -a -- "$@")" ; then
   usage "$0" 1
fi
eval set -- "${options}"

VERBOSE=0
ASPECT="keep"
NEW_WIDTH=""
NEW_HEIGHT=""
while [ $# -gt 0 ] ; do
   case "$1" in
      -A | --aspect)
         ASPECT="$2"
         shift
         ;;
      -W | --width)
         NEW_WIDTH="$2"
         shift
         ;;
      -H | --height)
         NEW_HEIGHT="$2"
         shift
         ;;
      -v | --version)
         version
         ;;
      -w | --verbose)
         VERBOSE=1
         ;;
      -q | --quiet)
         VERBOSE=0
         ;;
      -h | --help)
         usage "$0" 0
         ;;
      --)
         shift
         break
         ;;
      *)
         # This should not happen: wrong getopt parameters, or missing case?
         echo >&2 "INTERNAL ERROR: Unhandled option $1!"
         exit 1
         ;;
   esac
   shift
done

if [ $# -ne 2 ] ; then
   usage "$0" 1
fi
INPUT_FILENAME="$1"
OUTPUT_FILENAME="$2"


# ====== Prepare output aspect ratio ========================================
outputAspectRatio=""
if [ "${ASPECT}" != "keep" ] ; then
   if [[ "${ASPECT}" =~ ^([0-9]+|[0-9]*\.[0-9]+|[0-9]+\.[0-9]*)([:xX])([0-9]+|[0-9]*\.[0-9]+|[0-9]+\.[0-9]*)$ ]] ; then
      aspectNum="${BASH_REMATCH[1]}"
      aspectDen="${BASH_REMATCH[3]}"
      if ! outputAspectRatio="$(LC_ALL=C awk -v n="${aspectNum}" -v d="${aspectDen}" 'BEGIN { if((n + 0.0) <= 0.0 || (d + 0.0) <= 0.0) exit 1; printf "%1.16f\n", n / d }')" ; then
         echo >&2 "ERROR: Bad aspect specification: ${ASPECT}!"
         exit 1
      fi
   elif [[ "${ASPECT}" =~ ^([0-9]+|[0-9]*\.[0-9]+|[0-9]+\.[0-9]*)$ ]] ; then
      if ! outputAspectRatio="$(LC_ALL=C awk -v r="${BASH_REMATCH[1]}" 'BEGIN { if((r + 0.0) <= 0.0) exit 1; printf "%1.16f\n", r + 0.0 }')" ; then
         echo >&2 "ERROR: Bad aspect specification: ${ASPECT}!"
         exit 1
      fi
   elif [[ "${ASPECT}" =~ ^[Aa][0-9n]$ ]] ; then
      outputAspectRatio="1.414213562373"   # DIN A<n> is sqrt(2):1 in landscape format
   else
      echo >&2 "ERROR: Bad aspect specification: ${ASPECT}!"
      exit 1
   fi
fi
if [ -n "${NEW_WIDTH}" ] && [ -n "${NEW_HEIGHT}" ] ; then
   echo >&2 "ERROR: -W|--width and -H|--height are mutually exclusive!"
   exit 1
fi
if [ -n "${NEW_WIDTH}" ] && [[ ! "${NEW_WIDTH}" =~ ^[1-9][0-9]*$ ]] ; then
   echo >&2 "ERROR: Invalid width ${NEW_WIDTH}!"
   exit 1
fi
if [ -n "${NEW_HEIGHT}" ] && [[ ! "${NEW_HEIGHT}" =~ ^[1-9][0-9]*$ ]] ; then
   echo >&2 "ERROR: Invalid height ${NEW_HEIGHT}!"
   exit 1
fi


# ====== Detect GraphicsMagick ==============================================
GM="$(command -v gm || true)"
if [ -z "${GM}" ] ; then
   echo >&2 "ERROR: GraphicsMagick is not installed! Try:"
   echo >&2 " * Ubuntu/Debian: sudo apt install -y graphicsmagick"
   echo >&2 " * Fedora:        sudo dnf install -y GraphicsMagick"
   echo >&2 " * OpenSUSE:      sudo zypper install -y GraphicsMagick"
   echo >&2 " * Alpine:        sudo apk add graphicsmagick"
   echo >&2 " * FreeBSD:       sudo pkg install -y GraphicsMagick"
   echo >&2 " * NetBSD:        sudo pkgin -y install GraphicsMagick"
   echo >&2 " * OpenBSD:       sudo pkg_add GraphicsMagick"
   echo >&2 " * Solaris:       sudo pkg install graphicsmagick"
   echo >&2 " * Apple:         brew install GraphicsMagick"
   exit 1
fi


# ====== Obtain image width and height ======================================
if [ ! -f "${INPUT_FILENAME}" ] ; then
   echo >&2 "ERROR: Input file ${INPUT_FILENAME} does not exist!"
   exit 1
fi
inputImageSize="$("${GM}" identify -format "%wx%h\n" "${INPUT_FILENAME}" | head -n 1)"
if [[ ! "${inputImageSize}" =~ ^([1-9][0-9]*)x([1-9][0-9]*)$ ]] ; then
   echo >&2 "ERROR: Unable to determine dimensions of input file ${INPUT_FILENAME}!"
   exit 1
fi
inputWidth="${BASH_REMATCH[1]}"
inputHeight="${BASH_REMATCH[2]}"
inputAspectRatio="$(LC_ALL=C awk -v w="${inputWidth}" -v h="${inputHeight}" 'BEGIN { printf "%1.16f\n", w / h }')"
if [ -z "${outputAspectRatio}" ] ; then
   outputAspectRatio="${inputAspectRatio}"
fi
if [ "${VERBOSE}" -ne 0 ] ; then
   echo "Input: ${inputWidth}*${inputHeight} (${inputAspectRatio})"
fi


# ====== Crop image =========================================================
if LC_ALL=C awk -v ia="${inputAspectRatio}" -v oa="${outputAspectRatio}" 'BEGIN { exit !((ia + 0.0) < (oa + 0.0)) }' ; then
   croppedInputWidth="${inputWidth}"
   croppedInputHeight="$(LC_ALL=C awk -v w="${croppedInputWidth}" -v oa="${outputAspectRatio}" -v maxH="${inputHeight}" 'BEGIN { v = int((w / oa) + 0.5); if(v < 1) v = 1; if(v > maxH) v = maxH; print v }')"
else
   croppedInputHeight="${inputHeight}"
   croppedInputWidth="$(LC_ALL=C awk -v h="${croppedInputHeight}" -v oa="${outputAspectRatio}" -v maxW="${inputWidth}" 'BEGIN { v = int((h * oa) + 0.5); if(v < 1) v = 1; if(v > maxW) v = maxW; print v }')"
fi
cx="$(LC_ALL=C awk -v w="${inputWidth}" -v cw="${croppedInputWidth}" 'BEGIN { v = int(((w - cw) / 2) + 0.5); if(v < 0) v = 0; print v }')"
cy="$(LC_ALL=C awk -v h="${inputHeight}" -v ch="${croppedInputHeight}" 'BEGIN { v = int(((h - ch) / 2) + 0.5); if(v < 0) v = 0; print v }')"
if [ "${VERBOSE}" -ne 0 ] ; then
   echo "Crop: ${croppedInputWidth}*${croppedInputHeight} [cx=${cx} cy=${cy}] (${outputAspectRatio}:1)"
fi


# ====== Set new width or height ============================================
DO_RESIZE=1
if [ -n "${NEW_WIDTH}" ] ; then
   NEW_HEIGHT="$(LC_ALL=C awk -v w="${NEW_WIDTH}" -v oa="${outputAspectRatio}" 'BEGIN { v = int((w / oa) + 0.5); if(v < 1) v = 1; print v }')"
elif [ -n "${NEW_HEIGHT}" ] ; then
   NEW_WIDTH="$(LC_ALL=C awk -v h="${NEW_HEIGHT}" -v oa="${outputAspectRatio}" 'BEGIN { v = int((h * oa) + 0.5); if(v < 1) v = 1; print v }')"
else
   NEW_WIDTH="${croppedInputWidth}"
   NEW_HEIGHT="${croppedInputHeight}"
   DO_RESIZE=0
fi
if [ "${VERBOSE}" -ne 0 ] ; then
   echo "Resize: ${NEW_WIDTH}*${NEW_HEIGHT} (${outputAspectRatio}:1)"
fi


# ====== Run "convert" ======================================================
CONVERT_ARGS=(
   -crop "${croppedInputWidth}x${croppedInputHeight}+${cx}+${cy}"
)
if [ "${DO_RESIZE}" -ne 0 ] ; then
   CONVERT_ARGS+=( -resize "${NEW_WIDTH}x${NEW_HEIGHT}" )
fi
CONVERT_ARGS+=( -auto-orient +repage )

if [ "${INPUT_FILENAME}" -ef "${OUTPUT_FILENAME}" ] ; then
   outputDir="$(dirname -- "${OUTPUT_FILENAME}")"
   outputBase="$(basename -- "${OUTPUT_FILENAME}")"
   TEMP_DIR="$(mktemp -d "${outputDir}/.gs-resize-XXXXXX")"
   trap 'rm -rf "${TEMP_DIR}"' EXIT
   "${GM}" convert "${INPUT_FILENAME}" "${CONVERT_ARGS[@]}" "${TEMP_DIR}/${outputBase}"
   mv -f "${TEMP_DIR}/${outputBase}" "${OUTPUT_FILENAME}"
   rm -rf "${TEMP_DIR}"
   trap - EXIT
else
   rm -f "${OUTPUT_FILENAME}"
   "${GM}" convert "${INPUT_FILENAME}" "${CONVERT_ARGS[@]}" "${OUTPUT_FILENAME}"
fi

if [ "${VERBOSE}" -ne 0 ] ; then
   echo -n "Done: "
   "${GM}" identify "${OUTPUT_FILENAME}"
fi
