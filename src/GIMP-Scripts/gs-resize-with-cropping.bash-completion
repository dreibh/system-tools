# ###### Bash completion for gs-resize-with-cropping ########################
_gs_resize_with_cropping()
{
   # shellcheck disable=SC2034
   local cur prev words cword split=false comp_args
   if type -t _comp_initialize >/dev/null ; then
      _comp_initialize -s -n : -- "$@" || return
   elif type -t _init_completion >/dev/null ; then
      _init_completion -s -n : || return
   else
      COMPREPLY=()
      cur="${COMP_WORDS[COMP_CWORD]}"
      prev="${COMP_WORDS[COMP_CWORD-1]}"
      words=("${COMP_WORDS[@]}")
      cword="${COMP_CWORD}"
   fi

   # ====== Track options and positional arguments across prior words =======
   local i afterDashDash=0 activeOpt="" positionalCount=0
   for (( i = 1; i < cword; i++ )) ; do
      if (( afterDashDash )) ; then
         positionalCount=$((positionalCount + 1))
         continue
      fi
      if [[ -n "${activeOpt}" ]] ; then
         activeOpt=""
         continue
      fi
      case "${words[i]}" in
         --)
            afterDashDash=1
            ;;
         -h | --help | -v | --version)
            return 0
            ;;
         -A | --aspect)
            activeOpt="aspect"
            ;;
         -W | --width)
            activeOpt="width"
            ;;
         -H | --height)
            activeOpt="height"
            ;;
         --aspect=* | --width=* | --height=*)
            ;;
         -[qw]*[AWH])
            case "${words[i]: -1}" in
               A) activeOpt="aspect" ;;
               W) activeOpt="width"  ;;
               H) activeOpt="height" ;;
            esac
            ;;
         -*)
            ;;
         *)
            positionalCount=$((positionalCount + 1))
            ;;
      esac
   done

   if [[ "${split}" == "true" ]] && [[ -z "${activeOpt}" ]] ; then
      case "${prev}" in
         --aspect) activeOpt="aspect" ;;
         --width)  activeOpt="width"  ;;
         --height) activeOpt="height" ;;
      esac
   fi

   case "${activeOpt}" in
      aspect)
         compopt -o nosort 2>/dev/null || true
         mapfile -t COMPREPLY < <(compgen -W "keep 16:9 16:10 4:3 3:2 1:1 21:9 A0 A3 A4 A5 An" -- "${cur}")
         if type -t __ltrim_colon_completions >/dev/null ; then
            __ltrim_colon_completions "${cur}"
         fi
         return 0
         ;;
      width)
         compopt -o nosort 2>/dev/null || true
         mapfile -t COMPREPLY < <(compgen -W "640 800 1024 1280 1600 1920 2048 2560 3840 4096" -- "${cur}")
         return 0
         ;;
      height)
         compopt -o nosort 2>/dev/null || true
         mapfile -t COMPREPLY < <(compgen -W "480 600 720 768 900 1080 1200 1440 2160" -- "${cur}")
         return 0
         ;;
   esac

   [[ "${split}" == "true" ]] && return 0

   # ====== Options vs. positional file arguments ===========================
   if (( ! afterDashDash )) && [[ "${cur}" == -* ]] ; then
      local opts="
-A
--aspect
-W
--width
-H
--height
-q
--quiet
-w
--verbose
-h
--help
-v
--version
--
"
      mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
      return 0
   fi

   if (( positionalCount == 0 )) ; then
      if type -t _filedir >/dev/null ; then
         _filedir '@(jpeg|JPEG|jpg|JPG|png|PNG|dng|DNG|cr2|CR2|gif|GIF|webp|WEBP|tif|TIF|tiff|TIFF|bmp|BMP|pdf|PDF)'
      else
         mapfile -t COMPREPLY < <(compgen -f -- "${cur}")
      fi
   elif (( positionalCount == 1 )) ; then
      if type -t _filedir >/dev/null ; then
         _filedir
      else
         mapfile -t COMPREPLY < <(compgen -f -- "${cur}")
      fi
   elif (( ! afterDashDash )) ; then
      local opts="
-A
--aspect
-W
--width
-H
--height
-q
--quiet
-w
--verbose
"
      mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   fi
   return 0
}

complete -F _gs_resize_with_cropping gs-resize-with-cropping
