# ###### Bash completion for gs-test-gimp ###################################
_gs_test_gimp()
{
   # shellcheck disable=SC2034
   local cur prev words cword comp_args
   if type -t _comp_initialize >/dev/null ; then
      _comp_initialize -- "$@" || return
   elif type -t _init_completion >/dev/null ; then
      _init_completion || return
   else
      COMPREPLY=()
      cur="${COMP_WORDS[COMP_CWORD]}"
      prev="${COMP_WORDS[COMP_CWORD-1]}"
      words=("${COMP_WORDS[@]}")
      cword="${COMP_CWORD}"
   fi

   # ====== Stop completing after '--', help, or version ====================
   local i
   for (( i = 1; i < cword; i++ )) ; do
      case "${words[i]}" in
         -- | -h | --help | -v | --version)
            return 0
            ;;
      esac
   done

   # ====== All options (no positional arguments accepted) ==================
   local opts="
-q
--quiet
-w
--verbose
-h
--help
-v
--version
"
   mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   return 0
}

complete -F _gs_test_gimp gs-test-gimp
