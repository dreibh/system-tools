# ###### Bash completion for gs-oilify ######################################
_gs_oilify()
{
   # shellcheck disable=SC2034
   local cur prev words cword split=false comp_args
   if type -t _comp_initialize >/dev/null ; then
      _comp_initialize -s -- "$@" || return
   elif type -t _init_completion >/dev/null ; then
      _init_completion -s || return
   else
      COMPREPLY=()
      cur="${COMP_WORDS[COMP_CWORD]}"
      prev="${COMP_WORDS[COMP_CWORD-1]}"
      words=("${COMP_WORDS[@]}")
      cword="${COMP_CWORD}"
   fi

   # ====== Track options and positional arguments across prior words =======
   local i afterDashDash=0 activeOpt="" positionalCount=0
   for (( i = 1; i < cword; i++ )) ; do
      if (( afterDashDash )) ; then
         positionalCount=$((positionalCount + 1))
         continue
      fi
      if [[ -n "${activeOpt}" ]] ; then
         activeOpt=""
         continue
      fi
      case "${words[i]}" in
         --)
            afterDashDash=1
            ;;
         -h | --help | -v | --version)
            return 0
            ;;
         -S | --mask-size)
            activeOpt="masksize"
            ;;
         -I | --intensity-mode)
            activeOpt="bool"
            ;;
         --mask-size=* | --intensity-mode=*)
            ;;
         -[qw]*[SI])
            case "${words[i]: -1}" in
               S) activeOpt="masksize" ;;
               I) activeOpt="bool"     ;;
            esac
            ;;
         -*)
            ;;
         *)
            positionalCount=$((positionalCount + 1))
            ;;
      esac
   done

   if [[ "${split}" == "true" ]] && [[ -z "${activeOpt}" ]] ; then
      case "${prev}" in
         --mask-size)      activeOpt="masksize" ;;
         --intensity-mode) activeOpt="bool"     ;;
      esac
   fi

   case "${activeOpt}" in
      masksize)
         compopt -o nosort 2>/dev/null || true
         mapfile -t COMPREPLY < <(compgen -W "2 4 6 8 10 12 16 20 32 64" -- "${cur}")
         return 0
         ;;
      bool)
         compopt -o nosort 2>/dev/null || true
         mapfile -t COMPREPLY < <(compgen -W "on off" -- "${cur}")
         return 0
         ;;
   esac

   [[ "${split}" == "true" ]] && return 0

   # ====== Options vs. positional file arguments ===========================
   if (( ! afterDashDash )) && [[ "${cur}" == -* ]] ; then
      local opts="
-S
--mask-size
-I
--intensity-mode
-q
--quiet
-w
--verbose
-h
--help
-v
--version
--
"
      mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
      return 0
   fi

   if (( positionalCount == 0 )) ; then
      if type -t _filedir >/dev/null ; then
         _filedir '@(jpeg|JPEG|jpg|JPG|png|PNG|dng|DNG|cr2|CR2|gif|GIF|webp|WEBP|tif|TIF|tiff|TIFF|bmp|BMP|pdf|PDF|xcf|XCF)'
      else
         mapfile -t COMPREPLY < <(compgen -f -- "${cur}")
      fi
   elif (( positionalCount == 1 )) ; then
      if type -t _filedir >/dev/null ; then
         _filedir
      else
         mapfile -t COMPREPLY < <(compgen -f -- "${cur}")
      fi
   elif (( ! afterDashDash )) ; then
      local opts="
-S
--mask-size
-I
--intensity-mode
-q
--quiet
-w
--verbose
"
      mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   fi
   return 0
}

complete -F _gs_oilify gs-oilify
