# Bash options:
set -euo pipefail


# ###### Version ############################################################
version () {
   echo "gs-list-gradients @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"
   exit 0
}


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   # local opt=$'\x1b[1m'
   # local arg=$'\x1b[4m'
   # local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   cat >&2 <<EOF
${header}Usage:${reset}
${cmd}${program}${reset}
EOF
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
if (( BASH_VERSINFO[0] < 4 )) || (( (BASH_VERSINFO[0] == 4) && (BASH_VERSINFO[1] < 2) )) ; then
   echo >&2 "ERROR: Bash 4.2 or higher is required!"
   exit 1
fi
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]]; then
   echo >&2 "ERROR: Enhanced/GNU getopt is required!"
   exit 1
fi
options="$(${GETOPT} -o wqhv --long verbose,quiet,help,version -a -- "$@")"
# shellcheck disable=SC2181
if [[ $? -ne 0 ]]; then
   usage "$0" 1
fi

eval set -- "${options}"

while [ $# -gt 0 ] ; do
   case "$1" in
      -h | --help)
         usage "$0" 0
         ;;
      -v | --version)
         version
         ;;
      --)
         shift
         break
         ;;
      *)
         # This should not happen: wrong getopt parameters, or missing case?
         echo >&2 "INTERNAL ERROR: Unhandled option $1!"
         exit 1
         ;;
  esac
  shift
done

if [ $# -ne 0 ] ; then
   usage "$0" 1
fi

# ====== List gradients =====================================================
(
   for baseDirectory in /usr/local/share /usr/share ; do
      if [ -d "${baseDirectory}/gimp" ] ; then
         find "${baseDirectory}/gimp" -name "*.ggr" -exec basename {} .ggr \;
      fi
   done
) | tr '_' ' ' | sort -u
