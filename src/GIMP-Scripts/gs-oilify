# Bash options:
set -euo pipefail


# ###### Version ############################################################
version () {
   echo "gs-oilify @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"
   exit 0
}


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   local opt=$'\x1b[1m'
   local arg=$'\x1b[4m'
   local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   local progname="${program##*/}"
   local manpage="${cmd}${progname%.*}${reset}"
   local homepage=$'[\x1b[1m\x1b]8;;@PROJECT_HOMEPAGE_URL@\a@PROJECT_HOMEPAGE_URL@\a\x1b]8;;\a\x1b[0m]'
   local repository=$'[\x1b[1m\x1b]8;;@PROJECT_SOURCE_URL@\a@PROJECT_SOURCE_URL@\a\x1b]8;;\a\x1b[0m]'
   cat >&2 <<EOF
${header}Usage:${reset}
${cmd}${program}${reset} ${arg}input_filename${reset} ${arg}output_filename${reset}
	${syn}[${reset}${opt}-S${reset} ${arg}masksize${reset} ${syn}|${reset} ${opt}--mask-size${reset} ${arg}masksize${reset}${syn}]${reset}
	${syn}[${reset}${opt}-I${reset} ${arg}on|off${reset} ${syn}|${reset} ${opt}--intensity-mode${reset} ${arg}on|off${reset}${syn}]${reset}
	${syn}[${reset}${opt}-q${reset} ${syn}|${reset} ${opt}--quiet${reset}${syn}]${reset}
	${syn}[${reset}${opt}-w${reset} ${syn}|${reset} ${opt}--verbose${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-h${reset} ${syn}|${reset} ${opt}--help${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-v${reset} ${syn}|${reset} ${opt}--version${reset}${syn}]${reset}

EOF
   printf >&2 "For further information, see the man page for %s, read the documentation at %s, examine the source code at %s, or consult your favourite LLM.\n" \
      "${manpage}" "${homepage}" "${repository}"
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------


# ###### Parse boolean option into Script-Fu TRUE/FALSE #####################
parse_bool () {
   local optionName="$1"
   local rawValue="$2"
   case "${rawValue,,}" in
      on | true | yes | 1)
         printf '%s' "TRUE"
         ;;
      off | false | no | 0)
         printf '%s' "FALSE"
         ;;
      *)
         echo >&2 "ERROR: Invalid value ${rawValue} for ${optionName}!"
         return 1
         ;;
   esac
}


# ###### Escape string for TinyScheme double-quoted literal #################
scheme_escape () {
   local value="$1"
   value="${value//\\/\\\\}"
   value="${value//\"/\\\"}"
   printf '%s' "${value}"
}



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
if (( BASH_VERSINFO[0] < 4 )) || (( (BASH_VERSINFO[0] == 4) && (BASH_VERSINFO[1] < 2) )) ; then
   echo >&2 "ERROR: Bash 4.2 or higher is required!"
   exit 1
fi
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:/usr/local/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if [[ -z "${GETOPT}" ]] || "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]] ; then
   echo >&2 "ERROR: Enhanced/GNU getopt is required!"
   exit 1
fi
if ! options="$("${GETOPT}" -o S:I:wqhv --long mask-size:,intensity-mode:,verbose,quiet,help,version -a -- "$@")" ; then
   usage "$0" 1
fi
eval set -- "${options}"

MASK_SIZE=8
INTENSITY_MODE="TRUE"
VERBOSE=0
while [ $# -gt 0 ] ; do
   case "$1" in
      -S | --mask-size)
         MASK_SIZE="$2"
         shift
         if [[ ! "${MASK_SIZE}" =~ ^[0-9]+$ ]] || (( 10#${MASK_SIZE} < 2 )) || (( 10#${MASK_SIZE} > 200 )) ; then
            echo >&2 "ERROR: Invalid value ${MASK_SIZE} for -S|--mask-size!"
            exit 1
         fi
         MASK_SIZE=$((10#${MASK_SIZE}))
         ;;
      -I | --intensity-mode)
         INTENSITY_MODE="$(parse_bool "-I|--intensity-mode" "$2")"
         shift
         ;;
      -w | --verbose)
         VERBOSE=1
         ;;
      -q | --quiet)
         VERBOSE=0
         ;;
      -h | --help)
         usage "$0" 0
         ;;
      -v | --version)
         version
         ;;
      --)
         shift
         break
         ;;
      *)
         # This should not happen: wrong getopt parameters, or missing case?
         echo >&2 "INTERNAL ERROR: Unhandled option $1!"
         exit 1
         ;;
   esac
   shift
done

if [ $# -ne 2 ] ; then
   usage "$0" 1
fi
INPUT_FILENAME="$1"
OUTPUT_FILENAME="$2"

if [ ! -f "${INPUT_FILENAME}" ] ; then
   echo >&2 "ERROR: Input file ${INPUT_FILENAME} does not exist!"
   exit 1
fi


# ====== Detect GIMP, and determine version-specific call options ===========
GIMP_CONSOLE=""
case "${UNAME}" in
   OpenBSD)
      for version in 3.6 3.4 3.2 3.0 2.8 2.6 ; do
         if command -v "gimp-console-${version}" >/dev/null ; then
            GIMP_CONSOLE="$(command -v "gimp-console-${version}")"
            break
         fi
      done
      ;;
   Darwin)
      GIMP_CONSOLE="$(command -v gimp-console || command -v /Applications/GIMP.app/Contents/MacOS/gimp-console-3 || command -v /Applications/GIMP.app/Contents/MacOS/gimp-console || true)"
      ;;
   *)
      GIMP_CONSOLE="$(command -v gimp-console || true)"
      ;;
esac
if [ -z "${GIMP_CONSOLE}" ] ; then
   echo >&2 "ERROR: GIMP is not installed! Try:"
   echo >&2 " * Ubuntu/Debian: sudo apt install -y gimp"
   echo >&2 " * Fedora:        sudo dnf install -y gimp"
   echo >&2 " * OpenSUSE:      sudo zypper install -y gimp"
   echo >&2 " * Alpine:        sudo apk add gimp"
   echo >&2 " * FreeBSD:       sudo pkg install -y gimp3-app"
   echo >&2 " * NetBSD:        sudo pkgin -y install gimp"
   echo >&2 " * OpenBSD:       sudo pkg_add \"\$(pkg_info -z \"gimp->=3\")\""
   echo >&2 " * Solaris:       sudo pkg install gimp"
   echo >&2 " * Apple:         brew install gimp"
   exit 1
fi
GIMP_VERSION="$(LC_ALL=C "${GIMP_CONSOLE}" --version | sed -e 's/GNU Image Manipulation Program version //')"
if [[ "${GIMP_VERSION}" =~ ^[012] ]] ; then
   # GIMP 2.x:
   GIMP_OPTIONS=(--new-instance --no-interface --no-splash --batch-interpreter plug-in-script-fu-eval --batch -)
else
   # GIMP 3.x:
   GIMP_OPTIONS=(--quit --new-instance --no-interface --no-splash --batch-interpreter plug-in-script-fu-eval --batch -)
fi

# This script does not use fonts, or gradients/palettes/brushes:
GIMP_OPTIONS+=( --no-fonts )


# ====== Prepare output path (protect in-place overwrite) ===================
TARGET_OUTPUT="${OUTPUT_FILENAME}"
TEMP_DIR=""
if [ "${INPUT_FILENAME}" -ef "${OUTPUT_FILENAME}" ] ; then
   outputDir="$(dirname -- "${OUTPUT_FILENAME}")"
   outputBase="$(basename -- "${OUTPUT_FILENAME}")"
   TEMP_DIR="$(mktemp -d "${outputDir}/.gs-oilify-XXXXXX")"
   trap 'rm -rf "${TEMP_DIR}"' EXIT
   TARGET_OUTPUT="${TEMP_DIR}/${outputBase}"
else
   rm -f "${OUTPUT_FILENAME}"
fi

SCHEME_INPUT="$(scheme_escape "${INPUT_FILENAME}")"
SCHEME_OUTPUT="$(scheme_escape "${TARGET_OUTPUT}")"


# ====== Call GIMP ==========================================================
( cat <<EOF
(let*
   ; ------ Initialise and load image ---------------------------------------
   ((inputFileName    "${SCHEME_INPUT}")
    (outputFileName   "${SCHEME_OUTPUT}")
    (maskSize         ${MASK_SIZE})
    (intensityMode    ${INTENSITY_MODE})
    (image            (car (gimp-file-load RUN-NONINTERACTIVE inputFileName inputFileName)))
    (imageType        (if (not (defined? 'gimp-image-get-active-layer))
                         ; New GIMP 3.0 API:
                         (car (gimp-image-get-base-type image))
                         ; Old GIMP 2.x API:
                         (car (gimp-image-base-type image)))
                      )
    (layer            (if (not (defined? 'gimp-image-get-active-layer))
                         ; New GIMP 3.0 API:
                         (car (list (vector-ref (car (gimp-image-get-selected-layers image)) 0)))
                         ; Old GIMP 2.x API:
                         (car (gimp-image-get-active-layer image)))
                      )
   )

   ; ------ Apply filter ----------------------------------------------------
   ; First, make sure that the image is RGB, not indexed color mode!
   (if (not (= RGB imageType))
      (gimp-image-convert-rgb image))

   ; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   ; GEGL Oilify options: https://gegl.org/operations/gegl-oilify.html
   ; ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

   (cond
      ((not (defined? 'plug-in-oilify))
         ; New GIMP 3.0 API:
         (gimp-drawable-merge-new-filter layer "gegl:oilify" 0 LAYER-MODE-REPLACE 1.0
             "mask-radius" (max 1 (quotient maskSize 2))
             "use-inten"   intensityMode
             "intensities" 128
         )
      )
      (else
         ; Old GIMP 2.x API:
         (plug-in-oilify RUN-NONINTERACTIVE image layer maskSize intensityMode)
      )
   )

   ; ------ Save result -----------------------------------------------------
   (if (defined? 'gimp-drawable-merge-new-filter)
      (begin  ; New GIMP >= 3.0 API:
         ; FIXME: This does not work when running in GIMP 2.x!
         ; (file-png-export
         ;    #:run-mode         RUN-NONINTERACTIVE
         ;    #:image            image
         ;    #:file             outputFileName
         ;    #:options          -1
         ;    #:interlaced       TRUE
         ;    #:compression      6
         ;    #:bkgd             TRUE
         ;    #:offs             FALSE
         ;    #:phys             TRUE
         ;    #:time             TRUE
         ;    #:save-transparent FALSE
         ;    #:optimize-palette TRUE
         ; )
         (file-png-export RUN-NONINTERACTIVE image
            outputFileName -1
            TRUE 6 TRUE FALSE TRUE TRUE FALSE TRUE)
      )
      (begin  ; Old GIMP < 3.0 API:
         (file-png-save2 RUN-NONINTERACTIVE image
            (car (gimp-image-get-active-layer image))
            outputFileName outputFileName
            TRUE 6 TRUE TRUE FALSE TRUE TRUE FALSE TRUE)
      )
   )

   ; ------ Clean up --------------------------------------------------------
   (gimp-image-delete image)
)
(gimp-quit TRUE)
EOF
) | env LC_ALL=C.UTF-8 HOME=/tmp "${GIMP_CONSOLE}" "${GIMP_OPTIONS[@]}" 2>&1 | \
(
   if [ "${VERBOSE}" -ne 0 ] ; then
      cat
   else
      grep -vE "^ts>|^\(#t\)$|^#t$|^Copyright|Welcome to (GIMP|TinyScheme)|^using gegl copy|^gimp_color_transform_new: using babl|-WARNING|^Warning: Unknown input_id|^Failed to parse tag cache|^Please use named arguments:|^script quit with code:|^GIMP is started|^$" || true
   fi
)


# ====== Check result =======================================================
if [ ! -e "${TARGET_OUTPUT}" ] ; then
   echo >&2 "ERROR: ${OUTPUT_FILENAME} has not been produced. Something went wrong!"
   exit 1
fi
if [ -n "${TEMP_DIR}" ] ; then
   mv -f "${TARGET_OUTPUT}" "${OUTPUT_FILENAME}"
   rm -rf "${TEMP_DIR}"
   trap - EXIT
fi
