# ###### Bash completion for extract-pem ####################################
_extract_pem()
{
   # shellcheck disable=SC2034
   local cur prev words cword split comp_args
   if type -t _comp_initialize >/dev/null ; then
      _comp_initialize -s -- "$@" || return
   else
      _init_completion -s || return
   fi

   # ====== Check previous arguments for '--' and option state ==============
   local i endOfOptions=0 expectPrefixArg=0 hasOnlyFirst=0 hasSkipEntry=0
   for (( i = 1; i < cword; i++ )) ; do
      if (( expectPrefixArg )) ; then
         expectPrefixArg=0
         continue
      fi
      case "${words[i]}" in
         --)
            endOfOptions=1
            break
            ;;
         -h|--help|-v|--version)
            return 0
            ;;
         -1|--only-first-entry)
            hasOnlyFirst=1
            ;;
         -f|--skip-first-entry|-l|--skip-last-entry)
            hasSkipEntry=1
            ;;
         -o|--output-prefix)
            expectPrefixArg=1
            ;;
      esac
   done

   if (( endOfOptions )) ; then
      cur="${words[cword]}"
      if type -t _comp_compgen_filedir >/dev/null ; then
         _comp_compgen_filedir '@(cer|cert|crl|crt|csr|key|pem)'
      else
         _filedir '@(cer|cert|crl|crt|csr|key|pem)'
      fi
      return 0
   fi

   # ====== Special case: output file prefix (-o / --output-prefix) =========
   if (( expectPrefixArg )) || \
      [[ "${split-}" == true && "${prev}" == "--output-prefix" ]] ; then
      if type -t _comp_compgen_filedir >/dev/null ; then
         _comp_compgen_filedir
      else
         _filedir
      fi
      return 0
   fi

   [[ "${split-}" == true ]] && return 0

   # ====== Complete PEM files ==============================================
   if [[ "${cur}" != -* ]] ; then
      if type -t _comp_compgen_filedir >/dev/null ; then
         _comp_compgen_filedir '@(cer|cert|crl|crt|csr|key|pem)'
      else
         _filedir '@(cer|cert|crl|crt|csr|key|pem)'
      fi
      return 0
   fi

   # ====== All options =====================================================
   local opts="
-
-o
--output-prefix
-q
--quiet
-c
--no-color
--no-colour
-h
--help
-v
--version
--
"
   if (( ! hasSkipEntry )) ; then
      opts+="
-1
--only-first-entry
"
   fi
   if (( ! hasOnlyFirst )) ; then
      opts+="
-f
--skip-first-entry
-l
--skip-last-entry
"
   fi

   mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   return 0
}

complete -F _extract_pem extract-pem
