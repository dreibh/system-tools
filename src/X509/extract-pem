# Bash options:
set -euo pipefail

# gettext options:
export TEXTDOMAIN="extract-pem"
[[ "@CMAKE_INSTALL_FULL_DATADIR@" != @* ]] && export TEXTDOMAINDIR="@CMAKE_INSTALL_FULL_DATADIR@/locale"
if command -v gettext.sh >/dev/null 2>&1 ; then
   # shellcheck disable=SC1091
   . gettext.sh
else
   gettext () { printf "%s" "$1"; }
   eval_gettext () { eval "printf '%s' \"$1\""; }
fi


# ###### Version ############################################################
version () {
   echo "extract-pem @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"
   exit 0
}


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   local opt=$'\x1b[1m'
   local arg=$'\x1b[4m'
   local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   local progname="${program##*/}"
   local manpage="${cmd}${progname%.*}${reset}"
   local lrm=""
   local rlm=""
   # TRANSLATORS: Text direction: LTR (Left-to-Right) or RTL (Right-to-Left)
   if [ "$(gettext "LTR")" = "RTL" ] ; then
      lrm=$'\xe2\x80\x8e'
      rlm=$'\xe2\x80\x8f'
   fi
   local homepage="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_HOMEPAGE_URL@\a@PROJECT_HOMEPAGE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   local repository="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_SOURCE_URL@\a@PROJECT_SOURCE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   # TRANSLATORS: Command-line syntax message prefix:
   # "Usage: <program> [options]".
   cat >&2 <<EOF
${header}$(gettext "Usage:")${reset}
${cmd}${program}${reset} ${arg}pem_file${reset} ...
	${syn}[${reset}${opt}-o${reset} ${arg}file_name_prefix${reset} ${syn}|${reset} ${opt}--output-prefix${reset} ${arg}file_name_prefix${reset}${syn}]${reset}
	${syn}[${reset}${opt}-1${reset} ${syn}|${reset} ${opt}--only-first-entry${reset}${syn}]${reset}
	${syn}[${reset}${opt}-f${reset} ${syn}|${reset} ${opt}--skip-first-entry${reset}${syn}]${reset}
	${syn}[${reset}${opt}-l${reset} ${syn}|${reset} ${opt}--skip-last-entry${reset}${syn}]${reset}
	${syn}[${reset}${opt}-q${reset} ${syn}|${reset} ${opt}--quiet${reset}${syn}]${reset}
	${syn}[${reset}${opt}-c${reset} ${syn}|${reset} ${opt}--no-color${reset} ${syn}|${reset} ${opt}--no-colour${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-h${reset} ${syn}|${reset} ${opt}--help${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-v${reset} ${syn}|${reset} ${opt}--version${reset}${syn}]${reset}

EOF
   # TRANSLATORS: Informational message at the end of usage:
   # "For further information, see the man page for <manpage>, read the documentation at <url>, examine the source code at <url>, or consult your favourite LLM.".
   # shellcheck disable=SC2059
   printf >&2 "$(gettext "For further information, see the man page for %s, read the documentation at %s, examine the source code at %s, or consult your favourite LLM.")\n" \
      "${manpage}" "${homepage}" "${repository}"
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------


# ###### Clean up temporary files on exit or signal #########################
currentTmp=""
pendingTmp=""
cleanup () {
   exec 3>&- 2>/dev/null || true
   rm -f -- "${currentTmp}" "${pendingTmp}"
}
trap cleanup EXIT INT TERM HUP


# ###### Commit or skip a completed PEM entry ###############################
commit_pending_entry () {
   local skipEntry="$1"
   if [ -z "${pendingTmp}" ] ; then
      return 0
   fi

   if [ "${skipEntry}" -ne 0 ] ; then
      rm -f -- "${pendingTmp}"
      if [ "${QUIET}" -eq 0 ] ; then
         printf '=> %s %s\n' "$(gettext "SKIPPING")" "${pendingOutputFile}"
      fi
   else
      case "${pendingCategory}" in
         cert)
            chmod "${DEFAULT_FILE_MODE}" "${pendingTmp}"
            certificate=$((certificate + 1))
            ;;
         csr)
            chmod "${DEFAULT_FILE_MODE}" "${pendingTmp}"
            csr=$((csr + 1))
            ;;
         crl)
            chmod "${DEFAULT_FILE_MODE}" "${pendingTmp}"
            crl=$((crl + 1))
            ;;
         key)
            chmod 600 "${pendingTmp}"
            key=$((key + 1))
            ;;
      esac
      mv -f -- "${pendingTmp}" "${pendingOutputFile}"
      if [ "${QUIET}" -eq 0 ] ; then
         printf '=> %s\n' "${pendingOutputFile}"
      fi
   fi

   pendingTmp=""
   pendingOutputFile=""
   pendingCategory=""
}


# ###### Extract PEM blocks from standard input #############################
extract_stream () {
   local entry=0
   local currentType=""
   local currentCategory=""
   local currentOutputFile=""
   local line

   while IFS= read -r line || [[ -n "${line}" ]] ; do
      line="${line%$'\r'}"
      if [ -z "${currentOutputFile}" ] ; then
         if [[ "${line}" =~ ^-----BEGIN\ ([^-]+(-[^-]+)*)-----[[:space:]]*$ ]] ; then
            commit_pending_entry 0

            type="${BASH_REMATCH[1]}"
            case "${type}" in
               "CERTIFICATE" | "TRUSTED CERTIFICATE" | "X509 CERTIFICATE")
                  certIndex=$((certIndex + 1))
                  currentCategory="cert"
                  currentOutputFile="${OUTPUT_PREFIX}${certIndex}.crt"
                  ;;
               "CERTIFICATE REQUEST" | "NEW CERTIFICATE REQUEST")
                  csrIndex=$((csrIndex + 1))
                  currentCategory="csr"
                  currentOutputFile="${OUTPUT_PREFIX}${csrIndex}.csr"
                  ;;
               "X509 CRL")
                  crlIndex=$((crlIndex + 1))
                  currentCategory="crl"
                  currentOutputFile="${OUTPUT_PREFIX}${crlIndex}.crl"
                  ;;
               "PRIVATE KEY" | "ENCRYPTED PRIVATE KEY" | \
               "RSA PRIVATE KEY" | "EC PRIVATE KEY" | "DSA PRIVATE KEY" | \
               "OPENSSH PRIVATE KEY")
                  keyIndex=$((keyIndex + 1))
                  currentCategory="key"
                  currentOutputFile="${OUTPUT_PREFIX}${keyIndex}.key"
                  ;;
               *)
                  # shellcheck disable=SC2034
                  eval_gettext >&2 "ERROR: Unexpected type \${type} in \${PEM_FILE}!"
                  echo >&2
                  exit 1
                  ;;
            esac

            local outputDir="."
            if [[ "${currentOutputFile}" == */* ]] ; then
               outputDir="${currentOutputFile%/*}"
               [[ -z "${outputDir}" ]] && outputDir="/"
            fi
            if [ ! -d "${outputDir}" ] ; then
               # TRANSLATORS: Error message when target output directory does not exist:
               # %s = directory path
               # shellcheck disable=SC2059
               printf >&2 "$(gettext "ERROR: Output directory %s does not exist!")\n" "${outputDir}"
               exit 1
            fi

            currentType="${type}"
            currentTmp="$(umask 077 && mktemp "${outputDir%/}/.extract-pem.XXXXXXXXXX")"
            exec 3>"${currentTmp}"
            entry=$((entry + 1))
            printf '%s\n' "${line}" >&3
         fi
      else
         if [[ "${line}" =~ ^-----END\ ([^-]+(-[^-]+)*)-----[[:space:]]*$ ]] ; then
            local endType="${BASH_REMATCH[1]}"
            if [ "${endType}" != "${currentType}" ] ; then
               # TRANSLATORS: Error message when PEM END marker does not match BEGIN marker:
               # 1st %s = END marker type, 2nd %s = BEGIN marker type, 3rd %s = PEM file path
               # shellcheck disable=SC2059
               printf >&2 "$(gettext "ERROR: Mismatched END %s for BEGIN %s in %s!")\n" \
                  "${endType}" "${currentType}" "${PEM_FILE}"
               exit 1
            fi

            printf '%s\n' "${line}" >&3
            exec 3>&-

            pendingTmp="${currentTmp}"
            pendingOutputFile="${currentOutputFile}"
            pendingCategory="${currentCategory}"
            currentTmp=""
            currentOutputFile=""
            currentCategory=""
            currentType=""

            if [ "${entry}" -eq 1 ] ; then
               if [ "${ONLY_FIRST_ENTRY}" -eq 1 ] ; then
                  break
               elif [ "${SKIP_FIRST_ENTRY}" -eq 1 ] ; then
                  commit_pending_entry 1
               fi
            fi
         elif [[ "${line}" =~ ^-----BEGIN\ ([^-]+(-[^-]+)*)-----[[:space:]]*$ ]] ; then
            # TRANSLATORS: Error message when a new BEGIN marker appears before END marker:
            # 1st %s = unclosed BEGIN marker type, 2nd %s = PEM file path
            # shellcheck disable=SC2059
            printf >&2 "$(gettext "ERROR: Unclosed BEGIN %s block in %s!")\n" \
               "${currentType}" "${PEM_FILE}"
            exit 1
         else
            printf '%s\n' "${line}" >&3
         fi
      fi
   done

   if [ -n "${currentOutputFile}" ] ; then
      # TRANSLATORS: Error message when EOF is reached inside an unclosed PEM block:
      # 1st %s = unclosed BEGIN marker type, 2nd %s = PEM file path
      # shellcheck disable=SC2059
      printf >&2 "$(gettext "ERROR: Unclosed BEGIN %s block in %s!")\n" \
         "${currentType}" "${PEM_FILE}"
      exit 1
   fi

   commit_pending_entry "${SKIP_LAST_ENTRY}"
}



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
if (( BASH_VERSINFO[0] < 4 )) || (( (BASH_VERSINFO[0] == 4) && (BASH_VERSINFO[1] < 4) )) ; then
   gettext >&2 "ERROR: Bash 4.4 or higher is required!"
   echo >&2
   exit 1
fi
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:/usr/local/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if [[ -z "${GETOPT}" ]] || "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]] ; then
   gettext >&2 "ERROR: Enhanced/GNU getopt is required!"
   echo >&2
   exit 1
fi
if ! options="$("${GETOPT}" -o o:1flqchv --long output-prefix:,only-first-entry,skip-first-entry,skip-last-entry,quiet,no-color,no-colour,help,version -a -- "$@")" ; then
   usage "$0" 1
fi
eval set -- "${options}"

OUTPUT_PREFIX="output-"
ONLY_FIRST_ENTRY=0
SKIP_FIRST_ENTRY=0
SKIP_LAST_ENTRY=0
QUIET=0
COLOR_HEADER=$'\x1b[34m'
COLOR_RESET=$'\x1b[0m'
while [ $# -gt 0 ] ; do
   case "$1" in
      -o | --output-prefix)
         OUTPUT_PREFIX="$2"
         shift
         ;;
      -1 | --only-first-entry)
         ONLY_FIRST_ENTRY=1
         ;;
      -f | --skip-first-entry)
         SKIP_FIRST_ENTRY=1
         ;;
      -l | --skip-last-entry)
         SKIP_LAST_ENTRY=1
         ;;
      -q | --quiet)
         QUIET=1
         ;;
      -c | --no-color | --no-colour)
         COLOR_HEADER=""
         COLOR_RESET=""
         ;;
      -h | --help)
         usage "$0" 0
         ;;
      -v | --version)
         version
         ;;
      --)
         shift
         break
         ;;
      *)
         # This should not happen: wrong getopt parameters, or missing case?
         echo >&2 "INTERNAL ERROR: Unhandled option $1!"
         exit 1
         ;;
   esac
   shift
done
if [ $# -lt 1 ] ; then
   usage "$0" 1
fi
if [ "${ONLY_FIRST_ENTRY}" -eq 1 ] ; then
   if [ "${SKIP_FIRST_ENTRY}" -ne 0 ] || [ "${SKIP_LAST_ENTRY}" -ne 0 ] ; then
      gettext >&2 "ERROR: --only-first-entry and --skip-first-entry/--skip-last-entry are mutually exclusive!"
      echo >&2
      exit 1
   fi
fi

# Compute default non-key file permissions respecting current umask:
currentUmask="$(umask)"
DEFAULT_FILE_MODE="$(printf '%04o' $(( 0666 & ~(8#${currentUmask}) )))"

# ====== Extract each PEM file ==============================================
certificate=0
csr=0
crl=0
key=0
certIndex=0
csrIndex=0
crlIndex=0
keyIndex=0

while [ $# -gt 0 ] ; do
   PEM_FILE="$1"
   shift

   if [ "${PEM_FILE}" = "-" ] ; then
      PEM_FILE="/dev/stdin"
      if [ "${QUIET}" -eq 0 ] ; then
         printf '%s%s%s\n' "${COLOR_HEADER}" "$(eval_gettext "Extracting \${PEM_FILE} ...")" "${COLOR_RESET}"
      fi
      extract_stream
   else
      if [ ! -e "${PEM_FILE}" ] ; then
         eval_gettext >&2 "ERROR: Unable to find PEM file \${PEM_FILE}!"
         echo >&2
         exit 1
      fi
      if [ "${QUIET}" -eq 0 ] ; then
         printf '%s%s%s\n' "${COLOR_HEADER}" "$(eval_gettext "Extracting \${PEM_FILE} ...")" "${COLOR_RESET}"
      fi
      extract_stream < "${PEM_FILE}"
   fi
done

if [ "${QUIET}" -eq 0 ] ; then
   printf '%s%s%s\n' "${COLOR_HEADER}" "$(eval_gettext "Done: \${certificate} certificates, \${csr} CSRs, \${crl} CRLs, \${key} keys")" "${COLOR_RESET}"
fi
