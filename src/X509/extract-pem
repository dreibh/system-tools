# Bash options:
set -euo pipefail

# gettext options:
export TEXTDOMAIN="extract-pem"
[[ "@CMAKE_INSTALL_FULL_DATADIR@" != @* ]] && export TEXTDOMAINDIR="@CMAKE_INSTALL_FULL_DATADIR@/locale"

# shellcheck disable=SC1091
. gettext.sh


# ###### Version ############################################################
version () {
   echo "extract-pem @BUILD_MAJOR@.@BUILD_MINOR@.@BUILD_PATCH@"
   exit 0
}


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   local opt=$'\x1b[1m'
   local arg=$'\x1b[4m'
   local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   # TRANSLATORS: Command-line syntax message prefix:
   # "Usage: <program> [options]".
   cat >&2 <<EOF
${header}$(gettext "Usage:")${reset}
${cmd}${program}${reset} ${arg}pem_file${reset} ...
	${syn}[${reset}${opt}-o${reset} ${arg}file_name_prefix${reset} ${opt}|${reset} ${opt}--output-prefix${reset} ${arg}file_name_prefix${reset}${syn}]${reset}
	${syn}[${reset}${opt}-1${reset} ${opt}|${reset} ${opt}--only-first-entry${reset}${syn}]${reset}
	${syn}[${reset}${opt}-f${reset} ${opt}|${reset} ${opt}--skip-first-entry${reset}${syn}]${reset}
	${syn}[${reset}${opt}-l${reset} ${opt}|${reset} ${opt}--skip-last-entry${reset}${syn}]${reset}
	${syn}[${reset}${opt}-q${reset} ${opt}|${reset} ${opt}--quiet${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-h${reset} ${opt}|${reset} ${opt}--help${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-v${reset} ${opt}|${reset} ${opt}--version${reset}${syn}]${reset}
EOF
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
if (( BASH_VERSINFO[0] < 4 )) || (( (BASH_VERSINFO[0] == 4) && (BASH_VERSINFO[1] < 4) )) ; then
   gettext >&2 "ERROR: Bash 4.4 or higher is required!"
   echo >&2
   exit 1
fi
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]]; then
   gettext >&2 "ERROR: Enhanced/GNU getopt is required!"
   echo >&2
   exit 1
fi
options="$(${GETOPT} -o o:1flqhv --long output-prefix:,only-first-entry,skip-first-entry,skip-last-entry,quiet,help,version -a -- "$@")"
# shellcheck disable=SC2181
if [[ $? -ne 0 ]]; then
   usage "$0" 1
fi
eval set -- "${options}"

OUTPUT_PREFIX="output-"
ONLY_FIRST_ENTRY=0
SKIP_FIRST_ENTRY=0
SKIP_LAST_ENTRY=0
QUIET=0
while [ $# -gt 0 ] ; do
   case "$1" in
      -o | --output-prefix)
         OUTPUT_PREFIX="$2"
         shift
         ;;
      -1 | --only-first-entry)
         ONLY_FIRST_ENTRY=1
         ;;
      -f | --skip-first-entry)
         SKIP_FIRST_ENTRY=1
         ;;
      -l | --skip-last-entry)
         SKIP_LAST_ENTRY=1
         ;;
      -q | --quiet)
         QUIET=1
         ;;
      -h | --help)
         usage "$0" 0
         ;;
      -v | --version)
         version
         ;;
      --)
         shift
         break
         ;;
      *)
         # This should not happen: wrong getopt parameters, or missing case?
         echo >&2 "INTERNAL ERROR: Unhandled option $1!"
         exit 1
         ;;
  esac
  shift
done
if [ $# -lt 1 ] ; then
   usage "$0" 1
fi
if [ ${ONLY_FIRST_ENTRY} -eq 1 ] ; then
   if [ ${SKIP_FIRST_ENTRY} -ne 0 ] || [ ${SKIP_LAST_ENTRY} -ne 0 ] ; then
      gettext >&2 "ERROR: --only-first-entry and --skip-first-entry/--skip-last-entry are mutually exclusive!"
      echo >&2
      exit 1
   fi
fi

# ====== Extract each PEM file ==============================================
certificate=0
csr=0
crl=0
key=0
while [ $# -gt 0 ] ; do
   PEM_FILE="$1"
   shift
   if [ ! -e "${PEM_FILE}" ] ; then
      eval_gettext >&2 "ERROR: Unable to find PEM file \${PEM_FILE}!"
      echo >&2
      exit 1
   fi

   if [ ${QUIET} -eq 0 ] ; then
      echo -e "\e[34m$(eval_gettext "Extracting \${PEM_FILE} ...")\e[0m"
   fi

   lastOutputFile=""
   outputFile=""
   entry=0
   while read -r line ; do
      if [ "${outputFile}" == "" ] ; then
         if [[ "${line}" =~ ^(-----BEGIN )([^-]*)(-----) ]] ; then
            if [ "${lastOutputFile}" != "" ] ; then
               if [ ${QUIET} -eq 0 ] ; then
                  echo "=> ${lastOutputFile}"
               fi
            fi
            type="${BASH_REMATCH[2]}"
            if [ "${type}" == "CERTIFICATE" ] ; then
               certificate=$((certificate + 1))
               outputFile="${OUTPUT_PREFIX}${certificate}.crt"
            elif [ "${type}" == "CERTIFICATE REQUEST" ] ; then
               csr=$((csr + 1))
               outputFile="${OUTPUT_PREFIX}${csr}.csr"
            elif [ "${type}" == "X509 CRL" ] ; then
               crl=$((crl + 1))
               outputFile="${OUTPUT_PREFIX}${crl}.crl"
            elif [ "${type}" == "PRIVATE KEY" ] || \
                 [ "${type}" == "ENCRYPTED PRIVATE KEY" ] ; then
               key=$((key + 1))
               outputFile="${OUTPUT_PREFIX}${key}.key"
               touch "${outputFile}"
               chmod 600 "${outputFile}"
            else
               eval_gettext >&2 "ERROR: Unexpected type \${type} in \${PEM_FILE}!"
               echo >&2
               exit 1
            fi
            entry=$((entry + 1))
            echo "${line}" >>"${outputFile}.tmp"
         fi
      else
         if [[ "${line}" =~ ^(-----END )([^-]*)(-----) ]] ; then
            echo "${line}" >>"${outputFile}.tmp"
            mv "${outputFile}.tmp" "${outputFile}"
            lastOutputFile="${outputFile}"
            if [ ${entry} -eq 1 ] ; then
               if [ ${ONLY_FIRST_ENTRY} -eq 1 ] ; then
                  break
               elif [ ${SKIP_FIRST_ENTRY} -eq 1 ] ; then
                  rm "${lastOutputFile}"
                  if [ ${QUIET} -eq 0 ] ; then
                     echo "=> $(gettext "SKIPPING") ${lastOutputFile}"
                  fi
                  lastOutputFile=""
               fi
            fi
            outputFile=""
         else
            echo "${line}" >>"${outputFile}.tmp"
         fi
      fi
   done <"${PEM_FILE}"
   if [ "${lastOutputFile}" != "" ] ; then
      if [ ${SKIP_LAST_ENTRY} -eq 1 ] ; then
         rm "${lastOutputFile}"
         if [ ${QUIET} -eq 0 ] ; then
            echo "=> $(gettext "SKIPPING") ${lastOutputFile}"
         fi
      else
         if [ ${QUIET} -eq 0 ] ; then
            echo "=> ${lastOutputFile}"
         fi
      fi
   fi
done

if [ ${QUIET} -eq 0 ] ; then
   echo -e "\e[34m$(eval_gettext "Done: \${certificate} certificates, \${csr} CSRs, \${crl} CRLs, \${key} keys")\e[0m"
fi
