# ###### Bash completion for view-certificate ###############################
_view_certificate()
{
   # shellcheck disable=SC2034
   local cur prev words cword comp_args
   if type -t _comp_initialize >/dev/null ; then
      _comp_initialize -- "$@" || return
   else
      _init_completion || return
   fi

   # ====== Check previous arguments for '--' or terminal options ===========
   local i endOfOptions=0
   for (( i = 1; i < cword; i++ )) ; do
      case "${words[i]}" in
         --)
            endOfOptions=1
            break
            ;;
         -h|--help|-v|--version)
            return 0
            ;;
      esac
   done

   # ====== Complete certificate files ======================================
   if (( endOfOptions )) || [[ "${cur}" != -* ]] ; then
      if type -t _comp_compgen_filedir >/dev/null ; then
         _comp_compgen_filedir '@(cer|cert|crt|der|pem)'
      else
         _filedir '@(cer|cert|crt|der|pem)'
      fi
      return 0
   fi

   # ====== All options =====================================================
   local opts="
-
-c
--no-color
--no-colour
-h
--help
-v
--version
--
"
   mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   return 0
}

complete -F _view_certificate view-certificate
