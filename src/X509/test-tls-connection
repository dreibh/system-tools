# Bash options:
set -euo pipefail

# gettext options:
export TEXTDOMAIN="test-tls-connection"
[[ "@CMAKE_INSTALL_FULL_DATADIR@" != @* ]] && export TEXTDOMAINDIR="@CMAKE_INSTALL_FULL_DATADIR@/locale"
if command -v gettext.sh >/dev/null 2>&1 ; then
   # shellcheck disable=SC1091
   . gettext.sh
else
   gettext () { printf "%s" "$1"; }
   eval_gettext () { eval "printf '%s' \"$1\""; }
fi


# ###### Version ############################################################
version () {
   echo "test-tls-connection @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"
   exit 0
}


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   local opt=$'\x1b[1m'
   local arg=$'\x1b[4m'
   local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   local progname="${program##*/}"
   local manpage="${cmd}${progname%.*}${reset}"
   local lrm=""
   local rlm=""
   # TRANSLATORS: Text direction: LTR (Left-to-Right) or RTL (Right-to-Left)
   if [ "$(gettext "LTR")" = "RTL" ] ; then
      lrm=$'\xe2\x80\x8e'
      rlm=$'\xe2\x80\x8f'
   fi
   local homepage="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_HOMEPAGE_URL@\a@PROJECT_HOMEPAGE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   local repository="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_SOURCE_URL@\a@PROJECT_SOURCE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   local usageHeader
   # TRANSLATORS: Command-line syntax message prefix:
   # "Usage: <program> [options]".
   usageHeader="$(gettext "Usage:")"
   cat >&2 <<EOF
${header}${usageHeader}${reset}
${cmd}${program}${reset} ${arg}host:port${reset} ${arg}ca_certificate_file${reset}
	${syn}[${reset}${opt}-s${reset} ${arg}certificate_file${reset} ${syn}|${reset} ${opt}--save-certificate${reset} ${arg}certificate_file${reset}${syn}]${reset}
	${syn}[${reset}${opt}-n${reset} ${syn}|${reset} ${opt}--no-view-certificate${reset}${syn}]${reset}
	${syn}[${reset}${opt}-c${reset} ${syn}|${reset} ${opt}--no-check-certificate${reset}${syn}]${reset}
	${syn}[${reset}${opt}--${reset} ${arg}openssl_args${reset} ...${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-h${reset} ${syn}|${reset} ${opt}--help${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-v${reset} ${syn}|${reset} ${opt}--version${reset}${syn}]${reset}

EOF
   # shellcheck disable=SC2059
   # TRANSLATORS: Informational message at the end of usage:
   # 1st %s = manpage name, 2nd %s = documentation URL, 3rd %s = repository URL
   printf >&2 "$(gettext "For further information, see the man page for %s, read the documentation at %s, examine the source code at %s, or consult your favourite LLM.")\n" \
      "${manpage}" "${homepage}" "${repository}"
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
if (( BASH_VERSINFO[0] < 4 )) || (( (BASH_VERSINFO[0] == 4) && (BASH_VERSINFO[1] < 4) )) ; then
   # TRANSLATORS: Error message when Bash version is older than 4.4.
   gettext >&2 "ERROR: Bash 4.4 or higher is required!"
   echo >&2
   exit 1
fi
DIRNAME="$(dirname "$0")"
export PATH="${DIRNAME}:${PATH}"
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:/usr/local/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if [[ -z "${GETOPT}" ]] || "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]] ; then
   # TRANSLATORS: Error message when enhanced/GNU getopt is not available.
   gettext >&2 "ERROR: Enhanced/GNU getopt is required!"
   echo >&2
   exit 1
fi
if ! options="$("${GETOPT}" -o s:nchv --long save-certificate:,no-view-certificate,no-check-certificate,help,version -a -- "$@")" ; then
   usage "$0" 1
fi
eval set -- "${options}"

VIEW_CERTIFICATE=1
CHECK_CERTIFICATE=1
SAVE_CERTIFICATE_FILE=""
while [ $# -gt 0 ] ; do
   case "$1" in
      -s | --save-certificate)
         SAVE_CERTIFICATE_FILE="$2"
         shift
         ;;
      -n | --no-view-certificate)
         VIEW_CERTIFICATE=0
         ;;
      -c | --no-check-certificate)
         CHECK_CERTIFICATE=0
         ;;
      -h | --help)
         usage "$0" 0
         ;;
      -v | --version)
         version
         ;;
      --)
         shift
         break
         ;;
      *)
         # This should not happen: wrong getopt parameters, or missing case?
         echo >&2 "INTERNAL ERROR: Unhandled option $1!"
         exit 1
         ;;
   esac
   shift
done
if [ $# -lt 2 ] ; then
   usage "$0" 1
fi

ENDPOINT="$1"
if [[ "${ENDPOINT}" == \[* ]] ; then
   # Bracketed IPv6 address: [addr] or [addr]:port
   if [[ "${ENDPOINT}" == *\] ]] ; then
      ENDPOINT="${ENDPOINT}:443"
   fi
elif [[ "${ENDPOINT}" == *:*:* ]] ; then
   # Unbracketed IPv6 address without port:
   ENDPOINT="[${ENDPOINT}]:443"
elif [[ ! "${ENDPOINT}" =~ :[a-zA-Z0-9_-]+$ ]] ; then
   # Hostname or IPv4 address without port:
   ENDPOINT="${ENDPOINT}:443"
fi

CA_FILE="$2"
shift 2
if [ ! -e "${CA_FILE}" ] ; then
   # TRANSLATORS: Error message when CA certificate file cannot be found:
   # ${CA_FILE} = CA certificate file path
   eval_gettext >&2 "ERROR: Unable to find CA certificate file \${CA_FILE}!"
   echo >&2
   exit 1
fi

# ====== Check availability of tools ========================================
case "${UNAME}" in
   Darwin)
      OPENSSL="$(env PATH="/opt/homebrew/opt/openssl/bin:/usr/local/opt/openssl/bin:${PATH}" command -v openssl || true)"
      ;;
   SunOS)
      OPENSSL="$(env PATH="/usr/openssl/3/bin:${PATH}" command -v openssl || true)"
      ;;
   *)
      OPENSSL="$(command -v openssl || true)"
      ;;
esac
if [ -z "${OPENSSL}" ] ; then
   # TRANSLATORS: Error message when OpenSSL is not installed.
   gettext >&2 "ERROR: OpenSSL is not installed!"
   echo >&2
   exit 1
fi

TEXT_BLOCK="$(command -v text-block || true)"
if [ -z "${TEXT_BLOCK}" ] ; then
   # TRANSLATORS: Error message when text-block utility is not installed.
   gettext >&2 "ERROR: text-block is not installed!"
   echo >&2
   exit 1
fi

CHECK_CERT_CMD=""
VIEW_CERT_CMD=""
if [ "${CHECK_CERTIFICATE}" -eq 1 ] ; then
   CHECK_CERT_CMD="$(command -v check-certificate || true)"
   if [ -z "${CHECK_CERT_CMD}" ] ; then
      # TRANSLATORS: Error message when check-certificate utility is not installed.
      gettext >&2 "ERROR: check-certificate is not installed!"
      echo >&2
      exit 1
   fi
elif [ "${VIEW_CERTIFICATE}" -eq 1 ] ; then
   VIEW_CERT_CMD="$(command -v view-certificate || true)"
   if [ -z "${VIEW_CERT_CMD}" ] ; then
      # TRANSLATORS: Error message when view-certificate utility is not installed.
      gettext >&2 "ERROR: view-certificate is not installed!"
      echo >&2
      exit 1
   fi
fi

# ====== Connect to endpoint ================================================
# TRANSLATORS: Progress message when initiating a TLS connection:
# ${ENDPOINT} = target host:port endpoint
printf '\x1b[34m%s\x1b[0m\n' "$(eval_gettext "Connecting to \${ENDPOINT} ...")"
tempCertFile="$(mktemp -t test-tls-connection.XXXXXXXXXX)"
trap 'rm -f -- "${tempCertFile}"' EXIT INT TERM HUP

"${OPENSSL}" s_client -showcerts -connect "${ENDPOINT}" -CAfile "${CA_FILE}" "$@" </dev/null | \
   "${TEXT_BLOCK}" \
      --extract \
      --begin-tag '-----BEGIN CERTIFICATE-----' \
      --end-tag '-----END CERTIFICATE-----' \
      --full-tag-lines --include-tags --min-actions 1 \
      --input - \
      --output "${tempCertFile}"

targetCertFile="${tempCertFile}"
if [ -n "${SAVE_CERTIFICATE_FILE}" ] ; then
   if [ "${SAVE_CERTIFICATE_FILE}" = "-" ] ; then
      cat "${tempCertFile}"
   else
      cat "${tempCertFile}" > "${SAVE_CERTIFICATE_FILE}"
      targetCertFile="${SAVE_CERTIFICATE_FILE}"
   fi
fi

# ====== Display and verify certificate using check-certificate =============
if [ "${VIEW_CERTIFICATE}" -eq 1 ] && [ "${CHECK_CERTIFICATE}" -eq 1 ] ; then
   "${CHECK_CERT_CMD}" "${CA_FILE}" "${targetCertFile}"
elif [ "${VIEW_CERTIFICATE}" -eq 0 ] && [ "${CHECK_CERTIFICATE}" -eq 1 ] ; then
   "${CHECK_CERT_CMD}" "${CA_FILE}" "${targetCertFile}" --no-view-certificate
elif [ "${VIEW_CERTIFICATE}" -eq 1 ] && [ "${CHECK_CERTIFICATE}" -eq 0 ] ; then
   "${VIEW_CERT_CMD}" "${targetCertFile}"
fi
