# ###### Bash completion for der2pem ########################################
_der2pem()
{
   # shellcheck disable=SC2034
   local cur prev words cword comp_args
   if type -t _comp_initialize >/dev/null ; then
      _comp_initialize -- "$@" || return
   else
      _init_completion || return
   fi

   # ====== Check previous arguments for '--', terminal options, and position
   local i endOfOptions=0 positionalCount=0
   for (( i = 1; i < cword; i++ )) ; do
      if (( endOfOptions )) ; then
         positionalCount=$((positionalCount + 1))
         continue
      fi
      case "${words[i]}" in
         --)
            endOfOptions=1
            ;;
         -h|--help|-v|--version)
            return 0
            ;;
         -)
            positionalCount=$((positionalCount + 1))
            ;;
         -*)
            ;;
         *)
            positionalCount=$((positionalCount + 1))
            ;;
      esac
   done

   # Only 2 positional arguments (der_file and pem_file) are accepted:
   if (( positionalCount >= 2 )) ; then
      return 0
   fi

   # ====== Complete input/output files =====================================
   if (( endOfOptions )) || [[ "${cur}" != -* ]] ; then
      local pattern='@(cer|crl|csr|der)'
      if (( positionalCount == 1 )) ; then
         pattern='@(cer|cert|crl|crt|csr|pem)'
      fi
      if type -t _comp_compgen_filedir >/dev/null ; then
         _comp_compgen_filedir "${pattern}"
      else
         _filedir "${pattern}"
      fi
      return 0
   fi

   # ====== Options (or '-' for stdin/stdout) ===============================
   local opts="- --"
   if (( positionalCount == 0 )) ; then
      opts="
-
-h
--help
-v
--version
--
"
   fi
   mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   return 0
}

complete -F _der2pem der2pem
