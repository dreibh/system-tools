# Bash options:
set -euo pipefail


# ###### Version ############################################################
version () {
   echo "pem2der @BUILD_MAJOR@.@BUILD_MINOR@.@BUILD_PATCH@"
   exit 0
}


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   local opt=$'\x1b[1m'
   local arg=$'\x1b[4m'
   local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   cat >&2 <<EOF
${header}Usage:${reset}
${cmd}${program}${reset} ${arg}pem_file${reset} ${arg}der_file${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-h${reset} ${opt}|${reset} ${opt}--help${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-v${reset} ${opt}|${reset} ${opt}--version${reset}${syn}]${reset}
EOF
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
if (( BASH_VERSINFO[0] < 4 )) || (( (BASH_VERSINFO[0] == 4) && (BASH_VERSINFO[1] < 4) )) ; then
   echo >&2 "ERROR: Bash 4.4 or higher is required!"
   exit 1
fi
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]]; then
   echo >&2 "ERROR: Enhanced/GNU getopt is required!"
   exit 1
fi
options="$(${GETOPT} -o hv --long help,version -a -- "$@")"
# shellcheck disable=SC2181
if [[ $? -ne 0 ]]; then
   usage "$0" 1
fi
eval set -- "${options}"

while [ $# -gt 0 ] ; do
   case "$1" in
      -h | --help)
         usage "$0" 0
         ;;
      -v | --version)
         version
         ;;
      --)
         shift
         break
         ;;
      *)
         # This should not happen: wrong getopt parameters, or missing case?
         echo >&2 "INTERNAL ERROR: Unhandled option $1!"
         exit 1
         ;;
  esac
  shift
done
if [ $# -ne 2 ] ; then
   usage "$0" 1
fi

INPUT="$1"
if [ ! -e "${INPUT}" ] ; then
   echo >&2 "ERROR: PEM file ${INPUT} does not exist!"
   exit 1
fi
OUTPUT="$2"

TYPE="x509"
# Check whether type is CRL, by extension or using "file":
if [[ "$(basename "${INPUT}")" =~ \.[Cc][Rr][Ll]$ ]] ; then
   TYPE="crl"
elif grep -q "BEGIN X509 CRL" "${INPUT}" ; then
   TYPE="crl"
fi

# ====== Convert PEM to DER =================================================
openssl "${TYPE}" \
   -inform pem -in "${INPUT}" \
   -outform der -out "${OUTPUT}"
