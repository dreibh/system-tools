# Bash options:
set -euo pipefail

# gettext options:
export TEXTDOMAIN="view-certificate"
[[ "@CMAKE_INSTALL_FULL_DATADIR@" != @* ]] && export TEXTDOMAINDIR="@CMAKE_INSTALL_FULL_DATADIR@/locale"

# shellcheck disable=SC1091
. gettext.sh


# ###### Print date in current locale and current time zone #################
print-date ()
{
   local inputDateTime="$1"
   local unixTimestamp
   unixTimestamp="$(LC_ALL=C time2unixts -T "%b %d %T %Y %Z" "${inputDateTime}")"
   unixts2time -T "%c %Z" "${unixTimestamp}"
}


# ###### Version ############################################################
version () {
   echo "view-certificate @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"
   exit 0
}


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   local opt=$'\x1b[1m'
   local arg=$'\x1b[4m'
   local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   # TRANSLATORS: Command-line syntax message prefix:
   # "Usage: <program> [options]".
   cat >&2 <<EOF
${header}$(gettext "Usage:")${reset}
${cmd}${program}${reset} ${arg}certificate_file${reset} ...
${cmd}${program}${reset}
	${syn}[${reset}${opt}-h${reset} ${opt}|${reset} ${opt}--help${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-v${reset} ${opt}|${reset} ${opt}--version${reset}${syn}]${reset}
EOF
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
if (( BASH_VERSINFO[0] < 4 )) || (( (BASH_VERSINFO[0] == 4) && (BASH_VERSINFO[1] < 4) )) ; then
   gettext >&2 "ERROR: Bash 4.4 or higher is required!"
   echo >&2
   exit 1
fi
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]]; then
   gettext >&2 "ERROR: Enhanced/GNU getopt is required!"
   echo >&2
   exit 1
fi
options="$(${GETOPT} -o hv --long help,version -a -- "$@")"
# shellcheck disable=SC2181
if [[ $? -ne 0 ]]; then
   usage "$0" 1
fi
eval set -- "${options}"

while [ $# -gt 0 ] ; do
   case "$1" in
      -h | --help)
         usage "$0" 0
         ;;
      -v | --version)
         version
         ;;
      --)
         shift
         break
         ;;
      *)
         # This should not happen: wrong getopt parameters, or missing case?
         echo >&2 "INTERNAL ERROR: Unhandled option $1!"
         exit 1
         ;;
  esac
  shift
done
if [ $# -lt 1 ] ; then
   usage "$0" 1
fi

# ====== Check availability of tools ========================================
case "${UNAME}" in
   Darwin)
      OPENSSL="$(env PATH="/opt/homebrew/opt/openssl/bin:${PATH}" command -v openssl || true)"
      ;;
   SunOS)
      OPENSSL="$(env PATH="/usr/openssl/3/bin:${PATH}" command -v openssl || true)"
      ;;
   *)
      OPENSSL="$(command -v openssl || true)"
      ;;
esac
if [ "${OPENSSL}" == "" ] ; then
   gettext >&2 "ERROR: OpenSSL is not installed!"
   echo >&2
   exit 1
fi

# ====== Prepare labels and compute indentation =============================
declare -A labels=(
   ["Subject"]="$(gettext "Subject:")"
   ["Subject Alternative Name"]="$(gettext "Subject Alternative Name:")"
   ["Public Key Algorithm"]="$(gettext "Public Key Algorithm:")"
   ["Signature Algorithm"]="$(gettext "Signature Algorithm:")"
   ["Validity"]="$(gettext "Validity:")"
   ["Basic Constraints"]="$(gettext "Basic Constraints:")"
   ["Key Usage"]="$(gettext "Key Usage:")"
   ["Extended Key Usage"]="$(gettext "Extended Key Usage:")"
   ["Subject Key Identifier"]="$(gettext "Subject Key Identifier:")"
   ["Authority Key Identifier"]="$(gettext "Authority Key Identifier:")"
)

indent=0
for label in "${labels[@]}" ; do
   width="$(print-utf8 --width "${label}")"
   width="${width//[$'\r\n']/}"
   if [ "${width}" -gt "${indent}" ] ; then
      indent="${width}"
   fi
done
indent=-$((indent + 2))

# ====== Show each certificate ==============================================
while [ $# -gt 0 ] ; do

   # ====== Look for certificate ============================================
   CERTIFICATE_FILE="$1"
   shift
   tempCertFile=""
   tempPemFile=""
   trap 'rm -f "${tempCertFile}" "${tempPemFile}"' EXIT INT TERM HUP

   displayCertificateFile="${CERTIFICATE_FILE}"
   if [ "${CERTIFICATE_FILE}" == "-" ] ; then
      displayCertificateFile="/dev/stdin"
      tempCertFile="$(mktemp -t view-certificate.XXXXXXXXXX)"
      cat >"${tempCertFile}"
      CERTIFICATE_FILE="${tempCertFile}"
   fi

   if [ ! -e "${CERTIFICATE_FILE}" ] ; then
      eval_gettext >&2 "ERROR: Unable to find certificate file \${CERTIFICATE_FILE}!"
      echo >&2
      exit 1
   fi

   # If not valid PEM, convert DER to temporary PEM representation for OpenSSL/LibreSSL
   if ! "${OPENSSL}" x509 -in "${CERTIFICATE_FILE}" -inform PEM -noout >/dev/null 2>&1 ; then
      tempPemFile="$(mktemp -t view-certificate-pem.XXXXXXXXXX)"
      if "${OPENSSL}" x509 -in "${CERTIFICATE_FILE}" -inform DER -outform PEM -out "${tempPemFile}" 2>/dev/null ; then
         CERTIFICATE_FILE="${tempPemFile}"
      fi
   fi

   echo -e "\e[34m$(eval_gettext "Certificate in \${displayCertificateFile}:")\e[0m"
   "${OPENSSL}" x509 -in "${CERTIFICATE_FILE}" -noout -text | (
      # ====== Extract certificate details ==================================
      validityFrom="?"
      validityTo="?"
      subject="?"
      publicKeyAlgorithm="?"
      signatureAlgorithm="?"
      declare -A extensionValues=(
         ["Subject Alternative Name"]="(none)"
         ["Key Usage"]="(none)"
         ["Basic Constraints"]="(none)"
         ["Extended Key Usage"]="(none)"
         ["Subject Key Identifier"]="(none)"
         ["Authority Key Identifier"]="(none)"
      )
      extension=""
      while read -r line ; do
         if [[ "${line}" =~ ^[[:space:]]*Subject:[[:space:]]*(.*)$ ]] ; then
            # Subject with underlined CN:
            # shellcheck disable=SC2001
            subject="$(sed -e 's|\(CN = [^,]*\)|\x1b[4m\1\x1b[24m|' <<< "${BASH_REMATCH[1]}")"
            extension=""

         elif [[ "${line}" =~ ^[[:space:]]*Not[[:space:]]Before:[[:space:]]*(.*)$ ]] ; then
            validityFrom="$(print-date "${BASH_REMATCH[1]}")"
            extension=""
         elif [[ "${line}" =~ ^[[:space:]]*Not[[:space:]]After[[:space:]]*:[[:space:]]*(.*)$ ]] ; then
            validityTo="$(print-date "${BASH_REMATCH[1]}")"
            extension=""

         elif [[ "${line}" =~ ^[[:space:]]*Public[[:space:]]Key[[:space:]]Algorithm:[[:space:]]*(.*)$ ]] ; then
            publicKeyAlgorithm="${BASH_REMATCH[1]}"
            extension=""
         elif [[ "${line}" =~ ^[[:space:]]*Signature[[:space:]]Algorithm:[[:space:]]*(.*)$ ]] ; then
            if [ "${signatureAlgorithm}" == "?" ] ; then
               signatureAlgorithm="${BASH_REMATCH[1]}"
            fi
            extension=""

         elif [[ "${line}" =~ ^([ \t]*)(X509v3 )(.*)(:[[:space:]]*)(.*)$ ]] ; then
            extension="${BASH_REMATCH[3]}"
            critical="${BASH_REMATCH[5]}"
            if [ "${critical}" != "" ] ; then
               extensionValues["${extension}"]="\\e[4m${critical}:\\e[24m "
            else
               extensionValues["${extension}"]=""
            fi
         elif [ "${extension}" != "" ] && [[ "${line}" =~ ^([[:space:]]*)(.*)$ ]] ; then
            extensionValues["${extension}"]+="${BASH_REMATCH[2]}"
            extension=""
         fi
      done

      # ====== Display certificate details ==================================
      print-utf8 -i "${indent}" "\e[33m${labels["Subject"]}"
      echo -e "\e[35m${subject}\e[0m"
      print-utf8 -i "${indent}" "\e[33m${labels["Subject Alternative Name"]}"
      echo -e "\e[35m${extensionValues["Subject Alternative Name"]}\e[0m"
      print-utf8 -i "${indent}" "\e[33m${labels["Validity"]}"
      echo -e "\e[36m${validityFrom}\e[33m — \e[36m${validityTo}\e[0m"
      print-utf8 -i "${indent}" "\e[33m${labels["Public Key Algorithm"]}"
      echo -e "\e[36m${publicKeyAlgorithm}\e[0m"

      print-utf8 -i "${indent}" "\e[33m${labels["Signature Algorithm"]}"
      echo -e "\e[36m${signatureAlgorithm}\e[0m"
      for extension in "Basic Constraints"      \
                       "Key Usage"              \
                       "Extended Key Usage"     \
                       "Subject Key Identifier" \
                       "Authority Key Identifier" ; do
         print-utf8 -i "${indent}" "\e[33m${labels["${extension}"]}"
         echo -e "${extensionValues["${extension}"]}\e[0m"
      done
   )
   echo -en "\e[0m"

   # ====== Display certificate hierarchy ===================================
   echo -e "\e[34m$(eval_gettext "Hierarchy in \${displayCertificateFile}:")\e[0m"
   "${OPENSSL}" crl2pkcs7 -nocrl -certfile "${CERTIFICATE_FILE}" 2>/dev/null | \
      "${OPENSSL}" pkcs7 -print_certs -noout | (
         entry=0
         while read -r line ; do
            if [[ "${line}" =~ ^(subject=)(.*)$ ]] ; then
               # Subject with underlined CN:
               # shellcheck disable=SC2001
               subject="$(sed -e 's|\(CN = [^,]*\)|\x1b[4m\1\x1b[24m|' <<< "${BASH_REMATCH[2]}")"

               entry=$((entry + 1))
               echo -en " \x1b[33m$(eval_gettext "#\${entry}.") "
               if [ ${entry} -eq 1 ] ; then
                  echo -e "\e[35m${subject}\e[0m"
               else
                  echo -e "\e[37m${subject}\e[0m"
               fi
            fi
         done
      )

   rm -f "${tempCertFile}" "${tempPemFile}"
done
