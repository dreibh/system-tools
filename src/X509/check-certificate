# Bash options:
set -euo pipefail

# gettext options:
export TEXTDOMAIN="check-certificate"
[[ "@CMAKE_INSTALL_FULL_DATADIR@" != @* ]] && export TEXTDOMAINDIR="@CMAKE_INSTALL_FULL_DATADIR@/locale"
if command -v gettext.sh >/dev/null 2>&1 ; then
   # shellcheck disable=SC1091
   . gettext.sh
else
   gettext () { printf "%s" "$1"; }
   eval_gettext () { eval "printf '%s' \"$1\""; }
fi


# ###### Version ############################################################
version () {
   echo "check-certificate @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"
   exit 0
}


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   local opt=$'\x1b[1m'
   local arg=$'\x1b[4m'
   local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   local progname="${program##*/}"
   local manpage="${cmd}${progname%.*}${reset}"
   local lrm=""
   local rlm=""
   # TRANSLATORS: Text direction: LTR (Left-to-Right) or RTL (Right-to-Left)
   if [ "$(gettext "LTR")" = "RTL" ] ; then
      lrm=$'\xe2\x80\x8e'
      rlm=$'\xe2\x80\x8f'
   fi
   local homepage="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_HOMEPAGE_URL@\a@PROJECT_HOMEPAGE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   local repository="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_SOURCE_URL@\a@PROJECT_SOURCE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   local usageHeader
   # TRANSLATORS: Command-line syntax message prefix:
   # "Usage: <program> [options]".
   usageHeader="$(gettext "Usage:")"
   cat >&2 <<EOF
${header}${usageHeader}${reset}
${cmd}${program}${reset} ${arg}ca_certificate_file${reset} ${arg}certificate_file${reset} ...
	${syn}[${reset}${opt}-C${reset} ${arg}crl_file${reset} ${syn}|${reset} ${opt}--crl${reset} ${arg}crl_file${reset}${syn}]${reset}
	${syn}[${reset}${opt}-n${reset} ${syn}|${reset} ${opt}--no-view-certificate${reset}${syn}]${reset}
	${syn}[${reset}${opt}-c${reset} ${syn}|${reset} ${opt}--no-color${reset} ${syn}|${reset} ${opt}--no-colour${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-h${reset} ${syn}|${reset} ${opt}--help${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-v${reset} ${syn}|${reset} ${opt}--version${reset}${syn}]${reset}

EOF
   # shellcheck disable=SC2059
   # TRANSLATORS: Informational message at the end of usage:
   # 1st %s = manpage name, 2nd %s = documentation URL, 3rd %s = repository URL
   printf >&2 "$(gettext "For further information, see the man page for %s, read the documentation at %s, examine the source code at %s, or consult your favourite LLM.")\n" \
      "${manpage}" "${homepage}" "${repository}"
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------


# ###### Clean up temporary files and directories on exit or signal #########
tempCaPem=""
tempCrlPem=""
tempCertPem=""
tempSolarisChain=""
nssDb=""
cleanup () {
   rm -f -- "${tempCaPem}" "${tempCrlPem}" "${tempCertPem}" "${tempSolarisChain}"
   if [ -n "${nssDb}" ] ; then
      rm -rf -- "${nssDb}"
   fi
}
trap cleanup EXIT INT TERM HUP


# ###### Print horizontal diagnostic separator ##############################
print_separator_header () {
   local title="$1"
   if [ -n "${PRINT_UTF8_CMD}" ] ; then
      "${PRINT_UTF8_CMD}" --separator "${COLOR_RED_BOLD}══════ ${title} " "═" "═${COLOR_NORMAL_INTENSITY}"
   else
      printf '%s══════ %s ══════════════════════════════════════════════════════════════%s\n' \
         "${COLOR_RED_BOLD}" "${title}" "${COLOR_NORMAL_INTENSITY}"
   fi
}

print_separator_footer () {
   if [ -n "${PRINT_UTF8_CMD}" ] ; then
      "${PRINT_UTF8_CMD}" --separator "${COLOR_RED_BOLD}═" "═" "═${COLOR_RESET}"
   else
      printf '%s════════════════════════════════════════════════════════════════════════════%s\n' \
         "${COLOR_RED_BOLD}" "${COLOR_RESET}"
   fi
}


# ###### Ensure a certificate or CRL file is in PEM format ##################
prepare_pem_file () {
   local inputPath="$1"
   local objectType="$2"   # "x509" or "crl"
   local __outVar="$3"

   if grep -q -- "-----BEGIN " "${inputPath}" 2>/dev/null ; then
      printf -v "${__outVar}" '%s' "${inputPath}"
      return 0
   fi

   local convertedTmp
   convertedTmp="$(mktemp -t "check-certificate-${objectType}.XXXXXXXXXX")"
   if "${OPENSSL}" "${objectType}" -inform DER -in "${inputPath}" -outform PEM -out "${convertedTmp}" 2>/dev/null ; then
      printf -v "${__outVar}" '%s' "${convertedTmp}"
      return 0
   fi

   rm -f -- "${convertedTmp}"
   # Keep original path so downstream tools report their native parse diagnostics:
   printf -v "${__outVar}" '%s' "${inputPath}"
   return 0
}



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
if (( BASH_VERSINFO[0] < 4 )) || (( (BASH_VERSINFO[0] == 4) && (BASH_VERSINFO[1] < 4) )) ; then
   # TRANSLATORS: Error message when Bash version is older than 4.4.
   gettext >&2 "ERROR: Bash 4.4 or higher is required!"
   echo >&2
   exit 1
fi
DIRNAME="$(dirname "$0")"
export PATH="${DIRNAME}:${PATH}"
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:/usr/local/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if [[ -z "${GETOPT}" ]] || "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]] ; then
   # TRANSLATORS: Error message when enhanced/GNU getopt is not available.
   gettext >&2 "ERROR: Enhanced/GNU getopt is required!"
   echo >&2
   exit 1
fi
if ! options="$("${GETOPT}" -o C:nchv --long crl:,no-view-certificate,no-color,no-colour,help,version -a -- "$@")" ; then
   usage "$0" 1
fi
eval set -- "${options}"

CRL=""
VIEW_CERTIFICATE=1
USE_COLOR=1
COLOR_BLUE=$'\x1b[34m'
COLOR_YELLOW=$'\x1b[33m'
COLOR_GREEN=$'\x1b[32m'
COLOR_GREEN_BOLD=$'\x1b[32;1m'
COLOR_CYAN=$'\x1b[36m'
COLOR_RED_BOLD=$'\x1b[31;1m'
COLOR_BANNER_FAIL=$'\x1b[37;41;1m'
COLOR_NORMAL_INTENSITY=$'\x1b[22m'
COLOR_RESET=$'\x1b[0m'

while [ $# -gt 0 ] ; do
   case "$1" in
      -C | --crl)
         CRL="$2"
         shift
         ;;
      -n | --no-view-certificate)
         VIEW_CERTIFICATE=0
         ;;
      -c | --no-color | --no-colour)
         USE_COLOR=0
         COLOR_BLUE=""
         COLOR_YELLOW=""
         COLOR_GREEN=""
         COLOR_GREEN_BOLD=""
         COLOR_CYAN=""
         COLOR_RED_BOLD=""
         COLOR_BANNER_FAIL=""
         COLOR_NORMAL_INTENSITY=""
         COLOR_RESET=""
         ;;
      -h | --help)
         usage "$0" 0
         ;;
      -v | --version)
         version
         ;;
      --)
         shift
         break
         ;;
      *)
         # This should not happen: wrong getopt parameters, or missing case?
         echo >&2 "INTERNAL ERROR: Unhandled option $1!"
         exit 1
         ;;
   esac
   shift
done
if [ $# -lt 2 ] ; then
   usage "$0" 1
fi
CA_FILE="$1"
shift

# ====== Check availability of tools ========================================
case "${UNAME}" in
   Darwin)
      OPENSSL="$(env PATH="/opt/homebrew/opt/openssl/bin:/usr/local/opt/openssl/bin:${PATH}" command -v openssl || true)"
      CERTTOOL="$(env PATH="/opt/homebrew/opt/gnutls/bin:/opt/homebrew/bin:/usr/local/opt/gnutls/bin:/usr/local/bin:/opt/local/bin:${PATH}" command -v gnutls-certtool || true)"
      CERTUTIL="$(env PATH="/opt/homebrew/opt/nss/bin:/usr/local/opt/nss/bin:${PATH}" command -v certutil || true)"
      CRLUTIL="$(env PATH="/opt/homebrew/opt/nss/bin:/usr/local/opt/nss/bin:${PATH}" command -v crlutil || true)"
      ;;
   SunOS)
      OPENSSL="$(env PATH="/usr/openssl/3/bin:${PATH}" command -v openssl || true)"
      CERTTOOL="$(env PATH="/usr/gnu/bin:${PATH}" command -v certtool || true)"
      CERTUTIL="$(command -v certutil || true)"
      CRLUTIL="$(command -v crlutil || true)"
      ;;
   *)
      OPENSSL="$(command -v openssl || true)"
      CERTTOOL="$(command -v certtool || true)"
      CERTUTIL="$(command -v certutil || true)"
      CRLUTIL="$(command -v crlutil || true)"
      ;;
esac
if [ -z "${OPENSSL}" ] ; then
   # TRANSLATORS: Error message when OpenSSL is not installed.
   gettext >&2 "ERROR: OpenSSL is not installed!"
   echo >&2
   exit 1
fi

VIEW_CERT_CMD=""
if [ "${VIEW_CERTIFICATE}" -eq 1 ] ; then
   VIEW_CERT_CMD="$(command -v view-certificate || true)"
   if [ -z "${VIEW_CERT_CMD}" ] ; then
      # TRANSLATORS: Error message when view-certificate utility is not installed.
      gettext >&2 "ERROR: view-certificate is not installed!"
      echo >&2
      exit 1
   fi
fi

EXTRACT_PEM_CMD="$(command -v extract-pem || true)"
if [ -n "${CERTUTIL}" ] && [ -n "${CRLUTIL}" ] && [ -z "${EXTRACT_PEM_CMD}" ] ; then
   # TRANSLATORS: Error message when extract-pem utility is not installed.
   gettext >&2 "ERROR: extract-pem is not installed!"
   echo >&2
   exit 1
fi

PRINT_UTF8_CMD="$(command -v print-utf8 || true)"

# Detect supported OpenSSL trust-store isolation flags once:
opensslVerifyHelp="$("${OPENSSL}" verify -help 2>&1 || true)"
opensslIsolationArgs=()
for flag in -no-CApath -no-CAstore -no-CAfile ; do
   if grep -q -- "${flag}" <<< "${opensslVerifyHelp}" ; then
      opensslIsolationArgs+=( "${flag}" )
   fi
done

# ====== Look for CA certificate ============================================
if [ ! -e "${CA_FILE}" ] ; then
   # TRANSLATORS: Error message when CA certificate file cannot be found:
   # ${CA_FILE} = CA certificate file path
   eval_gettext >&2 "ERROR: Unable to find CA certificate file \${CA_FILE}!"
   echo >&2
   exit 1
fi
workCaFile=""
prepare_pem_file "${CA_FILE}" "x509" workCaFile
if [ "${workCaFile}" != "${CA_FILE}" ] ; then
   tempCaPem="${workCaFile}"
fi

# ====== Look for CRL =======================================================
workCrlFile=""
if [ -n "${CRL}" ] ; then
   if [ ! -e "${CRL}" ] ; then
      # TRANSLATORS: Error message when CRL file cannot be found:
      # ${CRL} = CRL file path
      eval_gettext >&2 "ERROR: Unable to find CRL file \${CRL}!"
      echo >&2
      exit 1
   fi
   prepare_pem_file "${CRL}" "crl" workCrlFile
   if [ "${workCrlFile}" != "${CRL}" ] ; then
      tempCrlPem="${workCrlFile}"
   fi
fi


# ====== Check each certificate =============================================
errors=0
stdinConsumed=0
while [ $# -gt 0 ] ; do

   # ====== Look for certificate ============================================
   CERTIFICATE_FILE="$1"
   shift
   rm -f -- "${tempCertPem}"
   tempCertPem=""

   if [ "${CERTIFICATE_FILE}" = "-" ] ; then
      if [ "${stdinConsumed}" -ne 0 ] ; then
         # TRANSLATORS: Error message when '-' (standard input) is passed more than once.
         gettext >&2 "ERROR: Standard input (-) can only be read once!"
         echo >&2
         exit 1
      fi
      stdinConsumed=1
      CERTIFICATE_FILE="/dev/stdin"
      tempStdinRaw="$(mktemp -t check-certificate-stdin.XXXXXXXXXX)"
      cat > "${tempStdinRaw}"
      prepare_pem_file "${tempStdinRaw}" "x509" workCertFile
      if [ "${workCertFile}" != "${tempStdinRaw}" ] ; then
         rm -f -- "${tempStdinRaw}"
      fi
      tempCertPem="${workCertFile}"
   else
      if [ ! -e "${CERTIFICATE_FILE}" ] ; then
         # TRANSLATORS: Error message when certificate file cannot be found:
         # ${CERTIFICATE_FILE} = certificate file path
         eval_gettext >&2 "ERROR: Unable to find certificate file \${CERTIFICATE_FILE}!"
         echo >&2
         exit 1
      fi
      prepare_pem_file "${CERTIFICATE_FILE}" "x509" workCertFile
      if [ "${workCertFile}" != "${CERTIFICATE_FILE}" ] ; then
         tempCertPem="${workCertFile}"
      fi
   fi

   # ====== Display certificate and hierarchy ===============================
   if [ "${VIEW_CERTIFICATE}" -eq 1 ] ; then
      viewArgs=()
      if [ "${USE_COLOR}" -eq 0 ] ; then
         viewArgs+=( --no-color )
      fi
      if [ "${CERTIFICATE_FILE}" = "/dev/stdin" ] ; then
         "${VIEW_CERT_CMD}" "${viewArgs[@]}" - < "${workCertFile}"
      else
         "${VIEW_CERT_CMD}" "${viewArgs[@]}" "${CERTIFICATE_FILE}"
      fi
   fi


   # ====== Verify certificate with CA certificate ==========================
   # TRANSLATORS: Status header when starting verification of a certificate against a CA:
   # ${CERTIFICATE_FILE} = certificate file path, ${CA_FILE} = CA certificate file path
   printf '%s%s%s\n' "${COLOR_BLUE}" "$(eval_gettext "Verifying \${CERTIFICATE_FILE} with CA \${CA_FILE} ...")" "${COLOR_RESET}"
   if [ "${CA_FILE}" = "${CERTIFICATE_FILE}" ] ; then
      # TRANSLATORS: Warning printed when the certificate file and CA file are identical.
      gettext >&2 "WARNING: Only checking self-signature!"
      echo >&2
   fi

   # ====== OpenSSL =========================================================
   printf '%sOpenSSL:%s ' "${COLOR_YELLOW}" "${COLOR_RESET}"
   if [ -n "${OPENSSL}" ] ; then
      opensslCmd=( "${OPENSSL}" verify "${opensslIsolationArgs[@]}" -CAfile "${workCaFile}" )
      if [ -n "${workCrlFile}" ] ; then
         opensslCmd+=( -crl_check -CRLfile "${workCrlFile}" )
      fi
      opensslCmd+=( -untrusted "${workCertFile}" "${workCertFile}" )

      if "${opensslCmd[@]}" >/dev/null 2>&1 ; then
         # TRANSLATORS: Verification status indicator for a passed check.
         printf '%s%s%s\n' "${COLOR_GREEN_BOLD}" "$(gettext "✓OKAY")" "${COLOR_RESET}"
      else
         errors=$((errors + 1))
         # TRANSLATORS: Verification status indicator for a failed check.
         printf '%s%s%s\n' "${COLOR_RED_BOLD}" "$(gettext "❌FAILED!")" "${COLOR_RESET}"
         print_separator_header "OpenSSL"
         "${opensslCmd[@]}" || true
         print_separator_footer
      fi
   else
      # TRANSLATORS: Informational notice when OpenSSL is not installed on the system.
      gettext "(OpenSSL is not installed)"
      echo
   fi


   # ====== GnuTLS ==========================================================
   printf '%sGnuTLS:%s  ' "${COLOR_YELLOW}" "${COLOR_RESET}"
   if [ -n "${CERTTOOL}" ] ; then
      if [ "${UNAME}" = "SunOS" ] ; then
         tempSolarisChain="$(mktemp -t check-certificate.XXXXXXXXXX)"
         {
            cat "${workCertFile}"
            echo ""
            cat "${workCaFile}"
         } > "${tempSolarisChain}"
      fi

      good=0
      for profile in low medium high ultra future ; do
         if [ "${UNAME}" != "SunOS" ] ; then
            gnutlsCmd=( "${CERTTOOL}" --verify "--verify-profile=${profile}" "--load-ca-certificate=${workCaFile}" )
            if [ -n "${workCrlFile}" ] ; then
               gnutlsCmd+=( "--load-crl=${workCrlFile}" )
            fi
            gnutlsCmd+=( "--infile=${workCertFile}" )
         else
            # GnuTLS Solaris issue work-around:
            # https://gitlab.com/gnutls/gnutls/-/work_items/1916
            gnutlsCmd=( "${CERTTOOL}" --verify-chain "--verify-profile=${profile}" )
            if [ -n "${workCrlFile}" ] ; then
               gnutlsCmd+=( "--load-crl=${workCrlFile}" )
            fi
            gnutlsCmd+=( "--infile=${tempSolarisChain}" )
         fi

         if "${gnutlsCmd[@]}" >/dev/null 2>&1 ; then
            good=$((good + 1))
            if [ "${good}" -eq 1 ] ; then
               # TRANSLATORS: Verification status indicator for a passed check.
               printf '%s%s%s' "${COLOR_GREEN_BOLD}" "$(gettext "✓OKAY")" "${COLOR_RESET}"
            fi
            printf '   %s%s%s' "${COLOR_GREEN}" "${profile}" "${COLOR_RESET}"
         fi
      done

      if [ "${good}" -eq 0 ] ; then
         errors=$((errors + 1))
         # TRANSLATORS: Verification status indicator for a failed check.
         printf '%s%s%s\n' "${COLOR_RED_BOLD}" "$(gettext "❌FAILED!")" "${COLOR_RESET}"
         print_separator_header "GnuTLS"
         # Re-run with 'low' profile so key-size limits from 'future' do not mask root causes:
         if [ "${UNAME}" != "SunOS" ] ; then
            gnutlsDiagCmd=( "${CERTTOOL}" --verify "--verify-profile=low" "--load-ca-certificate=${workCaFile}" )
            if [ -n "${workCrlFile}" ] ; then
               gnutlsDiagCmd+=( "--load-crl=${workCrlFile}" )
            fi
            gnutlsDiagCmd+=( "--infile=${workCertFile}" )
         else
            gnutlsDiagCmd=( "${CERTTOOL}" --verify-chain "--verify-profile=low" )
            if [ -n "${workCrlFile}" ] ; then
               gnutlsDiagCmd+=( "--load-crl=${workCrlFile}" )
            fi
            gnutlsDiagCmd+=( "--infile=${tempSolarisChain}" )
         fi
         "${gnutlsDiagCmd[@]}" || true
         print_separator_footer
      else
         echo
      fi

      if [ -n "${tempSolarisChain}" ] ; then
         rm -f -- "${tempSolarisChain}"
         tempSolarisChain=""
      fi
   else
      # TRANSLATORS: Informational notice when GnuTLS CertTool is not installed on the system.
      gettext "(GnuTLS CertTool is not installed)"
      echo
   fi


   # ====== NSS =============================================================
   printf '%sNSS:    %s ' "${COLOR_YELLOW}" "${COLOR_RESET}"
   if [ -n "${CERTUTIL}" ] && [ -n "${CRLUTIL}" ] ; then

      # NOTE:
      # NSS does not support importing a certificate with CAs bundled! It is
      # necessary to extract each CA, and then process them individually!

      # ------ Create temporary directory for database ----------------------
      nssDb="$(mktemp -d -t "check-certificate-nss.XXXXXXXXXX")"
      mkdir -p "${nssDb}/tmp"
      nssImportError=""
      nssSetupOk=1

      if ! nssImportError="$("${CERTUTIL}" --empty-password -N -d "${nssDb}" 2>&1)" ; then
         nssSetupOk=0
      fi

      # ------ Extract leaf + chained sub-CAs and Root CAs ------------------
      if [ "${nssSetupOk}" -eq 1 ] ; then
         if ! nssImportError="$("${EXTRACT_PEM_CMD}" "${workCertFile}" --quiet --output-prefix "${nssDb}/tmp/certificate-" 2>&1)" || \
            [ ! -e "${nssDb}/tmp/certificate-1.crt" ] ; then
            nssSetupOk=0
         fi
      fi
      if [ "${nssSetupOk}" -eq 1 ] ; then
         if ! nssImportError="$("${EXTRACT_PEM_CMD}" "${workCaFile}" --quiet --output-prefix "${nssDb}/tmp/ca-" 2>&1)" || \
            [ ! -e "${nssDb}/tmp/ca-1.crt" ] ; then
            nssSetupOk=0
         fi
      fi

      # Import leaf certificate first so its nickname is "My Certificate"
      # even when CA_FILE == CERTIFICATE_FILE:
      if [ "${nssSetupOk}" -eq 1 ] ; then
         if ! nssImportError="$("${CERTUTIL}" -A -n "My Certificate" -t ",," -e -d "${nssDb}" -a -i "${nssDb}/tmp/certificate-1.crt" 2>&1)" ; then
            nssSetupOk=0
         fi
      fi

      # ------ Import all CAs from CA_FILE as trusted -----------------------
      caCount=0
      if [ "${nssSetupOk}" -eq 1 ] ; then
         while [ -e "${nssDb}/tmp/ca-$((caCount + 1)).crt" ] ; do
            caCount=$((caCount + 1))
            if ! nssImportError="$("${CERTUTIL}" -A -n "Root CA ${caCount}" -t "CT,C,C" -e -d "${nssDb}" -a -i "${nssDb}/tmp/ca-${caCount}.crt" -u L 2>&1)" ; then
               nssSetupOk=0
               break
            fi
         done
      fi

      # ------ Import chained sub-CAs in reverse numeric order --------------
      if [ "${nssSetupOk}" -eq 1 ] ; then
         totalCerts=0
         while [ -e "${nssDb}/tmp/certificate-$((totalCerts + 1)).crt" ] ; do
            totalCerts=$((totalCerts + 1))
         done
         subCA=0
         for (( idx = totalCerts; idx >= 2; idx-- )) ; do
            subCA=$((subCA + 1))
            if ! nssImportError="$("${CERTUTIL}" -A -n "My Sub CA ${subCA}" -t ",," -e -d "${nssDb}" -a -i "${nssDb}/tmp/certificate-${idx}.crt" -u L 2>&1)" ; then
               nssSetupOk=0
               break
            fi
         done
      fi

      # Re-apply Root CA trust in case a duplicate root was imported above:
      if [ "${nssSetupOk}" -eq 1 ] ; then
         for (( idx = 1; idx <= caCount; idx++ )) ; do
            if ! nssImportError="$("${CERTUTIL}" -A -n "Root CA ${idx}" -t "CT,C,C" -d "${nssDb}" -a -i "${nssDb}/tmp/ca-${idx}.crt" 2>&1)" ; then
               nssSetupOk=0
               break
            fi
         done
      fi

      # ------ Extract CRL file and process each CRL individually -----------
      if [ "${nssSetupOk}" -eq 1 ] && [ -n "${workCrlFile}" ] ; then
         if ! nssImportError="$("${EXTRACT_PEM_CMD}" "${workCrlFile}" --quiet --output-prefix "${nssDb}/tmp/crl-" 2>&1)" ; then
            nssSetupOk=0
         else
            # NSS crlutil imports binary DER CRLs (without -a):
            crlCount=0
            while [ -e "${nssDb}/tmp/crl-$((crlCount + 1)).crl" ] ; do
               crlCount=$((crlCount + 1))
               crlPem="${nssDb}/tmp/crl-${crlCount}.crl"
               if ! nssImportError="$("${OPENSSL}" crl -outform DER -in "${crlPem}" -out "${crlPem}.der" 2>&1)" ; then
                  nssSetupOk=0
                  break
               fi
               # NOTE: This may fail if this is a CRL for an unrelated CA:
               # "crlutil: unable to import CRL: SEC_ERROR_UNKNOWN_ISSUER: Peer's Certificate issuer is not recognized."
               "${CRLUTIL}" -I -d "${nssDb}" -i "${crlPem}.der" 2>/dev/null || true
            done
         fi
      fi

      # ------ Finally, verify the validity chain ---------------------------
      declare -A certUsageLabels=(
         ["V"]="server"
         ["C"]="client"
         ["L"]="CA"
         ["S"]="email_signer"
         ["R"]="email_recipient"
      )
      good=0
      if [ "${nssSetupOk}" -eq 1 ] ; then
         for certUsage in V C L S R ; do
            nssCmd=( "${CERTUTIL}" -V -e -u "${certUsage}" -n "My Certificate" -d "${nssDb}" )
            if "${nssCmd[@]}" >/dev/null 2>&1 ; then
               good=$((good + 1))
               if [ "${good}" -eq 1 ] ; then
                  # TRANSLATORS: Verification status indicator for a passed check.
                  printf '%s%s%s' "${COLOR_GREEN_BOLD}" "$(gettext "✓OKAY")" "${COLOR_RESET}"
               fi
               printf '   %s%s%s' "${COLOR_CYAN}" "${certUsageLabels["${certUsage}"]}" "${COLOR_RESET}"
            fi
         done
      fi

      if [ "${good}" -eq 0 ] ; then
         errors=$((errors + 1))
         # TRANSLATORS: Verification status indicator for a failed check.
         printf '%s%s%s\n' "${COLOR_RED_BOLD}" "$(gettext "❌FAILED!")" "${COLOR_RESET}"
         print_separator_header "NSS"
         if [ "${nssSetupOk}" -eq 0 ] && [ -n "${nssImportError}" ] ; then
            printf '%s\n' "${nssImportError}"
         else
            "${CERTUTIL}" -V -e -u "V" -n "My Certificate" -d "${nssDb}" || true
         fi
         print_separator_footer
      else
         echo
      fi

      rm -rf -- "${nssDb}"
      nssDb=""
   else
      # TRANSLATORS: Informational notice when Mozilla NSS CertUtil/CrlUtil is not installed.
      gettext "(NSS CertUtil is not installed)"
      echo
   fi

done

# ====== Check for errors ===================================================
if [ "${errors}" -gt 0 ] ; then
   # TRANSLATORS: Final error banner printed when one or more certificate verifications fail.
   printf '%s***** %s *****%s\n' "${COLOR_BANNER_FAIL}" "$(gettext "CERTIFICATE VERIFICATIONS FAILED!")" "${COLOR_RESET}"
   exit 1
fi
