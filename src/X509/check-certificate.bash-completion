# ###### Bash completion for check-certificate ##############################
_check_certificate()
{
   # shellcheck disable=SC2034
   local cur prev words cword split comp_args
   if type -t _comp_initialize >/dev/null ; then
      _comp_initialize -s -- "$@" || return
   else
      _init_completion -s || return
   fi

   # ====== Check previous arguments for '--', options, and position ========
   local i endOfOptions=0 expectCrlArg=0 positionalCount=0 hasStdin=0
   for (( i = 1; i < cword; i++ )) ; do
      if (( endOfOptions )) ; then
         positionalCount=$((positionalCount + 1))
         [[ "${words[i]}" == "-" ]] && hasStdin=1
         continue
      fi
      if (( expectCrlArg )) ; then
         expectCrlArg=0
         continue
      fi
      case "${words[i]}" in
         --)
            endOfOptions=1
            ;;
         -h|--help|-v|--version)
            return 0
            ;;
         -C|--crl)
            expectCrlArg=1
            ;;
         --crl=*)
            ;;
         -)
            positionalCount=$((positionalCount + 1))
            hasStdin=1
            ;;
         -*)
            ;;
         *)
            positionalCount=$((positionalCount + 1))
            ;;
      esac
   done

   if (( endOfOptions )) ; then
      cur="${words[cword]}"
      if type -t _comp_compgen_filedir >/dev/null ; then
         _comp_compgen_filedir '@(cer|cert|crt|der|pem)'
      else
         _filedir '@(cer|cert|crt|der|pem)'
      fi
      return 0
   fi

   # ====== Special case: CRL file (-C / --crl) =============================
   if (( expectCrlArg )) || \
      [[ "${split-}" == true && "${prev}" == "--crl" ]] ; then
      if type -t _comp_compgen_filedir >/dev/null ; then
         _comp_compgen_filedir '@(crl|der|pem)'
      else
         _filedir '@(crl|der|pem)'
      fi
      return 0
   fi

   [[ "${split-}" == true ]] && return 0

   # ====== Complete CA / certificate files =================================
   if [[ "${cur}" != -* ]] ; then
      if type -t _comp_compgen_filedir >/dev/null ; then
         _comp_compgen_filedir '@(cer|cert|crt|der|pem)'
      else
         _filedir '@(cer|cert|crt|der|pem)'
      fi
      return 0
   fi

   # ====== All options =====================================================
   local opts="
-C
--crl
-n
--no-view-certificate
-c
--no-color
--no-colour
--
"
   if (( positionalCount >= 1 && ! hasStdin )) ; then
      opts="- ${opts}"
   fi
   if (( positionalCount == 0 && cword == 1 )) ; then
      opts+="
-h
--help
-v
--version
"
   fi

   mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   return 0
}

complete -F _check_certificate check-certificate
