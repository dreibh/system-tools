# ###### Bash completion for print-utf8 #####################################
_print_utf8()
{
   # shellcheck disable=SC2034
   local cur prev words cword comp_args
   if type -t _comp_initialize >/dev/null ; then
      _comp_initialize -n "=|" -- "$@" || return
   elif type -t _init_completion >/dev/null ; then
      _init_completion -n "=|" || return
   else
      COMPREPLY=()
      cur="${COMP_WORDS[COMP_CWORD]}"
      prev="${COMP_WORDS[COMP_CWORD-1]}"
      words=("${COMP_WORDS[@]}")
      cword="${COMP_CWORD}"
   fi

   local rawCur="${COMP_WORDS[COMP_CWORD]:-}"
   local isQuoted=0
   if [[ "${rawCur}" == \'* ]] || [[ "${rawCur}" == \"* ]] ; then
      isQuoted=1
   fi

   # ====== Parse prior tokens to track multi-argument option state =========
   local i activeOpt="" remainingArgs=0
   for (( i = 1; i < cword; i++ )) ; do
      if (( remainingArgs > 0 )) ; then
         remainingArgs=$((remainingArgs - 1))
         if (( remainingArgs == 0 )) ; then
            activeOpt=""
         fi
         continue
      fi

      case "${words[i]}" in
         --)
            return 0
            ;;
         -h | --help | -v | --version)
            return 0
            ;;
         -x | --columns)
            activeOpt="-x"
            remainingArgs=1
            ;;
         -i | --indent)
            activeOpt="-i"
            remainingArgs=1
            ;;
         -C | --multiline-center)
            activeOpt="-C"
            remainingArgs=2
            ;;
         -I | --multiline-indent)
            activeOpt="-I"
            remainingArgs=3
            ;;
         -s | --separator)
            activeOpt="-s"
            remainingArgs=3
            ;;
         --columns=* | --indent=*)
            ;;
         --multiline-center=*)
            activeOpt="-C"
            remainingArgs=1
            ;;
         --multiline-indent=*)
            activeOpt="-I"
            remainingArgs=2
            ;;
         --separator=*)
            activeOpt="-s"
            remainingArgs=2
            ;;
         -[ntwlbac]*[xiCIs])
            case "${words[i]: -1}" in
               x) activeOpt="-x" ; remainingArgs=1 ;;
               i) activeOpt="-i" ; remainingArgs=1 ;;
               C) activeOpt="-C" ; remainingArgs=2 ;;
               I) activeOpt="-I" ; remainingArgs=3 ;;
               s) activeOpt="-s" ; remainingArgs=3 ;;
            esac
            ;;
      esac
   done

   # ====== Complete inline --option=value forms ============================
   local replyPrefix=""
   if (( remainingArgs == 0 )) && [[ "${cur}" == --*=* ]] ; then
      local optPrefix="${cur%%=*}"
      cur="${cur#*=}"
      replyPrefix="${optPrefix}="
      case "${optPrefix}" in
         --columns)
            activeOpt="-x"
            remainingArgs=1
            ;;
         --indent)
            activeOpt="-i"
            remainingArgs=1
            ;;
         --multiline-indent)
            activeOpt="-I"
            remainingArgs=3
            ;;
         --multiline-center)
            activeOpt="-C"
            remainingArgs=2
            ;;
         --separator)
            activeOpt="-s"
            remainingArgs=3
            ;;
      esac
   fi

   # ====== Handle active option arguments ==================================
   if (( remainingArgs > 0 )) ; then
      local borderSuggestions=("#" "=" "|" "║" "▌" "▐" "│" "┃" "┆" "┇" "┊" "┋" "😀")
      local horizSuggestions=("#" "=" "-" "─" "═" "▀" "▄" "━")
      local matches=() item

      case "${activeOpt}:${remainingArgs}" in
         -x:1)
            compopt -o nosort 2>/dev/null || true
            if [[ "${cur}" == -* ]] ; then
               mapfile -t matches < <(compgen -W "-2 -4 -8 -12 -16 -20 -24 -32 -40" -- "${cur}")
            else
               local terminalColumns="" sortedColumnsList
               if command -v "${words[0]}" >/dev/null 2>&1 ; then
                  terminalColumns="$("${words[0]}" -t 2>/dev/null | awk '{ print $1 }')"
               elif command -v print-utf8 >/dev/null 2>&1 ; then
                  terminalColumns="$(print-utf8 -t 2>/dev/null | awk '{ print $1 }')"
               fi
               [[ "${terminalColumns}" =~ ^[0-9]+$ ]] || terminalColumns="${COLUMNS:-80}"
               sortedColumnsList="$(printf '%s\n' 0 "${terminalColumns}" 60 78 80 100 120 128 140 160 180 200 | sort -nu)"
               mapfile -t matches < <(compgen -W "${sortedColumnsList}" -- "${cur}")
            fi
            COMPREPLY=( "${matches[@]/#/${replyPrefix}}" )
            return 0
            ;;

         -i:1 | -I:3)
            compopt -o nosort 2>/dev/null || true
            mapfile -t matches < <(compgen -W "-64 -48 -32 -24 -20 -16 -12 -10 0 10 12 16 20 24 32 48 64" -- "${cur}")
            COMPREPLY=( "${matches[@]/#/${replyPrefix}}" )
            return 0
            ;;

         -s:2)
            for item in "${horizSuggestions[@]}" ; do
               if [[ "${item}" == "${cur}"* ]] ; then
                  matches+=( "${item}" )
               fi
            done
            ;;

         *)
            for item in "${borderSuggestions[@]}" ; do
               if [[ "${item}" == "${cur}"* ]] ; then
                  matches+=( "${item}" )
               fi
            done
            ;;
      esac

      compopt -o nosort 2>/dev/null || true
      COMPREPLY=()
      for item in "${matches[@]}" ; do
         if (( isQuoted )) ; then
            COMPREPLY+=( "${replyPrefix}${item}" )
         else
            COMPREPLY+=( "${replyPrefix}'${item}'" )
         fi
      done
      return 0
   fi

   # ====== All options =====================================================
   local opts="
-n
--newline
-i
--indent
-x
--columns
-c
--center
-I
--multiline-indent
-C
--multiline-center
-s
--separator
-b
--size
-l
--length
-w
--width
-a
--size-length-width
-t
--terminal-info
-h
--help
-v
--version
--
"
   mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   return 0
}

complete -F _print_utf8 print-utf8
