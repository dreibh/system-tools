.\" ###### Name #############################################################
.Sh NAME
.Nm print\-utf8
.Nd prints UTF\-8 strings and obtains size/length/width information
.\" ###### Synopsis #########################################################
.Sh SYNOPSIS
.Nm print\-utf8
.Op Fl n | Fl \-newline
.br
.Op Fl i Ar indentation | Fl \-indent Ar indentation
.br
.Op Ar string
.Nm print\-utf8
.Op Fl n | Fl \-newline
.br
.Op Fl x Ar console\_width | Fl \-columns Ar console\_width
.br
.Op Fl c | Fl \-center
.br
.Op Ar string
.Nm print\-utf8
.Op Fl n | Fl \-newline
.br
.Op Fl x Ar console\_width | Fl \-columns Ar console\_width
.br
.Op Fl I Ar indentation Ar left Ar right | Fl \-multiline\-indent Ar indentation Ar left Ar right
.Nm print\-utf8
.Op Fl n | Fl \-newline
.br
.Op Fl x Ar console\_width | Fl \-columns Ar console\_width
.br
.Op Fl C Ar left Ar right | Fl \-multiline\-center Ar left Ar right
.Nm print\-utf8
.Op Fl n | Fl \-newline
.br
.Op Fl x Ar console\_width | Fl \-columns Ar console\_width
.br
.Op Fl s Ar left Ar separator Ar right | Fl \-separator Ar left Ar separator Ar right
