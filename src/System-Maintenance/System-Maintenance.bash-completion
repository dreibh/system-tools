# ###### Bash completion for System-Maintenance #############################
_system_maintenance()
{
   # shellcheck disable=SC2034
   local cur prev words cword comp_args
   if type -t _comp_initialize >/dev/null ; then
      _comp_initialize -- "$@" || return
   else
      _init_completion || return
   fi

   # ====== Check previous arguments ========================================
   local i hasKernelOpt=0
   for (( i = 1; i < cword; i++ )) ; do
      case "${words[i]}" in
         --|-h|--help|-v|--version)
            return 0
            ;;
         -k|--interactive-kernel-removal)
            hasKernelOpt=1
            ;;
         -*)
            ;;
         *)
            # System-Maintenance accepts no positional arguments:
            return 0
            ;;
      esac
   done

   # ====== Complete options (no filename arguments accepted) ===============
   local opts=""
   if (( ! hasKernelOpt )) ; then
      opts+="
-k
--interactive-kernel-removal
"
   fi
   if (( ! hasKernelOpt )) || [[ "${cur}" == -* ]] ; then
      opts+="
-h
--help
-v
--version
"
   fi
   if [[ "${cur}" == -* ]] ; then
      opts+="
--
"
   fi

   mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   return 0
}

complete -F _system_maintenance System-Maintenance
