# ###### Bash completion for configure-grub #################################
_configure_grub()
{
   # shellcheck disable=SC2034
   local cur prev words cword comp_args
   if type -t _comp_initialize >/dev/null ; then
      _comp_initialize -- "$@" || return
   elif type -t _init_completion >/dev/null ; then
      _init_completion || return
   else
      COMPREPLY=()
      cur="${COMP_WORDS[COMP_CWORD]}"
      prev="${COMP_WORDS[COMP_CWORD-1]}"
      words=("${COMP_WORDS[@]}")
      cword="${COMP_CWORD}"
   fi

   # ====== Scan prior words for '--', terminal flags, and template arg =====
   local i afterDashDash=0 positionalCount=0
   for (( i = 1; i < cword; i++ )) ; do
      if (( afterDashDash )) ; then
         positionalCount=$((positionalCount + 1))
         continue
      fi
      case "${words[i]}" in
         --)
            afterDashDash=1
            ;;
         -h | --help | -v | --version)
            return 0
            ;;
         -i | --input | -o | --output | -V | --video | -T | --tune)
            # Skip option argument:
            i=$((i + 1))
            ;;
         --input=* | --output=* | --video=* | --tune=*)
            ;;
         -*)
            ;;
         *)
            positionalCount=$((positionalCount + 1))
            ;;
      esac
   done

   if (( afterDashDash )) ; then
      if (( positionalCount < 1 )) ; then
         if type -t _filedir >/dev/null ; then
            _filedir
         else
            mapfile -t COMPREPLY < <(compgen -f -- "${cur}")
         fi
      fi
      return 0
   fi

   # ====== Option-specific arguments =======================================
   case "${prev}" in
      -i | --input | -o | --output)
         if type -t _filedir >/dev/null ; then
            _filedir
         else
            mapfile -t COMPREPLY < <(compgen -f -- "${cur}")
         fi
         return 0
         ;;
      -V | --video | -T | --tune)
         return 0
         ;;
   esac

   # ====== Options vs. single required template file =======================
   local opts="
-i
--input
-o
--output
-V
--video
-T
--tune
-h
--help
-v
--version
"
   if [[ "${cur}" == -* ]] ; then
      mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   elif (( positionalCount < 1 )) ; then
      if type -t _filedir >/dev/null ; then
         _filedir
      else
         mapfile -t COMPREPLY < <(compgen -f -- "${cur}")
      fi
   else
      mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   fi
   return 0
}

complete -F _configure_grub configure-grub
