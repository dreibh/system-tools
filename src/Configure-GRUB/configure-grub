# Bash options:
set -euo pipefail

# gettext options:
export TEXTDOMAIN="configure-grub"
if [ -z "${TEXTDOMAINDIR:-}" ] && [[ "@CMAKE_INSTALL_FULL_DATADIR@" != @* ]] ; then
   export TEXTDOMAINDIR="@CMAKE_INSTALL_FULL_DATADIR@/locale"
fi
if command -v gettext.sh >/dev/null 2>&1 ; then
   # shellcheck disable=SC1091
   . gettext.sh
else
   gettext () { printf "%s" "$1"; }
   eval_gettext () { eval "printf '%s' \"$1\""; }
fi


# ###### Diff with colourised output, if possible ###########################
colordiff ()
{
   if diff --color /dev/null /dev/null >/dev/null 2>&1 ; then
      # GNU diff:
      diff --color=always "$@"
   else
      # Diff without --color option (e.g. BusyBox):
      diff "$@"
   fi
}


# ###### Version ############################################################
version () {
   echo "configure-grub @PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@"
   exit 0
}


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   local opt=$'\x1b[1m'
   local arg=$'\x1b[4m'
   local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   local progname="${program##*/}"
   local manpage="${cmd}${progname%.*}${reset}"
   local lrm=""
   local rlm=""
   # TRANSLATORS: Text direction: LTR (Left-to-Right) or RTL (Right-to-Left)
   if [ "$(gettext "LTR")" = "RTL" ] ; then
      lrm=$'\xe2\x80\x8e'
      rlm=$'\xe2\x80\x8f'
   fi
   local homepage="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_HOMEPAGE_URL@\a@PROJECT_HOMEPAGE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   local repository="${lrm}"$'[\x1b[1m\x1b]8;;@PROJECT_SOURCE_URL@\a@PROJECT_SOURCE_URL@\a\x1b]8;;\a\x1b[0m]'"${rlm}"
   local usageHeader
   # TRANSLATORS: Command-line syntax message prefix:
   # "Usage: <program> [options]".
   usageHeader="$(gettext "Usage:")"
   cat >&2 <<EOF
${header}${usageHeader}${reset}
${cmd}${program}${reset} ${arg}grub-defaults-template-file${reset}
	${syn}[${reset}${opt}-i${reset} ${arg}input-grub-defaults-file${reset} ${syn}|${reset} ${opt}--input${reset} ${arg}input-grub-defaults-file${reset}${syn}]${reset}
	${syn}[${reset}${opt}-o${reset} ${arg}output-grub-defaults-file${reset} ${syn}|${reset} ${opt}--output${reset} ${arg}output-grub-defaults-file${reset}${syn}]${reset}
	${syn}[${reset}${opt}-V${reset} ${arg}GRUB_GFXMODE${reset} ${syn}|${reset} ${opt}--video${reset} ${arg}GRUB_GFXMODE${reset}${syn}]${reset}
	${syn}[${reset}${opt}-T${reset} ${arg}GRUB_INIT_TUNE${reset} ${syn}|${reset} ${opt}--tune${reset} ${arg}GRUB_INIT_TUNE${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-h${reset} ${syn}|${reset} ${opt}--help${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-v${reset} ${syn}|${reset} ${opt}--version${reset}${syn}]${reset}

EOF
   # shellcheck disable=SC2059
   # TRANSLATORS: Informational message at the end of usage:
   # 1st %s = manpage name, 2nd %s = documentation URL, 3rd %s = repository URL
   printf >&2 "$(gettext "For further information, see the man page for %s, read the documentation at %s, examine the source code at %s, or consult your favourite LLM.")\n" \
      "${manpage}" "${homepage}" "${repository}"
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------


# ###### Clean up temporary file on exit or signal ##########################
tempOutput=""
cleanup () {
   rm -f -- "${tempOutput}"
}
trap cleanup EXIT INT TERM HUP



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
if (( BASH_VERSINFO[0] < 4 )) || (( (BASH_VERSINFO[0] == 4) && (BASH_VERSINFO[1] < 4) )) ; then
   # TRANSLATORS: Error message when installed Bash version is older than 4.4.
   gettext >&2 "ERROR: Bash 4.4 or higher is required!"
   echo >&2
   exit 1
fi
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:/usr/local/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if [[ -z "${GETOPT}" ]] || "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]] ; then
   # TRANSLATORS: Error message when enhanced/GNU getopt is not available.
   gettext >&2 "ERROR: Enhanced/GNU getopt is required!"
   echo >&2
   exit 1
fi
if ! options="$("${GETOPT}" -o i:o:V:T:hv --long input:,output:,video:,tune:,help,version -a -- "$@")" ; then
   usage "$0" 1
fi
eval set -- "${options}"

INPUT_CONFIGURATION=""
OUTPUT_CONFIGURATION=""
REPLACE_GRUB_GFXMODE=""
REPLACE_GRUB_INIT_TUNE=""
while [ $# -gt 0 ] ; do
   case "$1" in
      -i | --input)
         INPUT_CONFIGURATION="$2"
         shift
         ;;
      -o | --output)
         OUTPUT_CONFIGURATION="$2"
         shift
         ;;
      -V | --video)
         REPLACE_GRUB_GFXMODE="$2"
         shift
         ;;
      -T | --tune)
         REPLACE_GRUB_INIT_TUNE="$2"
         shift
         ;;
      -h | --help)
         usage "$0" 0
         ;;
      -v | --version)
         version
         ;;
      --)
         shift
         break
         ;;
      *)
         # This should not happen: wrong getopt parameters, or missing case?
         echo >&2 "INTERNAL ERROR: Unhandled option $1!"
         exit 1
         ;;
   esac
   shift
done
if [ $# -ne 1 ] ; then
   usage "$0" 1
fi

# shellcheck disable=SC2034
TEMPLATE_CONFIGURATION="$1"
if [ -z "${INPUT_CONFIGURATION}" ] ; then
   if [ -e "/etc/default/grub" ] ; then
      # Use existing configuration as input:
      INPUT_CONFIGURATION="/etc/default/grub"
   else
      # Use empty file (/dev/null) as input:
      INPUT_CONFIGURATION="/dev/null"
   fi
fi
if [ ! -e "${INPUT_CONFIGURATION}" ] ; then
   # TRANSLATORS: Error message when input GRUB configuration file cannot be found:
   # ${INPUT_CONFIGURATION} = input file path
   eval_gettext >&2 "ERROR: Input configuration \${INPUT_CONFIGURATION} not found!"
   echo >&2
   exit 1
fi
if [ ! -e "${TEMPLATE_CONFIGURATION}" ] ; then
   # TRANSLATORS: Error message when GRUB template file cannot be found:
   # ${TEMPLATE_CONFIGURATION} = template file path
   eval_gettext >&2 "ERROR: Template configuration \${TEMPLATE_CONFIGURATION} not found!"
   echo >&2
   exit 1
fi
if [ -z "${OUTPUT_CONFIGURATION}" ] ; then
   OUTPUT_CONFIGURATION="grub-defaults.new"
fi

outputDir="."
if [[ "${OUTPUT_CONFIGURATION}" == */* ]] ; then
   outputDir="${OUTPUT_CONFIGURATION%/*}"
   [[ -z "${outputDir}" ]] && outputDir="/"
fi
if [ ! -d "${outputDir}" ] ; then
   # shellcheck disable=SC2034
   OUTPUT_DIRECTORY="${outputDir}"
   # TRANSLATORS: Error message when output directory cannot be found:
   # ${OUTPUT_DIRECTORY} = output directory path
   eval_gettext >&2 "ERROR: Output directory \${OUTPUT_DIRECTORY} not found!"
   echo >&2
   exit 1
fi


# ====== Get options ========================================================
OPTION_DISABLE_BIOSDEVNAME=0
if [ -r /proc/cmdline ] && grep -q "biosdevname=0" /proc/cmdline ; then
   OPTION_DISABLE_BIOSDEVNAME=1
fi
OPTION_DISABLE_NETIFNAMES=0
if [ -r /proc/cmdline ] && grep -q 'net\.ifnames=0' /proc/cmdline ; then
   OPTION_DISABLE_NETIFNAMES=1
fi

OPTION_CMDLINE="$( { grep "^GRUB_CMDLINE_LINUX=" "${INPUT_CONFIGURATION}" || true ; } | tail -n 1 | sed -e 's/biosdevname=0[ ]*//g' -e 's/net\.ifnames=0[ ]*//g' )"
if [ -z "${OPTION_CMDLINE}" ] ; then
   OPTION_CMDLINE='GRUB_CMDLINE_LINUX=""'
fi
OPTION_CMDLINE_DEFAULT="$( { grep "^GRUB_CMDLINE_LINUX_DEFAULT=" "${INPUT_CONFIGURATION}" || true ; } | tail -n 1 | sed -e 's/biosdevname=0[ ]*//g' -e 's/net\.ifnames=0[ ]*//g' )"
if [ -z "${OPTION_CMDLINE_DEFAULT}" ] ; then
   OPTION_CMDLINE_DEFAULT='GRUB_CMDLINE_LINUX_DEFAULT=""'
fi

if [ "${OPTION_DISABLE_BIOSDEVNAME}" -eq 1 ] ; then
   OPTION_CMDLINE="${OPTION_CMDLINE/#GRUB_CMDLINE_LINUX=\"/GRUB_CMDLINE_LINUX=\"biosdevname=0 }"
   OPTION_CMDLINE_DEFAULT="${OPTION_CMDLINE_DEFAULT/#GRUB_CMDLINE_LINUX_DEFAULT=\"/GRUB_CMDLINE_LINUX_DEFAULT=\"biosdevname=0 }"
fi
if [ "${OPTION_DISABLE_NETIFNAMES}" -eq 1 ] ; then
   OPTION_CMDLINE="${OPTION_CMDLINE/#GRUB_CMDLINE_LINUX=\"/GRUB_CMDLINE_LINUX=\"net.ifnames=0 }"
   OPTION_CMDLINE_DEFAULT="${OPTION_CMDLINE_DEFAULT/#GRUB_CMDLINE_LINUX_DEFAULT=\"/GRUB_CMDLINE_LINUX_DEFAULT=\"net.ifnames=0 }"
fi

OPTION_ENABLE_CRYPTODISK="$( { grep "^GRUB_ENABLE_CRYPTODISK=" "${INPUT_CONFIGURATION}" || true ; } | tail -n 1 )"

if [ -z "${REPLACE_GRUB_GFXMODE}" ] ; then
   OPTION_GFXMODE="$( { grep -E "^[[:space:]]*GRUB_GFXMODE=" "${INPUT_CONFIGURATION}" || true ; } | tail -n 1 | sed -e 's/^[[:space:]]*//' )"
   if [ -z "${OPTION_GFXMODE}" ] ; then
      OPTION_GFXMODE="$( { grep -E "^[#[:space:]]*GRUB_GFXMODE=" "${INPUT_CONFIGURATION}" || true ; } | tail -n 1 | sed -e 's/^[[:space:]]*#[[:space:]]*GRUB/# GRUB/' )"
   fi
   if [ -z "${OPTION_GFXMODE}" ] ; then
      OPTION_GFXMODE='# GRUB_GFXMODE=""'
   fi
else
   OPTION_GFXMODE="GRUB_GFXMODE=\"${REPLACE_GRUB_GFXMODE}\""
fi

if [ -z "${REPLACE_GRUB_INIT_TUNE}" ] ; then
   OPTION_INIT_TUNE="$( { grep -E "^[[:space:]]*GRUB_INIT_TUNE=" "${INPUT_CONFIGURATION}" || true ; } | tail -n 1 | sed -e 's/^[[:space:]]*//' )"
   if [ -z "${OPTION_INIT_TUNE}" ] ; then
      OPTION_INIT_TUNE="$( { grep -E "^[#[:space:]]*GRUB_INIT_TUNE=" "${INPUT_CONFIGURATION}" || true ; } | tail -n 1 | sed -e 's/^[[:space:]]*#[[:space:]]*GRUB/# GRUB/' )"
   fi
   if [ -z "${OPTION_INIT_TUNE}" ] ; then
      OPTION_INIT_TUNE='# GRUB_INIT_TUNE=""'
   fi
else
   OPTION_INIT_TUNE="GRUB_INIT_TUNE=\"${REPLACE_GRUB_INIT_TUNE}\""
fi


# ====== Print configuration ================================================
# TRANSLATORS: Header for the summary of resolved GRUB configuration settings.
echo "$(gettext "Configuration:")"
echo "* Input file:                 ${INPUT_CONFIGURATION}"
echo "* Template file:              ${TEMPLATE_CONFIGURATION}"
echo "* Output file:                ${OUTPUT_CONFIGURATION}"
echo "* OPTION_DISABLE_BIOSDEVNAME: ${OPTION_DISABLE_BIOSDEVNAME}"
echo "* OPTION_DISABLE_NETIFNAMES:  ${OPTION_DISABLE_NETIFNAMES}"
echo "* OPTION_CMDLINE:             ${OPTION_CMDLINE}"
echo "* OPTION_CMDLINE_DEFAULT:     ${OPTION_CMDLINE_DEFAULT}"
echo "* OPTION_ENABLE_CRYPTODISK:   ${OPTION_ENABLE_CRYPTODISK}"
echo "* OPTION_INIT_TUNE:           ${OPTION_INIT_TUNE}"
echo "* OPTION_GFXMODE:             ${OPTION_GFXMODE}"


# ====== Set configuration ==================================================
currentUmask="$(umask)"
targetMode="$(printf '%04o' $(( 0666 & ~(8#${currentUmask}) )))"
if [ -f "${OUTPUT_CONFIGURATION}" ] ; then
   if existingMode="$(stat -c '%a' "${OUTPUT_CONFIGURATION}" 2>/dev/null)" || \
      existingMode="$(stat -f '%Lp' "${OUTPUT_CONFIGURATION}" 2>/dev/null)" ; then
      targetMode="${existingMode}"
   fi
fi

tempOutput="$(umask 077 && mktemp "${outputDir%/}/.configure-grub.XXXXXXXXXX")"
chmod "${targetMode}" "${tempOutput}"

OPTION_CMDLINE="${OPTION_CMDLINE}"                     \
OPTION_CMDLINE_DEFAULT="${OPTION_CMDLINE_DEFAULT}"     \
OPTION_GFXMODE="${OPTION_GFXMODE}"                     \
OPTION_INIT_TUNE="${OPTION_INIT_TUNE}"                 \
OPTION_ENABLE_CRYPTODISK="${OPTION_ENABLE_CRYPTODISK}" \
awk '
   BEGIN {
      OPTION_CMDLINE           = ENVIRON["OPTION_CMDLINE"];
      OPTION_CMDLINE_DEFAULT   = ENVIRON["OPTION_CMDLINE_DEFAULT"];
      OPTION_GFXMODE           = ENVIRON["OPTION_GFXMODE"];
      OPTION_INIT_TUNE         = ENVIRON["OPTION_INIT_TUNE"];
      OPTION_ENABLE_CRYPTODISK = ENVIRON["OPTION_ENABLE_CRYPTODISK"];

      wroteCmdlineOption=0;
      wroteCmdlineDefaultOption=0;
      wroteGfxModeOption=0;
      wroteInitTuneOption=0;
      wroteCryptodiskOption=0;
   }

   /^GRUB_CMDLINE_LINUX=/ {
      print OPTION_CMDLINE;
      wroteCmdlineOption=1;
      next;
   }

   /^GRUB_CMDLINE_LINUX_DEFAULT=/ {
      print OPTION_CMDLINE_DEFAULT;
      wroteCmdlineDefaultOption=1;
      next;
   }

   /^[#[:space:]]*GRUB_GFXMODE=/ {
      print OPTION_GFXMODE;
      wroteGfxModeOption=1;
      next;
   }

   /^[#[:space:]]*GRUB_INIT_TUNE=/ {
      print OPTION_INIT_TUNE;
      wroteInitTuneOption=1;
      next;
   }

   /^GRUB_ENABLE_CRYPTODISK=/ {
      if(OPTION_ENABLE_CRYPTODISK != "") {
         print OPTION_ENABLE_CRYPTODISK;
      }
      wroteCryptodiskOption=1;
      next;
   }

   {
      print $0;
   }

   END {
      if((!wroteCmdlineOption) && (OPTION_CMDLINE != "")) {
         print OPTION_CMDLINE;
      }
      if((!wroteCmdlineDefaultOption) && (OPTION_CMDLINE_DEFAULT != "")) {
         print OPTION_CMDLINE_DEFAULT;
      }
      if((!wroteGfxModeOption) && (OPTION_GFXMODE != "")) {
         print OPTION_GFXMODE;
      }
      if((!wroteInitTuneOption) && (OPTION_INIT_TUNE != "")) {
         print OPTION_INIT_TUNE;
      }
      if((!wroteCryptodiskOption) && (OPTION_ENABLE_CRYPTODISK != "")) {
         print OPTION_ENABLE_CRYPTODISK;
      }
   }
' <"${TEMPLATE_CONFIGURATION}" >"${tempOutput}"

# TRANSLATORS: Header printed before showing the diff between old and new GRUB files:
# ${INPUT_CONFIGURATION} = input file path, ${OUTPUT_CONFIGURATION} = output file path
eval_gettext "Differences between \${INPUT_CONFIGURATION} and \${OUTPUT_CONFIGURATION}:"
echo
colordiff "${INPUT_CONFIGURATION}" "${tempOutput}" || true
mv -f -- "${tempOutput}" "${OUTPUT_CONFIGURATION}"
tempOutput=""
