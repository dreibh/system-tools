# Bash options:
set -euo pipefail

# gettext options:
export TEXTDOMAIN="Fingerprint-SSH-Keys"
[[ "@CMAKE_INSTALL_FULL_DATADIR@" != @* ]] && export TEXTDOMAINDIR="@CMAKE_INSTALL_FULL_DATADIR@/locale"

# shellcheck disable=SC1091
. gettext.sh


# ###### Version ############################################################
version () {
   echo "Fingerprint-SSH-Keys @BUILD_MAJOR@.@BUILD_MINOR@.@BUILD_PATCH@"
   exit 0
}


# ------ BEGIN-OF-USAGE-BLOCK ------
# ###### Usage ##############################################################
usage () {
   local program="$1"
   local exitCode="$2"
   local header=$'\x1b[4m'
   local cmd=$'\x1b[1m'
   local opt=$'\x1b[1m'
   local arg=$'\x1b[4m'
   local syn=$'\x1b[1m'
   local reset=$'\x1b[0m'
   # TRANSLATORS: Command-line syntax message prefix:
   # "Usage: <program> [options]".
   cat >&2 <<EOF
${header}$(gettext "Usage:")${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-A${reset} ${opt}|${reset} ${opt}--all${reset}${syn}]${reset}
	${syn}[${reset}${opt}-a${reset} ${opt}|${reset} ${opt}--none${reset}${syn}]${reset}
	${syn}[${reset}${opt}-R${reset} ${opt}|${reset} ${opt}--with-raw${reset}${syn}]${reset}
	${syn}[${reset}${opt}-r${reset} ${opt}|${reset} ${opt}--without-raw${reset}${syn}]${reset}
	${syn}[${reset}${opt}-D${reset} ${opt}|${reset} ${opt}--with-dns${reset}${syn}]${reset}
	${syn}[${reset}${opt}-d${reset} ${opt}|${reset} ${opt}--without-dns${reset}${syn}]${reset}
	${syn}[${reset}${opt}-S${reset} ${opt}|${reset} ${opt}--with-ssh${reset}${syn}]${reset}
	${syn}[${reset}${opt}-s${reset} ${opt}|${reset} ${opt}--without-ssh${reset}${syn}]${reset}
	${syn}[${reset}${opt}-F${reset} ${arg}text|python|csv${reset} ${opt}|${reset} ${opt}--format${reset} ${arg}text|python|csv${reset}${syn}]${reset}
	${syn}[${reset}${opt}-K${reset} ${arg}directory${reset} ${opt}|${reset} ${opt}--key-directory${reset} ${arg}directory${reset}${syn}]${reset}
	${syn}[${reset}${opt}--include-deprecated${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-h${reset} ${opt}|${reset} ${opt}--help${reset}${syn}]${reset}
${cmd}${program}${reset}
	${syn}[${reset}${opt}-v${reset} ${opt}|${reset} ${opt}--version${reset}${syn}]${reset}
EOF
   exit "${exitCode}"
}
# ------ END-OF-USAGE-BLOCK ------



# ###### Main program #######################################################

# ====== Handle arguments ===================================================
if (( BASH_VERSINFO[0] < 4 )) || (( (BASH_VERSINFO[0] == 4) && (BASH_VERSINFO[1] < 4) )) ; then
   # TRANSLATORS: Error message when installed Bash version is older than 4.4.
   gettext >&2 "ERROR: Bash 4.4 or higher is required!"
   echo >&2
   exit 1
fi
UNAME="$(uname)"
case "${UNAME}" in
   FreeBSD)
      GETOPT="$(PATH="/usr/local/bin:${PATH}" command -v getopt || true)"
      ;;
   NetBSD)
      GETOPT="$(PATH="/usr/pkg/bin:${PATH}" command -v getopt || true)"
      ;;
   OpenBSD)
      GETOPT="$(command -v gnugetopt || true)"
      ;;
   SunOS)
      GETOPT="$(PATH="/usr/gnu/bin:${PATH}" command -v getopt || true)"
      ;;
   Darwin)
      GETOPT="$(env PATH="/opt/homebrew/opt/gnu-getopt/bin:${PATH}" command -v getopt || true)"
      ;;
   *)
      GETOPT="$(command -v getopt || true)"
      ;;
esac
if "${GETOPT}" -T >/dev/null 2>&1 || [[ $? -ne 4 ]]; then
   # TRANSLATORS: Error message when enhanced/GNU getopt is not found or is
   # incompatible.
   gettext >&2 "ERROR: Enhanced/GNU getopt is required!"
   echo >&2
   exit 1
fi

options="$(${GETOPT} -o AaRrDdsSF:K:hv --long all,none,with-raw,without-raw,with-dns,without-dns,with-ssh,without-ssh,format:,raw-format:,key-directory:,include-deprecated,include-raw,include-raw-python,help,version -a -- "$@")"
# shellcheck disable=SC2181
if [[ $? -ne 0 ]]; then
   usage "$0" 1
fi
eval set -- "${options}"

FORMATS="raw ssh dns"
WITH_RAW=0
WITH_DNS=1
WITH_SSH=1
FORMAT="text"
KEY_DIRECTORY=""
INCLUDE_DEPRECATED=0

while [ $# -gt 0 ] ; do
   case "$1" in
      -A | --all)
         WITH_RAW=1
         WITH_DNS=1
         WITH_SSH=1
         ;;
      -a | --none)
         WITH_RAW=0
         WITH_DNS=0
         WITH_SSH=0
         ;;
      -R | --with-raw)
         WITH_RAW=1
         ;;
      -r | --without-raw)
         WITH_RAW=0
         ;;
      -D | --with-dns)
         WITH_DNS=1
         ;;
      -d | --without-dns)
         WITH_DNS=0
         ;;
      -S | --with-ssh)
         WITH_SSH=1
         ;;
      -s | --without-ssh)
         WITH_SSH=0
         ;;
      -F | --format | --raw-format)
         FORMAT="${2,,}"
         case "${FORMAT}" in
            text | python | csv)
               ;;
            *)
               # TRANSLATORS: Error message when an invalid output format is specified:
               # ${FORMAT} = specified format name
               eval_gettext >&2 "ERROR: Invalid format '\${FORMAT}'! Allowed formats: text, python, csv."
               echo >&2
               usage "$0" 1
               ;;
         esac
         shift
         ;;
      -K | --key-directory)
         KEY_DIRECTORY="$2"
         if [ ! -d "${KEY_DIRECTORY}" ] ; then
            # TRANSLATORS: Error message when the specified key directory does not exist:
            # ${KEY_DIRECTORY} = directory path
            eval_gettext >&2 "ERROR: Key directory '\${KEY_DIRECTORY}' does not exist!"
            echo >&2
            exit 1
         fi
         shift
         ;;
      --include-deprecated)
         INCLUDE_DEPRECATED=1
         ;;
      --include-raw)
         WITH_RAW=1
         FORMAT="text"
         ;;
      --include-raw-python)
         WITH_RAW=1
         FORMAT="python"
         ;;
      -h | --help)
         usage "$0" 0
         ;;
      -v | --version)
         version
         ;;
      --)
         shift
         break
         ;;
      *)
         # This should not happen: wrong getopt parameters, or missing case?
         echo >&2 "INTERNAL ERROR: Unhandled option $1!"
         exit 1
         ;;
   esac
   shift
done
if [ $# -ne 0 ] ; then
   usage "$0" 1
fi


# ====== Print SSH key fingerprints =========================================
sshDirectory="${KEY_DIRECTORY}"
if [ -z "${sshDirectory}" ] ; then
   if [[ "${UNAME}" =~ ^(CYGWIN.*|MINGW.*|MSYS.*|Windows_NT)$ ]] ; then
      if [ -d "${PROGRAMDATA:-/c/ProgramData}/ssh" ] ; then
         sshDirectory="${PROGRAMDATA:-/c/ProgramData}/ssh"
      fi
   else
      if [ -d "/etc/ssh" ] ; then
         sshDirectory="/etc/ssh"
      fi
   fi
fi

if [ -n "${sshDirectory}" ] && command -v ssh-keygen >/dev/null ; then
   hostname="$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo "localhost")"

   firstSection=1
   printSeparator () {
      if [ "${firstSection}" -eq 0 ] ; then
         echo
      fi
      firstSection=0
   }

   for target in ${FORMATS} ; do

      # ====== Print fingerprints in raw format =============================
      if [ "${target}" == "raw" ] ; then
         if [ ${WITH_RAW} -ne 0 ] ; then
            printSeparator
            if [ "${FORMAT}" != "csv" ] ; then
               # TRANSLATORS: Header for raw public keys section:
               # ${hostname} = system hostname or FQDN
               echo -e "\x1b[34m$(date +%FT%H:%M:%S): $(eval_gettext "Fingerprints of \${hostname} in raw format:")\x1b[0m"
            fi
            keyNumber=1
            if [ "${FORMAT}" == "python" ] ; then
               echo "'public-keys': {"
            fi
            while IFS= read -r keyFile ; do
               keyType="$(cut -d' ' -f1 <"${keyFile}")"
               keyData="$(cut -d' ' -f2 <"${keyFile}")"
               case "${FORMAT}" in
                  text)
                     echo "#${keyNumber}: ${keyType} ${keyData}"
                     ;;
                  csv)
                     echo "${keyType},${keyData}"
                     ;;
                  python)
                     if [ ${keyNumber} -gt 1 ] ; then
                        echo ","
                     fi
                     echo -n "   '${keyType}': '${keyData}'"
                     ;;
               esac
               keyNumber=$((keyNumber+1))
            done < <(find "${sshDirectory}" -maxdepth 1 -name "ssh_host_*.pub" -print | sort)
            if [ "${FORMAT}" == "python" ] ; then
               echo -e "\n}"
            fi
         fi

      # ====== Print fingerprints in SSH format =============================
      elif [ "${target}" == "ssh" ] ; then
         if [ ${WITH_SSH} -ne 0 ] ; then
            printSeparator
            if [ "${FORMAT}" != "csv" ] ; then
               # TRANSLATORS: Header for SSH fingerprint records section:
               # ${hostname} = system hostname or FQDN
               echo -e "\x1b[34m$(date +%FT%H:%M:%S): $(eval_gettext "Fingerprints of \${hostname} in SSH format:")\x1b[0m"
            fi
            keyNumber=1
            if [ "${FORMAT}" == "python" ] ; then
               echo "'ssh-fingerprints': {"
            fi
            while IFS= read -r keyFile ; do
               read -r bits fingerprint keyType < <(ssh-keygen -lf "${keyFile}" | sed -e 's/^\([0-9]*\) \([^ ]*\) \(.*\) (\(.*\))$/\1 \2 \4/')
               case "${FORMAT}" in
                  text)
                     echo "#${keyNumber}: ${fingerprint} (${keyType} ${bits})"
                     ;;
                  csv)
                     echo "${keyType},${bits},${fingerprint}"
                     ;;
                  python)
                     if [ ${keyNumber} -gt 1 ] ; then
                        echo ","
                     fi
                     echo -n "   '${keyType}': { 'bits': ${bits}, 'fingerprint': '${fingerprint}' }"
                     ;;
               esac
               keyNumber=$((keyNumber+1))
            done < <(find "${sshDirectory}" -maxdepth 1 -name "ssh_host_*.pub" -print | sort)
            if [ "${FORMAT}" == "python" ] ; then
               echo -e "\n}"
            fi
         fi

      # ====== Print fingerprints in DNS format =============================
      elif [ "${target}" == "dns" ] ; then
         if [ ${WITH_DNS} -ne 0 ] ; then
            printSeparator
            if [ "${FORMAT}" != "csv" ] ; then
               # TRANSLATORS: Header for DNS SSHFP resource records section:
               # ${hostname} = system hostname or FQDN
               echo -e "\x1b[34m$(date +%FT%H:%M:%S): $(eval_gettext "Fingerprints of \${hostname} in DNS RR format:")\x1b[0m"
            fi
            keyNumber=1
            if [ "${FORMAT}" == "python" ] ; then
               echo "'dns-records': ["
            fi
            while read -r rHost rIn rType rAlgo rHash rFp ; do
               case "${FORMAT}" in
                  text)
                     echo -e "${rHost}\t${rIn}\t${rType}\t${rAlgo}\t${rHash}\t${rFp}"
                     ;;
                  csv)
                     echo "${rHost},${rIn},${rType},${rAlgo},${rHash},${rFp}"
                     ;;
                  python)
                     if [ ${keyNumber} -gt 1 ] ; then
                        echo ","
                     fi
                     echo -n "   { 'hostname': '${rHost}', 'rr': '${rType}', 'algorithm': ${rAlgo}, 'hash_type': ${rHash}, 'fingerprint': '${rFp}' }"
                     keyNumber=$((keyNumber+1))
                     ;;
               esac
            done < <(
               while IFS= read -r keyFile ; do
                  if [ ${INCLUDE_DEPRECATED} -eq 1 ] ; then
                     ssh-keygen -r "${hostname}" -f "${keyFile}" 2>/dev/null | cut -d' ' -f2,3,4,5,6 | grep '^IN SSHFP [1-9] [1-9]' || true
                  else
                     # Filter out deprecated DSA key type or SSH-1 hash:
                     ssh-keygen -r "${hostname}" -f "${keyFile}" 2>/dev/null | cut -d' ' -f2,3,4,5,6 | grep '^IN SSHFP [13-9] [2-9]' || true
                  fi | while read -r in rrType algorithmID hashID fingerprint ; do
                     echo -e "${hostname}\t${in}\t${rrType}\t${algorithmID}\t${hashID}\t${fingerprint}"
                  done
               done < <(find "${sshDirectory}" -maxdepth 1 -name "ssh_host_*.pub" -print) | sort -k 5n,5n -k 4n,4n -k 6,6
            )
            if [ "${FORMAT}" == "python" ] ; then
               echo -e "\n]"
            fi
         fi
      fi

   done
fi
