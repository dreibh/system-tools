# ###### Bash completion for Fingerprint-SSH-Keys ###########################
_Fingerprint_SSH_Keys()
{
   # shellcheck disable=SC2034
   local cur prev words cword comp_args
   if type -t _comp_initialize >/dev/null ; then
      _comp_initialize -- "$@" || return
   elif type -t _init_completion >/dev/null ; then
      _init_completion || return
   else
      COMPREPLY=()
      cur="${COMP_WORDS[COMP_CWORD]}"
      prev="${COMP_WORDS[COMP_CWORD-1]}"
      words=("${COMP_WORDS[@]}")
      cword="${COMP_CWORD}"
   fi

   # ====== Stop completion after terminal options or '--' ==================
   local i
   for (( i = 1; i < cword; i++ )) ; do
      case "${words[i]}" in
         -- | -h | --help | -v | --version)
            return 0
            ;;
      esac
   done

   case "${prev}" in
      # ====== Output format types ==========================================
      -F | --format | --raw-format)
         mapfile -t COMPREPLY < <(compgen -W "text python csv" -- "${cur,,}")
         return 0
         ;;
      # ====== Key directory ================================================
      -K | --key-directory)
         if type -t _filedir >/dev/null ; then
            _filedir -d
         else
            mapfile -t COMPREPLY < <(compgen -d -- "${cur}")
         fi
         return 0
         ;;
   esac

   # ====== All options (no positional filename arguments accepted) =========
   local opts="
-A
--all
-a
--none
-R
--with-raw
-r
--without-raw
-D
--with-dns
-d
--without-dns
-S
--with-ssh
-s
--without-ssh
-F
--format
-K
--key-directory
--include-deprecated
-h
--help
-v
--version
"
   mapfile -t COMPREPLY < <(compgen -W "${opts}" -- "${cur}")
   return 0
}

complete -F _Fingerprint_SSH_Keys Fingerprint-SSH-Keys
