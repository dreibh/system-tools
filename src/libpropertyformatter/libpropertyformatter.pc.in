prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libpropertyformatter
Description: Cross-platform C++ terminal property formatter library
Version: @PROJECT_VERSION@

Requires: libdisplaywidth
Libs: -L${libdir} -lpropertyformatter
Cflags: -I${includedir}
